<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- Host. Use cases live in Features/<Module>/<UseCase>/; admin UI in Areas/Admin; public booking in Areas/Booking. -->

  <PropertyGroup>
    <UserSecretsId>salon-platform-dev</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Salon.Web.Framework\Salon.Web.Framework.csproj" />
    <ProjectReference Include="..\..\Plugins\Salon.Plugin.Import\Salon.Plugin.Import.csproj" />
    <ProjectReference Include="..\..\Plugins\Salon.Plugin.Payments.Manual\Salon.Plugin.Payments.Manual.csproj" />
    <ProjectReference Include="..\..\Plugins\Salon.Plugin.Sms.Log\Salon.Plugin.Sms.Log.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Needed by `dotnet ef` when this host is the startup project. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!--
      UI text (CLAUDE.md rule 6): one file per module and culture, Localization/<culture>/<Module>.json, read by
      EmbeddedJsonResourceSource as Salon.Web.Localization.<culture>.<Module>.json (ADR 0006, amendment 2026-11-12).
      RecursiveDir ends with the platform's separator, so both separators become the dot. Adding keys: edit the two
      files of your module only; a new module needs both cultures (the architecture tests check file parity).
    -->
    <EmbeddedResource Include="Localization\**\*.json" LogicalName="$(RootNamespace).Localization.$([System.String]::Copy('%(RecursiveDir)').Replace('\', '.').Replace('/', '.'))%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Salon.Tests.Integration" />
    <InternalsVisibleTo Include="Salon.Tests.E2E" />
  </ItemGroup>

</Project>
