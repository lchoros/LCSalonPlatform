@using Salon.Web.Features.Clients.SearchClients
@model SearchClientsViewModel
@{
    ViewData["Title"] = T["Clients.Search.Title"];
    const string inputClass = "block w-full min-h-11 rounded-md border border-stone-300 px-3 py-2 text-base shadow-sm focus:border-stone-900 focus:outline-none focus:ring-1 focus:ring-stone-900";
}
<section class="space-y-6">
    @if (Model.Flash is { } flash)
    {
        <p role="status" data-testid="flash" class="rounded-md border border-green-200 bg-green-50 p-3 text-sm text-green-800">@flash</p>
    }
    <header class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
        <h1 class="text-2xl font-bold tracking-tight sm:text-3xl">@T["Clients.Search.Title"]</h1>
        <a href="/admin/clients/new" data-testid="add-client" class="inline-flex min-h-11 items-center justify-center rounded-md bg-stone-900 px-4 py-2 text-base font-medium text-white hover:bg-stone-700">@T["Clients.Search.Add"]</a>
    </header>

    <form method="get" asp-action="Index" role="search" class="flex flex-col gap-3 sm:flex-row sm:items-end" data-testid="client-search-form">
        <div class="flex-1 space-y-1">
            <label for="q" class="block text-sm font-medium">@T["Clients.Search.Query"]</label>
            <input id="q" name="q" type="search" value="@Model.Query" maxlength="100" autocomplete="off" enterkeyhint="search" class="@inputClass" />
        </div>
        <button type="submit" class="inline-flex min-h-11 items-center justify-center rounded-md border border-stone-300 px-4 py-2 text-base font-medium hover:bg-stone-100">@T["Clients.Search.Submit"]</button>
    </form>

    @if (Model.Clients.Count == 0)
    {
        <p data-testid="empty-state" class="rounded-md border border-dashed border-stone-300 p-6 text-center text-stone-600">
            @(Model.Query is { } query ? T.Format("Clients.Search.NoMatch", query) : T["Clients.Search.Empty"])
        </p>
    }
    else
    {
        <ul class="divide-y divide-stone-200 rounded-lg border border-stone-200 bg-white shadow-sm" data-testid="client-list">
            @foreach (var client in Model.Clients)
            {
                <li data-testid="client-row">
                    <a href="/admin/clients/@client.Id" class="flex min-h-11 flex-col gap-1 p-4 hover:bg-stone-50 sm:flex-row sm:items-center sm:justify-between">
                        <span class="flex items-center gap-2">
                            <span class="font-semibold">@client.FullName</span>
                            @if (!client.IsActive)
                            {
                                <span class="rounded bg-stone-200 px-1.5 py-0.5 text-xs text-stone-700">@T["Clients.Search.Inactive"]</span>
                            }
                        </span>
                        <span class="flex flex-wrap gap-x-4 text-sm text-stone-600">
                            <span data-testid="client-phone"><span class="sr-only">@T["Clients.Search.Phone"]: </span>@(client.Phone ?? "—")</span>
                            <span>@T["Clients.Search.LastVisit"]: —</span>
                        </span>
                    </a>
                </li>
            }
        </ul>
    }
</section>