@using Salon.Web.Features.Clients.CreateClient
@model CreateClientCommand
@{
    ViewData["Title"] = T["Clients.Create.Title"];
    const string inputClass = "field field-compact";
    var consentWording = ViewData[CreateClientController.ConsentWordingKey] as string ?? string.Empty;
}
<section class="mx-auto max-w-lg space-y-6">
    <h1 class="page-title">@T["Clients.Create.Title"]</h1>
    <form method="post" asp-action="New" class="space-y-5" novalidate data-testid="create-client-form">
        <div asp-validation-summary="ModelOnly" class="notice notice-error" role="alert"></div>

        <div class="grid gap-5 sm:grid-cols-2">
            <div class="space-y-1">
                <label asp-for="FirstName" class="field-label">@T["Clients.Create.FirstName"]</label>
                <input asp-for="FirstName" type="text" maxlength="100" autocomplete="off" aria-describedby="first-name-error" class="@inputClass" />
                <span asp-validation-for="FirstName" id="first-name-error" class="field-error"></span>
            </div>
            <div class="space-y-1">
                <label asp-for="LastName" class="field-label">@T["Clients.Create.LastName"]</label>
                <input asp-for="LastName" type="text" maxlength="100" autocomplete="off" aria-describedby="last-name-error" class="@inputClass" />
                <span asp-validation-for="LastName" id="last-name-error" class="field-error"></span>
            </div>
        </div>

        <div class="space-y-1">
            <label asp-for="Phone" class="field-label">@T["Clients.Create.Phone"]</label>
            <input asp-for="Phone" type="tel" inputmode="tel" maxlength="30" autocomplete="off" aria-describedby="phone-hint phone-error" class="@inputClass" />
            <p id="phone-hint" class="text-sm text-stone-500">@T["Clients.Create.PhoneHint"]</p>
            <span asp-validation-for="Phone" id="phone-error" class="field-error"></span>
        </div>

        <div class="space-y-1">
            <label asp-for="Email" class="field-label">@T["Clients.Create.Email"]</label>
            <input asp-for="Email" type="email" inputmode="email" maxlength="254" autocomplete="off" spellcheck="false" aria-describedby="email-error" class="@inputClass" />
            <span asp-validation-for="Email" id="email-error" class="field-error"></span>
        </div>

        <div class="space-y-1">
            <label asp-for="Notes" class="field-label">@T["Clients.Create.Notes"]</label>
            <textarea asp-for="Notes" rows="3" maxlength="4000" aria-describedby="notes-hint notes-error" class="@inputClass"></textarea>
            <p id="notes-hint" class="text-sm text-stone-500">@T["Clients.Create.NotesHint"]</p>
            <span asp-validation-for="Notes" id="notes-error" class="field-error"></span>
        </div>

        <fieldset class="space-y-4 rounded-lg border border-amber-300 bg-amber-50 p-4" data-testid="health-section">
            <legend class="px-1 text-sm font-semibold text-amber-900">@T["Clients.Create.HealthNotes"]</legend>
            <p id="health-notes-hint" class="text-sm text-amber-900">@T["Clients.Create.HealthNotesHint"]</p>
            <div class="space-y-1">
                <label asp-for="HealthNotes" class="field-label">@T["Clients.Create.HealthNotes"]</label>
                <textarea asp-for="HealthNotes" rows="3" maxlength="2000" aria-describedby="health-notes-hint health-notes-error" class="@inputClass"></textarea>
                <span asp-validation-for="HealthNotes" id="health-notes-error" class="field-error"></span>
            </div>
            <div class="space-y-1">
                <label asp-for="LastPatchTestOn" class="field-label">@T["Clients.Create.LastPatchTestOn"]</label>
                <input asp-for="LastPatchTestOn" type="date" aria-describedby="patch-test-hint patch-test-error" class="@inputClass sm:max-w-xs" />
                <p id="patch-test-hint" class="text-sm text-stone-600">@T["Clients.Create.LastPatchTestOnHint"]</p>
                <span asp-validation-for="LastPatchTestOn" id="patch-test-error" class="field-error"></span>
            </div>
        </fieldset>

        <div class="space-y-2">
            <p class="text-sm font-medium">@T["Clients.Create.MarketingConsent"]</p>
            <label class="flex items-start gap-3 rounded-md border border-stone-300 p-3">
                <input asp-for="MarketingConsent" type="checkbox" data-testid="marketing-consent" class="mt-1 size-5 shrink-0 rounded border-stone-300" />
                <span class="text-sm" data-testid="consent-wording">@consentWording</span>
            </label>
        </div>

        <div class="flex flex-col gap-3 pt-2 sm:flex-row sm:justify-end">
            <a href="/admin/clients" class="btn btn-compact btn-secondary">@T["Clients.Create.Cancel"]</a>
            <button type="submit" class="btn btn-compact btn-primary">@T["Clients.Create.Submit"]</button>
        </div>
    </form>
</section>