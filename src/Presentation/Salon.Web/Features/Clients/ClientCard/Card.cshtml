@using System.Globalization
@using Salon.Core.Identity
@using Salon.Services.Clients
@using Salon.Services.Payments
@using Salon.Web.Features.Clients.ClientCard
@model ClientCardViewModel
@{
    var card = Model.Card;
    var history = Model.History;
    var culture = CultureInfo.CurrentCulture;
    ViewData["Title"] = T["Clients.Card.Title"];
    // The visit rows (a partial) read this to decide whether a missed or cancelled visit links to its fee page.
    ViewData["FeesInUse"] = Model.FeesInUse;
    var canMerge = !card.IsMerged && User.HasClaim(UserClaimTypes.Permission, Permissions.ClientsMerge);
    const string labelClass = "text-sm text-stone-500";
    const string valueClass = "text-base";
    const string secondaryButtonClass = "inline-flex min-h-11 items-center justify-center rounded-md border border-stone-300 px-4 py-2 text-base font-medium hover:bg-stone-100";
}
<section class="mx-auto max-w-2xl space-y-6" data-testid="client-card">
    @if (Model.Flash is { } flash)
    {
        <p role="status" data-testid="flash" class="rounded-md border border-green-200 bg-green-50 p-3 text-sm text-green-800">@flash</p>
    }
    @if (card.IsMerged)
    {
        <p role="status" data-testid="merged-banner" class="flex flex-col gap-2 rounded-md border border-amber-300 bg-amber-50 p-3 text-sm text-amber-900 sm:flex-row sm:items-center sm:justify-between">
            <span>@T.Format("Clients.Card.MergedInto", Model.MergedIntoName ?? string.Empty)</span>
            <a href="/admin/clients/@card.MergedIntoClientId" data-testid="merged-into-link" class="inline-flex min-h-11 items-center font-medium underline">@T["Clients.Card.OpenMergedInto"]</a>
        </p>
    }
    <a href="/admin/clients" class="inline-flex min-h-11 items-center text-sm font-medium text-stone-700 hover:underline">&larr; @T["Clients.Card.Back"]</a>
    <header class="space-y-1">
        <p class="text-sm text-stone-500">@T["Clients.Card.Title"]</p>
        <h1 class="flex flex-wrap items-center gap-2 text-2xl font-bold tracking-tight sm:text-3xl">
            <span data-testid="client-name">@card.FullName</span>
            @if (!card.IsActive)
            {
                <span class="rounded bg-stone-200 px-1.5 py-0.5 text-xs font-medium text-stone-700">@T["Clients.Card.Inactive"]</span>
            }
        </h1>
        <p class="text-sm text-stone-500">@T.Format("Clients.Card.Since", card.CreatedAt.InZone(Model.Zone).Date.ToString("d", culture))</p>
    </header>

    <section class="space-y-3 rounded-lg border border-stone-200 bg-white p-4 shadow-sm">
        <h2 class="text-lg font-semibold">@T["Clients.Card.Contact"]</h2>
        <dl class="grid gap-3 sm:grid-cols-3">
            <div>
                <dt class="@labelClass">@T["Clients.Card.Phone"]</dt>
                <dd class="@valueClass" data-testid="client-phone">@if (card.Phone is { } phone) { <a href="tel:@phone" class="underline">@phone</a> } else { <text>—</text> }</dd>
            </div>
            <div>
                <dt class="@labelClass">@T["Clients.Card.Email"]</dt>
                <dd class="@valueClass break-all" data-testid="client-email">@if (card.Email is { } email) { <a href="mailto:@email" class="underline">@email</a> } else { <text>—</text> }</dd>
            </div>
            <div>
                <dt class="@labelClass">@T["Clients.Card.LastVisit"]</dt>
                <dd class="@valueClass" data-testid="last-visit">@(history.LastVisitOn is { } lastVisit ? lastVisit.ToString("d", culture) : "—")</dd>
            </div>
        </dl>
    </section>

    @if (Model.Account.Fees.Count > 0 || Model.Account.Deposits.Count > 0)
    {
        <section class="space-y-3 rounded-lg border border-stone-200 bg-white p-4 shadow-sm" data-testid="client-fees">
            <div class="flex flex-wrap items-center justify-between gap-2">
                <h2 class="text-lg font-semibold">@T["Clients.Fees.Title"]</h2>
                @if (Model.Account.Owed is { } owed)
                {
                    <p class="rounded bg-amber-100 px-2 py-1 text-sm font-medium text-amber-900" data-testid="client-owes">@T.Format("Clients.Fees.Owes", owed.ToDisplayString(culture))</p>
                }
                else
                {
                    <p class="text-sm text-stone-600" data-testid="client-owes-nothing">@T["Clients.Fees.NothingOwed"]</p>
                }
            </div>
            @if (Model.Account.Fees.Count > 0)
            {
            <ul class="divide-y divide-stone-200 rounded-md border border-stone-200" data-testid="fee-list">
                @foreach (var fee in Model.Account.Fees)
                {
                    var feeBadge = fee.Status switch
                    {
                        FeeStatus.Paid => "bg-green-100 text-green-900",
                        FeeStatus.Waived => "bg-stone-200 text-stone-800",
                        _ => "bg-amber-100 text-amber-900",
                    };
                    <li data-testid="fee-row" data-status="@fee.Status">
                        <a href="/admin/payments/fees/@fee.AppointmentId" data-testid="fee-link" class="flex min-h-11 flex-col gap-1 p-3 hover:bg-stone-50 sm:flex-row sm:items-center sm:justify-between">
                            <span class="flex flex-col gap-0.5">
                                <span class="font-medium">@T[$"Payments.Fee.Kind.{fee.Kind}"]</span>
                                <span class="text-sm text-stone-600">@fee.ServiceName · <span class="tabular-nums">@fee.AppointmentStart.LocalDateTime.ToString("g", culture)</span></span>
                            </span>
                            <span class="flex items-center gap-3 text-sm">
                                <span class="rounded px-1.5 py-0.5 text-xs font-medium @feeBadge" data-testid="fee-row-status">@T[$"Payments.Fee.Status.{fee.Status}"]</span>
                                <span class="tabular-nums" data-testid="fee-row-amount">@fee.Amount.ToDisplayString(culture)</span>
                            </span>
                        </a>
                    </li>
                }
            </ul>
            }
            @if (Model.Account.Deposits.Count > 0)
            {
                <h3 class="text-base font-semibold">@T["Clients.Fees.Deposits"]</h3>
                <ul class="divide-y divide-stone-200 rounded-md border border-stone-200" data-testid="deposit-list">
                    @foreach (var deposit in Model.Account.Deposits)
                    {
                        <li data-testid="deposit-row" data-held="@deposit.IsHeld.ToString().ToLowerInvariant()">
                            <a href="/admin/payments/deposits/@deposit.AppointmentId" data-testid="deposit-link" class="flex min-h-11 flex-col gap-1 p-3 hover:bg-stone-50 sm:flex-row sm:items-center sm:justify-between">
                                <span class="text-sm text-stone-600">@deposit.ServiceName · <span class="tabular-nums">@deposit.AppointmentStart.LocalDateTime.ToString("g", culture)</span></span>
                                <span class="flex items-center gap-3 text-sm">
                                    <span class="rounded px-1.5 py-0.5 text-xs font-medium @(deposit.IsHeld ? "bg-green-100 text-green-900" : "bg-stone-200 text-stone-800")" data-testid="deposit-row-status">@T[deposit.IsHeld ? "Payments.Deposit.Status.Held" : "Payments.Deposit.Status.Returned"]</span>
                                    <span class="tabular-nums" data-testid="deposit-row-amount">@deposit.Amount.ToDisplayString(culture)</span>
                                </span>
                            </a>
                        </li>
                    }
                </ul>
            }
        </section>
    }

    <section class="space-y-4 rounded-lg border border-stone-200 bg-white p-4 shadow-sm" data-testid="history">
        <h2 class="text-lg font-semibold">@T["Clients.History.Title"]</h2>
        <dl class="grid grid-cols-2 gap-3">
            <div class="rounded-md bg-stone-50 p-3">
                <dt class="@labelClass">@T["Clients.History.VisitsCompleted"]</dt>
                <dd class="text-2xl font-bold tabular-nums" data-testid="visits-completed">@history.VisitsCompleted</dd>
            </div>
            <div class="rounded-md bg-stone-50 p-3">
                <dt class="@labelClass">@T["Clients.History.NoShows"]</dt>
                <dd class="text-2xl font-bold tabular-nums" data-testid="no-shows">@history.NoShows</dd>
            </div>
        </dl>

        <h3 class="text-base font-semibold">@T["Clients.History.Upcoming"]</h3>
        @if (history.Upcoming.Count == 0)
        {
            <p class="text-sm text-stone-500" data-testid="no-upcoming">@T["Clients.History.NoUpcoming"]</p>
        }
        else
        {
            <ul class="divide-y divide-stone-200 rounded-md border border-stone-200" data-testid="upcoming-list">
                @foreach (var visit in history.Upcoming)
                {
                    <partial name="_Visit" model="visit" />
                }
            </ul>
        }

        <h3 class="text-base font-semibold">@T["Clients.History.Past"]</h3>
        @if (history.Past.Count == 0)
        {
            <p class="text-sm text-stone-500" data-testid="no-past">@T["Clients.History.NoPast"]</p>
        }
        else
        {
            <ul class="divide-y divide-stone-200 rounded-md border border-stone-200" data-testid="past-list">
                @foreach (var visit in history.Past)
                {
                    <partial name="_Visit" model="visit" />
                }
            </ul>
        }
    </section>

    <section class="space-y-2 rounded-lg border border-stone-200 bg-white p-4 shadow-sm">
        <h2 class="text-lg font-semibold">@T["Clients.Card.Notes"]</h2>
        @if (card.Notes is { } notes)
        {
            <p class="whitespace-pre-line text-base" data-testid="client-notes">@notes</p>
        }
        else
        {
            <p class="text-sm text-stone-500">@T["Clients.Card.NoNotes"]</p>
        }
    </section>

    <section class="space-y-3 rounded-lg border border-amber-300 bg-amber-50 p-4" data-testid="health-section">
        <h2 class="text-lg font-semibold text-amber-900">@T["Clients.Card.HealthNotes"]</h2>
        <p class="text-sm text-amber-900">@T["Clients.Card.HealthNotesHint"]</p>
        @if (card.HealthNotesUnreadable)
        {
            <p role="alert" class="rounded-md border border-red-200 bg-red-50 p-3 text-sm text-red-700" data-testid="health-notes-unreadable">@T["Clients.Card.HealthNotesUnreadable"]</p>
        }
        else if (card.HealthNotes is { } healthNotes)
        {
            <p class="whitespace-pre-line text-base" data-testid="health-notes">@healthNotes</p>
        }
        else
        {
            <p class="text-sm text-stone-600" data-testid="health-notes">@T["Clients.Card.NoHealthNotes"]</p>
        }
        <dl>
            <dt class="text-sm text-stone-600">@T["Clients.Card.LastPatchTestOn"]</dt>
            <dd class="text-base" data-testid="patch-test">@(card.LastPatchTestOn is { } patchTest ? patchTest.ToString("d", culture) : T["Clients.Card.NoPatchTest"])</dd>
        </dl>
    </section>

    <section class="space-y-2 rounded-lg border border-stone-200 bg-white p-4 shadow-sm">
        <h2 class="text-lg font-semibold">@T["Clients.Card.MarketingConsent"]</h2>
        @if (card.MarketingConsent && card.MarketingConsentAt is { } consentAt)
        {
            <p class="text-base font-medium text-green-800" data-testid="consent-status">@T.Format("Clients.Card.ConsentGranted", consentAt.InZone(Model.Zone).LocalDateTime.ToString("g", culture))</p>
            @if (card.MarketingConsentWording is { } wording)
            {
                <p class="text-sm text-stone-500">@T["Clients.Card.ConsentWording"]</p>
                <blockquote class="border-l-2 border-stone-300 pl-3 text-sm text-stone-700" data-testid="consent-wording">@wording</blockquote>
            }
        }
        else
        {
            <p class="text-base text-stone-600" data-testid="consent-status">@T["Clients.Card.ConsentNotGranted"]</p>
        }
    </section>

    <div class="flex flex-col gap-3 sm:flex-row sm:justify-end">
        @if (canMerge)
        {
            <a href="/admin/clients/@card.Id/merge" data-testid="merge-link" class="@secondaryButtonClass">@T["Clients.Card.Merge"]</a>
        }
        <a href="/admin/clients/@card.Id/edit" class="@secondaryButtonClass">@T["Clients.Card.Edit"]</a>
    </div>
</section>
