@using System.Globalization
@using NodaTime
@using Salon.Core.Staff
@using Salon.Web.Features.Staff.ListStaff
@model ListStaffViewModel
@{
    ViewData["Title"] = T["Staff.List.Title"];
    const string buttonClass = "inline-flex min-h-11 items-center justify-center rounded-md bg-stone-900 px-4 py-2 text-base font-medium text-white hover:bg-stone-700";
    const string linkClass = "inline-flex min-h-11 items-center justify-center rounded-md border border-stone-300 px-4 py-2 text-sm font-medium hover:bg-stone-100";
}
@functions {
    string DayShort(IsoDayOfWeek day) => T[$"Common.DayShort.{day}"];

    string Days(WorkingHoursGroup group) => group.From == group.To ? DayShort(group.From) : $"{DayShort(group.From)}–{DayShort(group.To)}";

    static string Time(LocalTime time) => time.ToString("HH:mm", CultureInfo.InvariantCulture);

    static string Ranges(WorkingHoursGroup group) => string.Join(", ", group.Ranges.Select(r => $"{Time(r.Start)}–{Time(r.End)}"));
}
<section class="space-y-6">
    @if (Model.Flash is { } flash)
    {
        <p role="status" data-testid="flash" class="rounded-md border border-green-200 bg-green-50 p-3 text-sm text-green-800">@flash</p>
    }
    <header class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
        <div class="space-y-1">
            <h1 class="text-2xl font-bold tracking-tight sm:text-3xl">@T["Staff.List.Title"]</h1>
            <p class="text-stone-600">@T["Staff.List.Subtitle"]</p>
        </div>
        <a href="/admin/staff/new" data-testid="add-staff" class="@buttonClass">@T["Staff.List.Add"]</a>
    </header>
    @if (Model.Staff.Count == 0)
    {
        <p data-testid="empty-state" class="rounded-md border border-dashed border-stone-300 p-6 text-center text-stone-600">@T["Staff.List.Empty"]</p>
    }
    else
    {
        <ul class="grid gap-3 sm:grid-cols-2" data-testid="staff-list">
            @foreach (var person in Model.Staff)
            {
                <li class="flex flex-col gap-3 rounded-lg border border-stone-200 bg-white p-4 shadow-sm @(person.IsActive ? "" : "opacity-60")" data-testid="staff-card" data-active="@person.IsActive.ToString().ToLowerInvariant()">
                    <div class="flex items-start gap-3">
                        <span class="mt-1.5 size-3 shrink-0 rounded-full" style="background-color: @person.Colour" aria-hidden="true"></span>
                        <div class="min-w-0 flex-1 space-y-1">
                            <h2 class="text-lg font-semibold leading-snug" data-testid="staff-name">@person.DisplayName</h2>
                            @if (!person.IsActive || !person.IsBookable)
                            {
                                <p class="flex flex-wrap gap-2 text-xs font-medium uppercase tracking-wide text-stone-500">
                                    @if (!person.IsActive)
                                    {
                                        <span class="rounded bg-stone-100 px-2 py-0.5" data-testid="badge-inactive">@T["Staff.List.Inactive"]</span>
                                    }
                                    @if (!person.IsBookable)
                                    {
                                        <span class="rounded bg-stone-100 px-2 py-0.5" data-testid="badge-not-bookable">@T["Staff.List.NotBookable"]</span>
                                    }
                                </p>
                            }
                        </div>
                    </div>
                    <div class="text-sm text-stone-600" data-testid="staff-hours">
                        <span class="sr-only">@T["Staff.List.Hours"]: </span>
                        @if (person.Hours.Count == 0)
                        {
                            <span class="italic">@T["Staff.List.NoHours"]</span>
                        }
                        else
                        {
                            @foreach (var group in person.Hours)
                            {
                                <span class="block tabular-nums">@Days(group) @Ranges(group)</span>
                            }
                        }
                    </div>
                    <a href="/admin/staff/@person.Id/hours" data-testid="edit-hours" class="@linkClass">@T["Staff.List.EditHours"]</a>
                    <a href="/admin/staff/@person.Id/time-off" data-testid="time-off" class="@linkClass">@T["Staff.List.TimeOff"]</a>
                    <a href="/admin/staff/@person.Id/edit" data-testid="edit-staff" class="@linkClass">@T["Staff.List.Edit"]</a>
                </li>
            }
        </ul>
    }
</section>
