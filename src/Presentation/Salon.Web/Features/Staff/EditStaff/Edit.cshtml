@using Salon.Web.Features.Staff.EditStaff
@model EditStaffCommand
@{
    ViewData["Title"] = T["Staff.Edit.Title"];
    const string inputClass = "block w-full min-h-11 rounded-md border border-stone-300 px-3 py-2 text-base shadow-sm focus:border-stone-900 focus:outline-none focus:ring-1 focus:ring-stone-900";
}
<section class="mx-auto max-w-lg space-y-6">
    <h1 class="text-2xl font-bold tracking-tight sm:text-3xl">@T["Staff.Edit.Title"]</h1>
    <form method="post" asp-action="Edit" class="space-y-5" novalidate data-testid="edit-staff-form">
        <div asp-validation-summary="ModelOnly" class="rounded-md border border-red-200 bg-red-50 p-3 text-sm text-red-700" role="alert"></div>

        <div class="space-y-1">
            <label asp-for="DisplayName" class="block text-sm font-medium">@T["Staff.Create.DisplayName"]</label>
            <input asp-for="DisplayName" type="text" maxlength="100" autocomplete="off" aria-describedby="display-name-hint display-name-error" class="@inputClass" />
            <p id="display-name-hint" class="text-sm text-stone-500">@T["Staff.Create.DisplayNameHint"]</p>
            <span asp-validation-for="DisplayName" id="display-name-error" class="block text-sm text-red-700"></span>
        </div>

        <div class="grid gap-5 sm:grid-cols-2">
            <div class="space-y-1">
                <label asp-for="Email" class="block text-sm font-medium">@T["Staff.Create.Email"]</label>
                <input asp-for="Email" type="email" inputmode="email" maxlength="254" autocomplete="off" spellcheck="false" aria-describedby="email-hint email-error" class="@inputClass" />
                <p id="email-hint" class="text-sm text-stone-500">@T["Staff.Create.Optional"]</p>
                <span asp-validation-for="Email" id="email-error" class="block text-sm text-red-700"></span>
            </div>
            <div class="space-y-1">
                <label asp-for="Phone" class="block text-sm font-medium">@T["Staff.Create.Phone"]</label>
                <input asp-for="Phone" type="tel" inputmode="tel" maxlength="30" autocomplete="off" aria-describedby="phone-hint phone-error" class="@inputClass" />
                <p id="phone-hint" class="text-sm text-stone-500">@T["Staff.Create.Optional"]</p>
                <span asp-validation-for="Phone" id="phone-error" class="block text-sm text-red-700"></span>
            </div>
        </div>

        <div class="space-y-1">
            <label asp-for="Colour" class="block text-sm font-medium">@T["Staff.Create.Colour"]</label>
            <input asp-for="Colour" type="color" aria-describedby="colour-hint colour-error" class="block h-11 w-20 cursor-pointer rounded-md border border-stone-300 bg-white p-1" />
            <p id="colour-hint" class="text-sm text-stone-500">@T["Staff.Create.ColourHint"]</p>
            <span asp-validation-for="Colour" id="colour-error" class="block text-sm text-red-700"></span>
        </div>

        <div class="flex min-h-11 items-center gap-3">
            <input asp-for="IsBookable" type="checkbox" class="size-5 rounded border-stone-300" />
            <label asp-for="IsBookable" class="text-sm font-medium">@T["Staff.Create.IsBookable"]</label>
        </div>

        <div class="flex min-h-11 items-center gap-3">
            <input asp-for="IsActive" type="checkbox" class="size-5 rounded border-stone-300" />
            <label asp-for="IsActive" class="text-sm font-medium">@T["Staff.Edit.IsActive"]</label>
        </div>

        <div class="flex flex-col gap-3 pt-2 sm:flex-row sm:justify-end">
            <a href="/admin/staff" class="inline-flex min-h-11 items-center justify-center rounded-md border border-stone-300 px-4 py-2 text-base font-medium hover:bg-stone-100">@T["Staff.Create.Cancel"]</a>
            <button type="submit" class="inline-flex min-h-11 items-center justify-center rounded-md bg-stone-900 px-4 py-2 text-base font-medium text-white hover:bg-stone-700">@T["Staff.Edit.Submit"]</button>
        </div>
    </form>
</section>
