@using System.Globalization
@using NodaTime
@using NodaTime.Text
@using Salon.Core.Staff
@using Salon.Web.Features.Staff.TimeOff
@model TimeOffViewModel
@{
    ViewData["Title"] = T["Staff.TimeOff.Title"];
    const string inputClass = "block w-full min-h-11 rounded-md border border-stone-300 px-3 py-2 text-base tabular-nums shadow-sm focus:border-stone-900 focus:outline-none focus:ring-1 focus:ring-stone-900";
    const string buttonClass = "inline-flex min-h-11 items-center justify-center rounded-md bg-stone-900 px-4 py-2 text-base font-medium text-white hover:bg-stone-700";
    const string linkClass = "inline-flex min-h-11 items-center justify-center rounded-md border border-stone-300 px-4 py-2 text-sm font-medium hover:bg-stone-100";
    var stepSeconds = WorkingHoursRules.StepMinutes * 60;
    var datePattern = LocalDatePattern.Create("d", CultureInfo.CurrentCulture);
    var formErrors = Errors(AddTimeOffValidator.OverlapKey);
    var timeOff = Model.Page;
}
@functions {
    IReadOnlyList<string> Errors(string key)
        => ViewData.ModelState.TryGetValue(key, out var entry) ? entry.Errors.Select(e => e.ErrorMessage).ToList() : [];

    static string Time(LocalTime time) => time.ToString("HH:mm", CultureInfo.InvariantCulture);

    string Dates(StaffTimeOff entry, LocalDatePattern pattern)
        => entry.FromDate == entry.ToDate ? pattern.Format(entry.FromDate) : $"{pattern.Format(entry.FromDate)}–{pattern.Format(entry.ToDate)}";

    string Times(StaffTimeOff entry) => entry.Range is { } range ? $"{Time(range.Start)}–{Time(range.End)}" : T["Staff.TimeOff.WholeDay"];
}
<section class="mx-auto max-w-2xl space-y-6" data-testid="time-off-page">
    @if (Model.Flash is { } flash)
    {
        <p role="status" data-testid="flash" class="rounded-md border border-green-200 bg-green-50 p-3 text-sm text-green-800">@flash</p>
    }
    <header class="space-y-1">
        <h1 class="text-2xl font-bold tracking-tight sm:text-3xl">@T["Staff.TimeOff.Title"]</h1>
        <p class="text-lg text-stone-700" data-testid="staff-name">@timeOff.DisplayName</p>
        <p class="text-sm text-stone-500">@T["Staff.TimeOff.Hint"]</p>
    </header>

    <form method="post" asp-action="Add" asp-route-id="@timeOff.StaffMemberId" class="space-y-4 rounded-lg border border-stone-200 bg-white p-4 shadow-sm" novalidate data-testid="time-off-form">
        <h2 class="text-lg font-semibold">@T["Staff.TimeOff.AddHeading"]</h2>
        @if (formErrors.Count > 0)
        {
            <p role="alert" data-testid="form-error" class="rounded-md border border-red-200 bg-red-50 p-3 text-sm text-red-700">@string.Join(" ", formErrors)</p>
        }
        <div class="grid grid-cols-2 gap-3">
            @foreach (var (name, labelKey, value) in new[] { ("FromDate", "Staff.TimeOff.From", Model.Form.FromDate), ("ToDate", "Staff.TimeOff.To", Model.Form.ToDate) })
            {
                var errors = Errors(name);
                var errorId = $"{name}-error";
                <div class="space-y-1">
                    <label for="@name" class="block text-sm font-medium">@T[labelKey]</label>
                    <input id="@name" name="@name" type="date" value="@value" required aria-describedby="@errorId" aria-invalid="@(errors.Count > 0 ? "true" : "false")"
                           class="@inputClass @(errors.Count > 0 ? "input-validation-error" : "")" />
                    <span id="@errorId" class="block text-sm text-red-700" data-testid="@($"{name}-error")">@string.Join(" ", errors)</span>
                </div>
            }
        </div>
        <fieldset class="space-y-2">
            <legend class="text-sm font-medium">@T["Staff.TimeOff.TimesLegend"]</legend>
            <p class="text-xs text-stone-500">@T["Staff.TimeOff.TimesHint"]</p>
            <div class="grid grid-cols-2 gap-3">
                @foreach (var (name, labelKey, value) in new[] { ("Start", "Staff.TimeOff.Start", Model.Form.Start), ("End", "Staff.TimeOff.End", Model.Form.End) })
                {
                    var errors = Errors(name);
                    var errorId = $"{name}-error";
                    <div class="space-y-1">
                        <label for="@name" class="block text-sm font-medium">@T[labelKey]</label>
                        <input id="@name" name="@name" type="time" step="@stepSeconds" value="@value" aria-describedby="@errorId" aria-invalid="@(errors.Count > 0 ? "true" : "false")"
                               class="@inputClass @(errors.Count > 0 ? "input-validation-error" : "")" />
                        <span id="@errorId" class="block text-sm text-red-700" data-testid="@($"{name}-error")">@string.Join(" ", errors)</span>
                    </div>
                }
            </div>
        </fieldset>
        @{
            var reasonErrors = Errors("Reason");
        }
        <div class="space-y-1">
            <label for="Reason" class="block text-sm font-medium">@T["Staff.TimeOff.Reason"]</label>
            <input id="Reason" name="Reason" type="text" value="@Model.Form.Reason" maxlength="@StaffTimeOff.ReasonMaxLength" autocomplete="off" aria-describedby="Reason-error" aria-invalid="@(reasonErrors.Count > 0 ? "true" : "false")"
                   class="@inputClass @(reasonErrors.Count > 0 ? "input-validation-error" : "")" />
            <span id="Reason-error" class="block text-sm text-red-700" data-testid="Reason-error">@string.Join(" ", reasonErrors)</span>
        </div>
        <div class="flex flex-col gap-3 pt-2 sm:flex-row sm:justify-end">
            <button type="submit" class="@buttonClass" data-testid="add-time-off">@T["Staff.TimeOff.Add"]</button>
        </div>
    </form>

    <section class="space-y-3" aria-labelledby="upcoming-heading">
        <h2 id="upcoming-heading" class="text-lg font-semibold">@T["Staff.TimeOff.Upcoming"]</h2>
        @if (timeOff.Upcoming.Count == 0)
        {
            <p data-testid="empty-state" class="rounded-md border border-dashed border-stone-300 p-6 text-center text-stone-600">@T["Staff.TimeOff.Empty"]</p>
        }
        else
        {
            <ul class="space-y-3" data-testid="upcoming-list">
                @foreach (var entry in timeOff.Upcoming)
                {
                    <li class="flex flex-col gap-3 rounded-lg border border-stone-200 bg-white p-4 shadow-sm sm:flex-row sm:items-center sm:justify-between" data-testid="time-off-entry" data-whole-day="@entry.IsWholeDay.ToString().ToLowerInvariant()">
                        <div class="min-w-0 space-y-1">
                            <p class="font-semibold tabular-nums" data-testid="entry-dates">@Dates(entry, datePattern)</p>
                            <p class="text-sm text-stone-600 tabular-nums" data-testid="entry-time">@Times(entry)</p>
                            @if (entry.Reason is { } reason)
                            {
                                <p class="text-sm text-stone-600" data-testid="entry-reason">@reason</p>
                            }
                        </div>
                        <form method="post" asp-action="Delete" asp-route-id="@timeOff.StaffMemberId" asp-route-entryId="@entry.Id">
                            <button type="submit" class="@linkClass w-full sm:w-auto" data-testid="delete-entry">
                                @T["Staff.TimeOff.Delete"]<span class="sr-only">: @Dates(entry, datePattern)</span>
                            </button>
                        </form>
                    </li>
                }
            </ul>
        }
    </section>

    @if (timeOff.PastTotal > 0)
    {
        <details class="rounded-lg border border-stone-200 bg-white shadow-sm" data-testid="past">
            <summary class="min-h-11 cursor-pointer px-4 py-3 font-semibold">@T.Format("Staff.TimeOff.PastSummary", timeOff.PastTotal)</summary>
            <ul class="divide-y divide-stone-200 border-t border-stone-200" data-testid="past-list">
                @foreach (var entry in timeOff.Past)
                {
                    <li class="space-y-1 px-4 py-3 text-stone-600" data-testid="past-entry">
                        <p class="tabular-nums" data-testid="entry-dates">@Dates(entry, datePattern) <span class="text-sm">· @Times(entry)</span></p>
                        @if (entry.Reason is { } reason)
                        {
                            <p class="text-sm" data-testid="entry-reason">@reason</p>
                        }
                    </li>
                }
            </ul>
            @if (timeOff.PastTotal > timeOff.Past.Count)
            {
                <p class="px-4 py-3 text-sm text-stone-500" data-testid="past-more">@T.Format("Staff.TimeOff.PastMore", timeOff.PastTotal - timeOff.Past.Count)</p>
            }
        </details>
    }

    <div class="flex flex-col gap-3 sm:flex-row">
        <a href="/admin/staff/@timeOff.StaffMemberId/hours" class="@linkClass" data-testid="edit-hours">@T["Staff.TimeOff.Hours"]</a>
        <a href="/admin/staff" class="@linkClass" data-testid="back-to-staff">@T["Staff.TimeOff.Back"]</a>
    </div>
</section>
