@using Salon.Web.Features.Staff.CreateStaff
@model CreateStaffCommand
@{
    ViewData["Title"] = T["Staff.Create.Title"];
    const string inputClass = "field field-compact";
}
<section class="mx-auto max-w-lg space-y-6">
    <h1 class="page-title">@T["Staff.Create.Title"]</h1>
    <form method="post" asp-action="New" class="space-y-5" novalidate data-testid="create-staff-form">
        <div asp-validation-summary="ModelOnly" class="notice notice-error" role="alert"></div>

        <div class="space-y-1">
            <label asp-for="DisplayName" class="field-label">@T["Staff.Create.DisplayName"]</label>
            <input asp-for="DisplayName" type="text" maxlength="100" autocomplete="off" aria-describedby="display-name-hint display-name-error" class="@inputClass" />
            <p id="display-name-hint" class="text-sm text-stone-500">@T["Staff.Create.DisplayNameHint"]</p>
            <span asp-validation-for="DisplayName" id="display-name-error" class="field-error"></span>
        </div>

        <div class="grid gap-5 sm:grid-cols-2">
            <div class="space-y-1">
                <label asp-for="Email" class="field-label">@T["Staff.Create.Email"]</label>
                <input asp-for="Email" type="email" inputmode="email" maxlength="254" autocomplete="off" spellcheck="false" aria-describedby="email-hint email-error" class="@inputClass" />
                <p id="email-hint" class="text-sm text-stone-500">@T["Staff.Create.Optional"]</p>
                <span asp-validation-for="Email" id="email-error" class="field-error"></span>
            </div>
            <div class="space-y-1">
                <label asp-for="Phone" class="field-label">@T["Staff.Create.Phone"]</label>
                <input asp-for="Phone" type="tel" inputmode="tel" maxlength="30" autocomplete="off" aria-describedby="phone-hint phone-error" class="@inputClass" />
                <p id="phone-hint" class="text-sm text-stone-500">@T["Staff.Create.Optional"]</p>
                <span asp-validation-for="Phone" id="phone-error" class="field-error"></span>
            </div>
        </div>

        <div class="space-y-1">
            <label asp-for="Colour" class="field-label">@T["Staff.Create.Colour"]</label>
            <input asp-for="Colour" type="color" aria-describedby="colour-hint colour-error" class="block h-11 w-20 cursor-pointer rounded-md border border-stone-300 bg-white p-1" />
            <p id="colour-hint" class="text-sm text-stone-500">@T["Staff.Create.ColourHint"]</p>
            <span asp-validation-for="Colour" id="colour-error" class="field-error"></span>
        </div>

        <div class="flex min-h-11 items-center gap-3">
            <input asp-for="IsBookable" type="checkbox" class="size-5 rounded border-stone-300" />
            <label asp-for="IsBookable" class="text-sm font-medium">@T["Staff.Create.IsBookable"]</label>
        </div>

        <div class="flex flex-col gap-3 pt-2 sm:flex-row sm:justify-end">
            <a href="/admin/staff" class="btn btn-compact btn-secondary">@T["Staff.Create.Cancel"]</a>
            <button type="submit" class="btn btn-compact btn-primary">@T["Staff.Create.Submit"]</button>
        </div>
    </form>
</section>