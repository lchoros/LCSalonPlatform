@using System.Globalization
@using Salon.Web.Features.Catalog.ListServices
@model ListServicesViewModel
@{
    ViewData["Title"] = T["Catalog.List.Title"];
    const string buttonClass = "inline-flex min-h-11 items-center justify-center rounded-md bg-stone-900 px-4 py-2 text-base font-medium text-white hover:bg-stone-700";
    const string linkClass = "inline-flex min-h-11 items-center justify-center rounded-md border border-stone-300 px-4 py-2 text-sm font-medium hover:bg-stone-100";
}
<section class="space-y-6">
    @if (Model.Flash is { } flash)
    {
        <p role="status" data-testid="flash" class="rounded-md border border-green-200 bg-green-50 p-3 text-sm text-green-800">@flash</p>
    }
    <header class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
        <div class="space-y-1">
            <h1 class="text-2xl font-bold tracking-tight sm:text-3xl">@T["Catalog.List.Title"]</h1>
            <p class="text-stone-600">@T["Catalog.List.Subtitle"]</p>
        </div>
        <div class="flex flex-col gap-3 sm:flex-row">
            <a href="/admin/services/categories" data-testid="manage-categories" class="@linkClass">@T["Catalog.List.Categories"]</a>
            <a href="/admin/services/new" data-testid="add-service" class="@buttonClass">@T["Catalog.List.Add"]</a>
        </div>
    </header>
    @if (Model.Page.TotalServices > 0)
    {
        <div class="space-y-3" data-testid="service-filters">
            <partial name="_SearchBox" model="Model.Search" />
            @if (Model.Page.Categories.Count > 1)
            {
                <partial name="_FilterTiles" model="Model.Filter" />
            }
        </div>
    }
    @if (Model.Page.TotalServices == 0)
    {
        <p data-testid="empty-state" class="rounded-md border border-dashed border-stone-300 p-6 text-center text-stone-600">@T["Catalog.List.Empty"]</p>
    }
    else if (Model.Groups.Count == 0)
    {
        <div class="space-y-3 rounded-md border border-dashed border-stone-300 p-6 text-center" data-testid="no-match">
            <p class="text-stone-700">@T["Catalog.List.NoMatch"]</p>
            <a href="/admin/services" class="@linkClass" data-testid="show-all">@T["Catalog.List.ShowAll"]</a>
        </div>
    }
    else
    {
        @foreach (var group in Model.Groups)
        {
            <section class="space-y-3" data-testid="service-group" data-category="@(group.CategoryName ?? string.Empty)">
                <h2 class="flex flex-wrap items-center gap-2 text-lg font-semibold" data-testid="group-heading">
                    <span>@(group.CategoryName ?? T["Catalog.List.Uncategorised"])</span>
                    @if (!group.CategoryIsActive)
                    {
                        <span class="rounded bg-stone-100 px-2 py-0.5 text-xs font-medium uppercase tracking-wide text-stone-500" data-testid="badge-category-inactive">@T["Catalog.List.CategoryInactive"]</span>
                    }
                </h2>
                <ul class="grid gap-3 sm:grid-cols-2" data-testid="service-list">
                    @foreach (var service in group.Services)
                    {
                        <li class="flex flex-col gap-3 rounded-lg border border-stone-200 bg-white p-4 shadow-sm @(service.IsActive ? "" : "opacity-60")" data-testid="service-card" data-active="@service.IsActive.ToString().ToLowerInvariant()">
                            <div class="flex items-start justify-between gap-3">
                                <div class="min-w-0 flex-1 space-y-1">
                                    <p class="text-lg font-semibold leading-snug" data-testid="service-name">@service.Name</p>
                                    @if (service.VariantGroup is { } variantOf)
                                    {
                                        <p class="text-sm text-stone-600" data-testid="service-variant-of">@T.Format("Catalog.List.VariantOf", variantOf)</p>
                                    }
                                    @if (!service.IsActive)
                                    {
                                        <p class="text-xs font-medium uppercase tracking-wide text-stone-500">
                                            <span class="rounded bg-stone-100 px-2 py-0.5" data-testid="badge-inactive">@T["Catalog.List.Inactive"]</span>
                                        </p>
                                    }
                                </div>
                                <span class="shrink-0 font-semibold tabular-nums" data-testid="service-price">@service.Price.ToDisplayString(CultureInfo.CurrentCulture)</span>
                            </div>
                            <p class="flex flex-wrap gap-x-3 gap-y-1 text-sm text-stone-600 tabular-nums" data-testid="service-timing">
                                <span data-testid="service-duration">@T.Format("Catalog.List.Duration", (int)service.Duration.TotalMinutes)</span>
                                @if (service.BufferAfterMinutes > 0)
                                {
                                    <span data-testid="service-buffer">@T.Format("Catalog.List.Buffer", service.BufferAfterMinutes)</span>
                                }
                                @if (service.ProcessingMinutes > 0)
                                {
                                    <span data-testid="service-processing">@T.Format("Catalog.List.Processing", service.ProcessingMinutes)</span>
                                }
                            </p>
                            <a href="/admin/services/@service.Id" data-testid="edit-service" class="@linkClass">@T["Catalog.List.Edit"]</a>
                        </li>
                    }
                </ul>
            </section>
        }
        <partial name="_Pager" model="Model.Pager" />
    }
</section>
