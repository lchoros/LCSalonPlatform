@using Salon.Core.Import
@using Salon.Web.Features.Appointments.ImportAppointments
@model UploadAppointmentsViewModel
@{
    ViewData["Title"] = T["Appointments.Import.Title"];
}
<section class="mx-auto max-w-lg space-y-6">
    <partial name="_SectionTabs" model="@AdminSections.Appointments("import")" />
    @if (Model.Flash is { } flash)
    {
        <p role="status" data-testid="flash" class="notice notice-warn">@flash</p>
    }
    <header class="space-y-2">
        <h1 class="page-title">@T["Appointments.Import.Title"]</h1>
        <p class="text-stone-600">@T["Appointments.Import.Intro"]</p>
    </header>

    <ol class="list-decimal space-y-1 rounded-md bg-stone-50 p-3 pl-8 text-sm text-stone-700" data-testid="import-order">
        <li><a href="@ImportAppointmentsController.ClientImportPath" class="underline underline-offset-2">@T["Appointments.Import.Order.Clients"]</a></li>
        <li><a href="@ImportAppointmentsController.ServiceImportPath" class="underline underline-offset-2">@T["Appointments.Import.Order.Services"]</a></li>
        <li>@T["Appointments.Import.Order.Diary"]</li>
    </ol>

    <form method="post" asp-action="Upload" enctype="multipart/form-data" class="space-y-5" data-testid="import-upload-form">
        @if (Model.Error is { } error)
        {
            <p role="alert" data-testid="import-error" class="notice notice-error">@error</p>
        }

        <div class="space-y-1">
            <label for="File" class="field-label">@T["Appointments.Import.File"]</label>
            <input id="File" name="File" type="file" accept=".csv,.txt,text/csv,text/plain" aria-describedby="file-hint"
                   class="block w-full min-h-11 rounded-md border border-stone-300 bg-white px-3 py-2 text-base shadow-sm file:mr-3 file:rounded file:border-0 file:bg-brand file:px-3 file:py-1.5 file:text-sm file:font-medium file:text-white focus:border-brand focus:outline-none focus:ring-1 focus:ring-brand" />
            <p id="file-hint" class="text-sm text-stone-600">@T.Format("Appointments.Import.FileHint", AppointmentImportLimits.MaxRows, ImportAppointmentsController.MaxMegabytes)</p>
        </div>

        <div class="space-y-2 rounded-md bg-stone-50 p-3 text-sm text-stone-700" data-testid="import-columns">
            <p class="font-medium">@T["Appointments.Import.Columns.Title"]</p>
            <p>@T["Appointments.Import.Columns.Lead"]</p>
            <p class="break-all rounded border border-stone-300 bg-white px-2 py-1 font-mono text-xs">@T["Appointments.Import.Columns.Example"]</p>
            <p>@T["Appointments.Import.Columns.Dates"]</p>
        </div>

        <ul class="notice notice-warn list-disc space-y-1 pl-8" data-testid="import-rules">
            <li>@T["Appointments.Import.Rules.Future"]</li>
            <li>@T["Appointments.Import.Rules.Match"]</li>
            <li>@T["Appointments.Import.Rules.Silent"]</li>
            <li>@T["Appointments.Import.Rules.OldSystem"]</li>
            <li>@T["Appointments.Import.Rules.Notes"]</li>
        </ul>

        <div class="flex flex-col gap-3 pt-2 sm:flex-row sm:justify-end">
            <a href="@ImportAppointmentsController.DiaryPath" class="btn btn-compact btn-secondary">@T["Appointments.Import.Cancel"]</a>
            <button type="submit" class="btn btn-compact btn-primary" data-testid="import-upload">@T["Appointments.Import.Upload"]</button>
        </div>
    </form>

    <p><a href="@ImportAppointmentsController.UndoPath" class="inline-flex min-h-11 items-center text-sm font-medium underline underline-offset-2" data-testid="undo-import-link">@T["Appointments.Import.Undo.Link"]</a></p>
</section>