@using System.Globalization
@using NodaTime
@using NodaTime.Text
@using Salon.Core.Appointments
@using Salon.Web.Features.Appointments.Calendar
@model AppointmentCardViewModel
@{
    var card = Model.Card;
    var culture = CultureInfo.CurrentCulture;
    var moveDay = card.MoveDate.ToIso();
    ViewData["Title"] = T["Appointments.Calendar.Card.Title"];
    const string inputClass = "field field-compact";
    const string secondaryClass = "btn btn-compact btn-secondary";
    const string actionClass = "btn btn-compact btn-secondary px-3";
    const string cardClass = "space-y-3 panel";
}
<section class="mx-auto max-w-lg space-y-6">
    <a href="@CalendarController.Path(CalendarView.Day, card.Day, card.StaffMemberId)" data-testid="back" class="back-link">&larr; @T["Appointments.Calendar.Back"]</a>
    <h1 class="page-title">@T["Appointments.Calendar.Card.Title"]</h1>
    @if (Model.Error is { } error)
    {
        <p role="alert" data-testid="error" class="notice notice-error">@error</p>
    }
    @if (!ViewData.ModelState.IsValid)
    {
        <div asp-validation-summary="All" class="notice notice-error" role="alert" data-testid="validation-summary"></div>
    }

    <section class="@cardClass border-l-4" style="border-left-color: @card.Colour" data-testid="appointment-card" data-status="@card.Status">
        <div class="flex flex-wrap items-center justify-between gap-2">
            <h2 class="text-lg font-semibold" data-testid="card-client">@card.ClientName</h2>
            <span class="rounded px-1.5 py-0.5 text-xs font-medium @Badges.Appointment(card.Status)" data-testid="status-badge">@T[$"Appointments.Status.{card.Status}"]</span>
        </div>
        <dl class="grid grid-cols-[auto_1fr] gap-x-4 gap-y-2 text-base">
            <dt class="text-sm text-stone-600">@T["Appointments.Calendar.Card.When"]</dt>
            <dd data-testid="card-when"><time datetime="@card.Day.ToIso()">@card.Day.ToDayHeading(culture)</time>, <span class="tabular-nums">@card.Start.ToShortTime(culture)–@card.End.ToShortTime(culture)</span></dd>
            <dt class="text-sm text-stone-600">@T["Appointments.Calendar.Card.Service"]</dt>
            <dd data-testid="card-service">@card.ServiceName</dd>
            <dt class="text-sm text-stone-600">@T["Appointments.Calendar.Card.Staff"]</dt>
            <dd data-testid="card-staff" class="flex items-center gap-2">
                <span class="size-3 shrink-0 rounded-full" style="background-color: @card.Colour" aria-hidden="true"></span>
                @card.StaffName
            </dd>
            <dt class="text-sm text-stone-600">@T["Appointments.Calendar.Card.Price"]</dt>
            <dd data-testid="card-price" class="tabular-nums">@card.Price.ToDisplayString(culture)</dd>
            @if (card.DepositDue is not null || card.DepositHeld is not null || card.IsActive)
            {
                <dt class="text-sm text-stone-600">@T["Appointments.Calendar.Card.Deposit"]</dt>
                <dd data-testid="card-deposit" class="flex flex-wrap items-center gap-x-3 gap-y-1">
                    @if (card.DepositHeld is { } heldDeposit)
                    {
                        <span class="tabular-nums" data-testid="card-deposit-received">@T.Format("Appointments.Calendar.Card.DepositReceived", heldDeposit.ToDisplayString(culture))</span>
                    }
                    else if (card.DepositDue is { } dueDeposit)
                    {
                        <span class="rounded bg-amber-100 px-1.5 py-0.5 text-sm font-medium text-amber-900 tabular-nums" data-testid="card-deposit-due">@T.Format("Appointments.Calendar.Card.DepositDue", dueDeposit.ToDisplayString(culture))</span>
                    }
                    else
                    {
                        <span class="text-stone-600">@T["Appointments.Calendar.Card.DepositNone"]</span>
                    }
                    <a href="/admin/payments/deposits/@card.Id" data-testid="card-deposit-link" class="inline-flex min-h-11 items-center font-medium underline">@T["Appointments.Calendar.Card.DepositOpen"]</a>
                </dd>
            }
            @if (card.Notes is { Length: > 0 } notes)
            {
                <dt class="text-sm text-stone-600">@T["Appointments.Calendar.Card.Notes"]</dt>
                <dd data-testid="card-notes" class="whitespace-pre-line">@notes</dd>
            }
        </dl>
        @if (card.Status is AppointmentStatus.Arrived or AppointmentStatus.Completed)
        {
            <a href="/admin/payments/checkout/@card.Id" data-testid="card-checkout-link" class="btn btn-compact btn-primary w-full sm:w-auto">@T["Appointments.Calendar.Card.Checkout"]</a>
        }
        @if (card.ClientOwes is { } owes)
        {
            <p class="notice notice-warn" data-testid="card-client-owes">
                @T.Format("Appointments.Calendar.Card.ClientOwes", owes.ToDisplayString(culture))
                <a href="/admin/clients/@card.ClientId" class="font-medium underline">@T["Appointments.Calendar.Card.OpenClient"]</a>
            </p>
        }
        @if (card.Actions.Count > 0)
        {
            <div class="space-y-2 border-t border-stone-200 pt-3">
                <h3 class="text-sm font-medium text-stone-600">@T["Appointments.Calendar.Card.Actions"]</h3>
                <div class="flex flex-wrap gap-2" data-testid="card-actions">
                    @foreach (var action in card.Actions)
                    {
                        <form method="post" action="@(CalendarController.DayListPath)/@card.Id/@action.Segment" asp-antiforgery="true" data-testid="action-@action.Segment">
                            <button type="submit" class="@actionClass">@T[action.LabelKey]</button>
                        </form>
                    }
                </div>
            </div>
        }
    </section>

    @if (card.IsActive)
    {
        <section class="@cardClass" data-testid="move-step">
            <h2 class="text-lg font-semibold">@T["Appointments.Calendar.Move.Title"]</h2>
            <p class="text-sm text-stone-600">@T["Appointments.Calendar.Move.Hint"]</p>
            <form method="get" action="@CalendarController.CardPath(card.Id)" class="space-y-3" data-testid="move-form" data-auto-submit>
                <div class="space-y-1">
                    <label for="staffId" class="field-label">@T["Appointments.Calendar.Move.Staff"]</label>
                    <select id="staffId" name="staffId" data-testid="move-staff" class="@inputClass">
                        @foreach (var person in card.Staff)
                        {
                            <option value="@person.Id" selected="@(person.Id == card.MoveStaffId)">@person.DisplayName</option>
                        }
                    </select>
                </div>
                <div class="space-y-1">
                    <label for="date" class="field-label">@T["Appointments.Calendar.Move.Date"]</label>
                    <input id="date" name="date" type="date" value="@moveDay" min="@card.Today.ToIso()" data-testid="move-date" class="@inputClass" />
                </div>
                <button type="submit" data-testid="move-show-slots" data-auto-submit-fallback class="@secondaryClass w-full sm:w-auto">@T["Appointments.Calendar.Move.ShowSlots"]</button>
            </form>
            <h3 class="text-base font-semibold">@T["Appointments.Calendar.Move.Slots"]</h3>
            @if (card.Slots.Count == 0)
            {
                @* A past day never has free times; saying so beats a puzzled "nothing happened" (owner, 2026-11-20). *@
                <p class="text-sm text-stone-600" data-testid="move-no-slots">@(card.MoveDate < card.Today ? T["Appointments.Calendar.Move.PastDay"] : T["Appointments.Calendar.Move.NoSlots"])</p>
            }
            else
            {
                @* A tap only chooses (ADR 0086, the owner found the one-tap move jumpy); the button below does the move. *@
                <ul class="grid grid-cols-3 gap-2 sm:grid-cols-4" data-testid="move-slot-list">
                    @foreach (var slot in card.Slots)
                    {
                        var chosen = slot.Start == card.Chosen?.Start;
                        <li>
                            <a href="@(CalendarController.CardPath(card.Id, card.MoveStaffId, card.MoveDate))&start=@Uri.EscapeDataString(slot.Start.ToIso())#move-confirm" data-testid="move-slot" aria-current="@(chosen ? "true" : null)" class="slot @(chosen ? "is-chosen" : null)">@slot.LocalStart.ToShortTime(culture)</a>
                        </li>
                    }
                </ul>
                @if (card.Chosen is { } picked)
                {
                    <form method="post" action="@(CalendarController.CalendarPath)/@card.Id/move" asp-antiforgery="true" id="move-confirm" class="sticky bottom-20 flex items-center justify-between gap-3 rounded-xl border border-brand-edge bg-white p-3 shadow-lg lg:bottom-4" data-testid="move-confirm-bar">
                        <input type="hidden" name="staffMemberId" value="@card.MoveStaffId" />
                        <input type="hidden" name="start" value="@picked.Start.ToIso()" />
                        <input type="hidden" name="date" value="@moveDay" />
                        <p class="min-w-0 truncate text-sm text-stone-700">@T.Format("Appointments.Calendar.Move.Chosen", card.MoveDate.ToDayHeading(culture), picked.LocalStart.ToShortTime(culture))</p>
                        <button type="submit" data-testid="move-confirm" class="btn btn-compact btn-primary shrink-0">@T["Appointments.Calendar.Move.Confirm"]</button>
                    </form>
                }
            }
        </section>
    }
</section>
@section Scripts {
    <script type="module" src="~/js/auto-submit.js" asp-append-version="true"></script>
}