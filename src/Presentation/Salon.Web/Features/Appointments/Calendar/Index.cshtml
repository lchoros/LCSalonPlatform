@using System.Globalization
@using NodaTime
@using NodaTime.Text
@using Salon.Core.Appointments
@using Salon.Services.Appointments
@using Salon.Web.Features.Appointments.Calendar
@model CalendarViewModel
@{
    var board = Model.Board;
    var grid = board.Grid;
    var culture = CultureInfo.CurrentCulture;
    var isWeek = board.View == CalendarView.Week;
    var allStaffDay = !isWeek && board.SelectedStaffId is null;
    var step = isWeek ? 7 : 1;
    var isoDay = board.Day.ToIso();
    ViewData["Title"] = T["Appointments.Calendar.Title"];
    const string buttonClass = "btn btn-compact btn-primary";
    const string navClass = "btn btn-compact btn-secondary min-w-11 px-3";
    var rowsStyle = $"grid-template-rows: repeat({grid.RowCount}, 1.25rem)";
}
<section class="space-y-4">
    <partial name="_SectionTabs" model="@AdminSections.Appointments("calendar")" />
    @* The diary's answers float above the page (ADR 0091): a message in the flow would push the grid down under the
       pointer. The drag script puts its refusals here too and clears the answer before it. *@
    <div class="toast-stack" data-testid="toasts" data-dismiss-label="@T["Appointments.Calendar.Drag.Dismiss"]">
        @if (Model.Flash is { } flash)
        {
            <p role="status" data-testid="flash" class="notice notice-ok toast">@flash</p>
        }
    </div>
    @await Component.InvokeAsync("VisitsWithoutOutcome")
    @await Component.InvokeAsync("SetupNote")
    <h1 class="page-title">@T["Appointments.Calendar.Title"]</h1>
    @* One bar (ADR 0092): where you are and the ways to move — today, a step back or forward, any date straight from
       the browser's own calendar — then whose diary, how much of it (a day or a week) and the one thing to do: book.
       The day list and the waiting list are the tabs above, not buttons here. The date and the person are one plain
       GET form; with script a change submits it (auto-submit.js), without, its button does. *@
    <div class="cal-bar" data-testid="calendar-bar">
        <nav aria-label="@T["Appointments.Calendar.Title"]" class="cal-bar-nav">
            <a href="@CalendarController.TodayPath(board.View, board.SelectedStaffId)" data-testid="today" class="@navClass">@T["Appointments.Calendar.Today"]</a>
            <a href="@CalendarController.Path(board.View, board.Day.PlusDays(-step), board.SelectedStaffId)" data-testid="prev" class="cal-arrow" aria-label="@T["Appointments.Calendar.Previous"]">&lsaquo;</a>
            <a href="@CalendarController.Path(board.View, board.Day.PlusDays(step), board.SelectedStaffId)" data-testid="next" class="cal-arrow" aria-label="@T["Appointments.Calendar.Next"]">&rsaquo;</a>
            @if (isWeek)
            {
                <span data-testid="range" class="cal-range">
                    <time datetime="@board.From.ToIso()">@board.From.ToString("d MMM", culture)</time>
                    &ndash; <time datetime="@board.To.ToIso()">@board.To.ToString("d MMM yyyy", culture)</time>
                </span>
            }
            else
            {
                <time datetime="@isoDay" data-testid="range" class="cal-range">@board.Day.ToDayHeading(culture)</time>
            }
        </nav>
        <form method="get" action="@CalendarController.CalendarPath" class="cal-bar-pick" data-testid="staff-filter" data-auto-submit>
            <input type="hidden" name="view" value="@CalendarController.ViewSegment(board.View)" />
            <label for="jump" class="sr-only">@T["Appointments.Calendar.GoToDate"]</label>
            <input id="jump" type="date" name="date" value="@isoDay" required class="field field-compact cal-date" data-testid="jump-date" />
            @if (board.Staff.Count > 0)
            {
                <label for="staff" class="sr-only">@T["Appointments.Calendar.StaffFilter"]</label>
                <select id="staff" name="staff" class="field field-compact" data-testid="staff-select">
                    @if (!isWeek)
                    {
                        <option value="" selected="@allStaffDay">@T["Appointments.Calendar.All"]</option>
                    }
                    @foreach (var person in board.Staff)
                    {
                        <option value="@person.Id" selected="@(person.Id == board.SelectedStaffId)">@person.DisplayName</option>
                    }
                </select>
            }
            <button type="submit" class="btn btn-compact btn-secondary" data-testid="staff-filter-submit" data-auto-submit-fallback>@T["Appointments.Calendar.ShowStaff"]</button>
        </form>
        @await Component.InvokeAsync("WaitlistLink", new { onlyWhenWaiting = true })
        <nav aria-label="@T["Appointments.Calendar.ViewSwitch"]" class="cal-switch" data-testid="view-switch">
            <a href="@CalendarController.Path(CalendarView.Day, board.Day, board.SelectedStaffId)" data-testid="view-day" aria-current="@(isWeek ? null : "page")">@T["Appointments.Calendar.Day"]</a>
            <a href="@CalendarController.Path(CalendarView.Week, board.Day, board.SelectedStaffId)" data-testid="view-week" aria-current="@(isWeek ? "page" : null)">@T["Appointments.Calendar.Week"]</a>
        </nav>
        <a href="@(CalendarController.DayListPath)/new?date=@isoDay@(board.SelectedStaffId is { } bookStaff ? $"&staffId={bookStaff}" : string.Empty)" data-testid="book" class="@buttonClass">@T["Appointments.Calendar.Book"]</a>
    </div>

    @if (board.Staff.Count == 0)
    {
        <p data-testid="empty-state" class="empty-state">@T["Appointments.Calendar.NoStaff"]</p>
    }
    else
    {
        @* The timetable. Week view scrolls sideways inside this box only; the day view with every person is replaced by a list on a phone. *@
        <div data-testid="calendar-grid" data-view="@CalendarController.ViewSegment(board.View)" data-drop-path="@CalendarController.CalendarPath" data-refused="@T["Appointments.Calendar.Drag.Refused"]" class="cal @(isWeek ? "overflow-x-auto" : string.Empty) @(allStaffDay ? "hidden sm:block" : string.Empty)">
            <div class="flex @(isWeek ? "min-w-[42rem]" : string.Empty)">
                <div class="cal-gutter" aria-hidden="true">
                    <div class="cal-corner"></div>
                    <div class="grid" style="@rowsStyle">
                        @for (var row = 1; row <= grid.RowCount; row++)
                        {
                            var minute = CalendarLayout.MinuteOfRow(grid, row);
                            if (minute % 60 == 0)
                            {
                                <div class="relative" style="grid-row: @row">
                                    <span class="cal-hour">@LocalTime.FromMinutesSinceMidnight(minute).ToShortTime(culture)</span>
                                </div>
                            }
                        }
                    </div>
                </div>
                <div class="grid min-w-0 flex-1" style="grid-template-columns: repeat(@board.Columns.Count, minmax(0, 1fr))">
                    @foreach (var column in board.Columns)
                    {
                        <div class="cal-col" data-testid="calendar-column" data-staff-id="@column.Staff.Id" data-date="@column.Date.ToIso()">
                            <div class="cal-head">
                                @if (isWeek)
                                {
                                    <a href="@CalendarController.Path(CalendarView.Day, column.Date, column.Staff.Id)" class="cal-day" aria-current="@(column.Date == board.Day ? "date" : null)">
                                        <time datetime="@column.Date.ToIso()">@column.Date.ToString("ddd d MMM", culture)</time>
                                    </a>
                                }
                                else
                                {
                                    <span class="size-3 shrink-0 rounded-full" style="background-color: @column.Staff.Colour" aria-hidden="true"></span>
                                    <a href="@CalendarController.Path(CalendarView.Day, column.Date, column.Staff.Id)" class="cal-person" data-testid="column-staff">@column.Staff.DisplayName</a>
                                }
                            </div>
                            <div class="grid" style="@rowsStyle">
                                @for (var row = 1; row <= grid.RowCount; row++)
                                {
                                    var minute = CalendarLayout.MinuteOfRow(grid, row);
                                    var working = CalendarLayout.IsWorking(column.WorkingRanges, minute);
                                    <div class="cal-cell @(minute % 60 == 0 ? "is-hour" : null) @(working ? null : "is-off")" style="grid-row: @row" data-row="@row" data-minute="@minute" data-working="@(working ? "true" : "false")" aria-hidden="true"></div>
                                }
                                @foreach (var block in column.Blocks)
                                {
                                    <a href="@CalendarController.CardPath(block.Id)"
                                       data-testid="calendar-block"
                                       data-appointment-id="@block.Id"
                                       data-staff-id="@column.Staff.Id"
                                       data-status="@block.Status"
                                       class="cal-block"
                                       style="@CalendarBlockStyle.For(block)"
                                       title="@block.Start.ToShortTime(culture)–@block.End.ToShortTime(culture) @block.ClientFirstName · @block.ServiceName">
                                        @* The block only shows what its height can hold (the owner's bug report, 2026-11-20): one line
                                           when it spans a single row, the service on the second, the badge from the third; the title
                                           attribute and the card behind the tap always carry the whole story. *@
                                        <span class="truncate"><span class="font-semibold tabular-nums">@block.Start.ToShortTime(culture)</span> @block.ClientFirstName@(block.Span <= 1 ? $" · {block.ServiceName}" : string.Empty)</span>
                                        @if (block.Span >= 2)
                                        {
                                            <span class="truncate">@block.ServiceName</span>
                                        }
                                        @if (block.Span >= 3)
                                        {
                                            <span class="cal-badge" data-testid="status-badge">@T[$"Appointments.Status.{block.Status}"]</span>
                                        }
                                    </a>
                                }
                                @foreach (var kept in column.Kept)
                                {
                                    <a href="@CalendarController.DayListDayPath(column.Date)"
                                       data-testid="calendar-kept"
                                       data-offer-id="@kept.OfferId"
                                       data-staff-id="@column.Staff.Id"
                                       class="cal-kept"
                                       style="@CalendarBlockStyle.For(kept)"
                                       title="@kept.Start.ToShortTime(culture)–@kept.End.ToShortTime(culture) @T.Format("Appointments.Calendar.Kept", kept.ClientFirstName) · @kept.ServiceName">
                                        <span class="truncate"><span class="font-semibold tabular-nums">@kept.Start.ToShortTime(culture)</span> @T.Format("Appointments.Calendar.Kept", kept.ClientFirstName)</span>
                                        <span class="truncate">@kept.ServiceName</span>
                                        <span class="cal-badge">@T["Appointments.Day.Kept.Badge"]</span>
                                    </a>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        @if (allStaffDay)
        {
            <div class="space-y-4 sm:hidden" data-testid="calendar-list">
                @foreach (var column in board.Columns)
                {
                    <section class="space-y-3 panel" data-testid="calendar-list-staff" data-staff-id="@column.Staff.Id">
                        <h2 class="flex items-center gap-2 text-lg font-semibold">
                            <span class="size-3 shrink-0 rounded-full" style="background-color: @column.Staff.Colour" aria-hidden="true"></span>
                            <a href="@CalendarController.Path(CalendarView.Day, column.Date, column.Staff.Id)" class="hover:underline">@column.Staff.DisplayName</a>
                        </h2>
                        @if (column.Kept.Count > 0)
                        {
                            <ul class="space-y-2">
                                @foreach (var kept in column.Kept)
                                {
                                    <li>
                                        <a href="@CalendarController.DayListDayPath(column.Date)" data-testid="calendar-list-kept" class="flex min-h-11 items-center gap-3 rounded-lg border border-dashed border-amber-400 bg-amber-50 px-2 py-2">
                                            <span class="w-24 shrink-0 font-semibold tabular-nums">@kept.Start.ToShortTime(culture)–@kept.End.ToShortTime(culture)</span>
                                            <span class="min-w-0 flex-1">
                                                <span class="block truncate">@T.Format("Appointments.Calendar.Kept", kept.ClientFirstName)</span>
                                                <span class="block truncate text-sm text-stone-600">@kept.ServiceName</span>
                                            </span>
                                            <span class="rounded px-1.5 py-0.5 text-xs font-medium @Badges.KeptTime">@T["Appointments.Day.Kept.Badge"]</span>
                                        </a>
                                    </li>
                                }
                            </ul>
                        }
                        @if (column.Blocks.Count == 0)
                        {
                            <p class="text-sm italic text-stone-500">@T["Appointments.Calendar.Empty"]</p>
                        }
                        else
                        {
                            <ul class="divide-y divide-stone-200">
                                @foreach (var block in column.Blocks)
                                {
                                    <li>
                                        <a href="@CalendarController.CardPath(block.Id)" data-testid="calendar-list-item" data-status="@block.Status" class="flex min-h-11 items-center gap-3 py-2">
                                            <span class="w-24 shrink-0 font-semibold tabular-nums">@block.Start.ToShortTime(culture)–@block.End.ToShortTime(culture)</span>
                                            <span class="min-w-0 flex-1">
                                                <span class="block truncate">@block.ClientFirstName</span>
                                                <span class="block truncate text-sm text-stone-600">@block.ServiceName</span>
                                            </span>
                                            <span class="rounded px-1.5 py-0.5 text-xs font-medium @Badges.AppointmentInList(block.Status)">@T[$"Appointments.Status.{block.Status}"]</span>
                                        </a>
                                    </li>
                                }
                            </ul>
                        }
                    </section>
                }
            </div>
        }
    }
    @* The one script of this page (ADR 0086): dragging a visit proposes a move; the server decides. *@
    <form id="calendar-drop-token" class="hidden" aria-hidden="true">@Html.AntiForgeryToken()</form>
</section>
@section Scripts {
    <script type="module" src="~/js/calendar-drag.js" asp-append-version="true"></script>
    <script type="module" src="~/js/auto-submit.js" asp-append-version="true"></script>
}
