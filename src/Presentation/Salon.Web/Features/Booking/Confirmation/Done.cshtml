@using System.Globalization
@using Salon.Web.Features.Booking.Confirmation
@model ConfirmationViewModel
@{
    var a = Model.Appointment;
    var culture = CultureInfo.CurrentCulture;
    var local = a.Start.InZone(Model.Zone).LocalDateTime;
    ViewData["Title"] = T["Booking.Public.Done.Title"];
}
<section class="mx-auto max-w-lg space-y-6">
    <header class="space-y-3">
        <span class="inline-flex size-12 items-center justify-center rounded-full bg-green-100 text-green-800" aria-hidden="true">
            <svg class="size-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg>
        </span>
        <h1 class="text-2xl font-bold tracking-tight sm:text-3xl" data-testid="done-title">@T["Booking.Public.Done.Title"]</h1>
        <p class="text-stone-700">@T["Booking.Public.Done.Lead"]</p>
    </header>

    <dl class="facts" data-testid="booking-details">
        <dt>@T["Booking.Public.Done.Service"]</dt>
        <dd data-testid="done-service">@a.ServiceName</dd>
        <dt>@T["Booking.Public.Done.Staff"]</dt>
        <dd data-testid="done-staff">@a.StaffName</dd>
        <dt>@T["Booking.Public.Done.When"]</dt>
        <dd class="tabular-nums" data-testid="done-when">@local.ToString("dddd, d MMMM yyyy", culture), @local.ToString("HH:mm", culture)</dd>
        <dt>@T["Booking.Public.Done.Price"]</dt>
        <dd class="tabular-nums" data-testid="done-price">@a.Price.ToDisplayString(culture)</dd>
        @if (a.Deposit is { } depositDue)
        {
            <dt>@T["Booking.Public.Done.Deposit"]</dt>
            <dd data-testid="done-deposit"><span class="tabular-nums">@depositDue.ToDisplayString(culture)</span> <span class="block text-sm text-stone-600">@T["Booking.Public.Deposit.Note"]</span></dd>
        }
        <dt>@T["Booking.Public.Done.Where"]</dt>
        <dd data-testid="done-salon">@Model.SalonName</dd>
    </dl>

    @await Component.InvokeAsync("SalonContact")

    <div class="flex flex-col gap-3">
        <a href="/book" data-testid="book-another" class="btn btn-primary w-full">@T["Booking.Public.Done.BookAnother"]</a>
        <a href="/book/change/@Uri.EscapeDataString(a.PublicToken)" data-testid="change-link" class="btn btn-secondary w-full">@T["Booking.Public.Change.Title"]</a>
        <a href="@Model.CancelPath" data-testid="cancel-link" class="btn btn-secondary w-full">@T["Booking.Public.Done.Cancel"]</a>
    </div>
</section>
