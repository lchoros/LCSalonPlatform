@using System.Globalization
@using Salon.Web.Features.Booking.EnterDetails
@model EnterDetailsViewModel
@{
    var s = Model.Summary;
    var culture = CultureInfo.CurrentCulture;
    var local = s.Start.InZone(s.Zone).LocalDateTime;
    ViewData["Title"] = T["Booking.Public.YourDetails"];
}
@functions {
    string Invalid(string field) => ViewData.ModelState[field]?.Errors.Count > 0 ? "input-validation-error" : string.Empty;
}
<section class="mx-auto max-w-lg space-y-6">
    <header class="space-y-3">
        <p class="text-sm font-medium text-stone-600" data-testid="step">@T.Format("Booking.Public.Step", 3, 3)</p>
        <div class="steps">
            <span class="is-done"></span>
            <span class="is-done"></span>
            <span class="is-done"></span>
        </div>
        <h1 class="text-2xl font-bold tracking-tight sm:text-3xl">@T["Booking.Public.YourDetails"]</h1>
    </header>

    @* What was chosen, compact: the link wraps under the facts when the phone is too narrow for both side by side. *@
    <div class="summary-bar flex-wrap items-start" data-testid="summary">
        <dl class="min-w-0 flex-1 basis-56 space-y-1 text-sm">
            <div>
                <dt class="sr-only">@T["Booking.Public.Done.Service"]</dt>
                <dd data-testid="summary-service"><span class="block text-base font-semibold">@s.ServiceName</span><span class="text-stone-600">@T.Format("Booking.Public.DurationMinutes", (int)s.Duration.TotalMinutes) · <span class="tabular-nums">@(s.PriceIsFrom ? T.Format("Booking.ListServices.FromPrice", s.Price.ToDisplayString(culture)) : s.Price.ToDisplayString(culture))</span></span></dd>
            </div>
            <div class="flex gap-2">
                <dt class="text-stone-600">@T["Booking.Public.Done.When"]</dt>
                <dd class="font-medium tabular-nums" data-testid="summary-when">@local.ToString("dddd, d MMMM", culture), @local.ToString("HH:mm", culture)</dd>
            </div>
            <div class="flex gap-2">
                <dt class="text-stone-600">@T["Booking.Public.Done.Staff"]</dt>
                <dd class="font-medium" data-testid="summary-staff">@(s.StaffName ?? T["Booking.Public.Anyone"])</dd>
            </div>
        </dl>
        <a href="/book/@Model.Form.ServiceId" class="btn-link ml-auto">@T["Booking.Public.ChangeTime"]</a>
    </div>

    @if (s.Deposit is { } depositDue)
    {
        <p class="notice border-stone-200 bg-white text-stone-700" data-testid="deposit-terms">@T.Format(s.PriceIsFrom ? "Booking.Public.Deposit.DueFrom" : "Booking.Public.Deposit.Due", depositDue.ToDisplayString(culture))</p>
    }

    @if (s.Policy.FreeChangeHours > 0 || s.Policy.NoShowFeePercent > 0m)
    {
        <div class="notice border-stone-200 bg-white text-stone-700" data-testid="cancellation-terms">
            <p class="font-medium text-stone-900">@T["Booking.Public.Terms.Title"]</p>
            <ul class="mt-1 list-disc space-y-1 pl-5">
                @if (s.Policy.FreeChangeHours > 0)
                {
                    <li data-testid="terms-free">@T.Format("Booking.Public.Terms.FreeUntil", s.Policy.FreeChangeHours)</li>
                    @if (s.Policy.LateCancellationFeePercent > 0m)
                    {
                        <li data-testid="terms-late">@T.Format("Booking.Public.Terms.LateFee", s.Policy.LateCancellationFeePercent.ToString("0.##", culture))</li>
                    }
                }
                @if (s.Policy.NoShowFeePercent > 0m)
                {
                    <li data-testid="terms-no-show">@T.Format("Booking.Public.Terms.NoShowFee", s.Policy.NoShowFeePercent.ToString("0.##", culture))</li>
                }
            </ul>
        </div>
    }

    @if (Model.SlotTaken)
    {
        <p role="alert" data-testid="slot-taken" class="notice notice-warn">
            @T["Booking.Public.SlotTaken"] <a href="/book/@Model.Form.ServiceId" class="font-medium underline underline-offset-4">@T["Booking.Public.Verify.PickAnother"]</a>
        </p>
    }

    @if (Model.PrefilledFor is { } who)
    {
        <p data-testid="prefilled" class="notice notice-ok flex flex-wrap items-center justify-between gap-2">
            <span>@T.Format("Booking.Public.Prefilled", who)</span>
            <a href="/book/@Model.Form.ServiceId/details?start=@Uri.EscapeDataString(Model.Form.Start ?? string.Empty)@(Model.Form.StaffMemberId is { } sid ? $"&staff={sid}" : string.Empty)&forget=true" data-testid="not-you" class="font-medium underline underline-offset-4">@T["Booking.Public.NotYou"]</a>
        </p>
    }

    <form method="post" asp-action="Details" class="space-y-5" novalidate data-testid="details-form">
        <div asp-validation-summary="ModelOnly" class="notice notice-error" role="alert"></div>
        @* Plain field names (no "Form." prefix): the command binds them and the pipeline's failures are keyed the same way. *@
        <input type="hidden" name="Start" value="@Model.Form.Start" />
        <input type="hidden" name="StaffMemberId" value="@Model.Form.StaffMemberId" />

        <div class="grid gap-5 sm:grid-cols-2">
            <div class="space-y-1.5">
                <label for="FirstName" class="field-label">@T["Booking.Public.FirstName"]</label>
                <input id="FirstName" name="FirstName" value="@Model.Form.FirstName" type="text" maxlength="100" autocomplete="given-name" autocapitalize="words" aria-describedby="first-name-error" class="field @Invalid("FirstName")" />
                @Html.ValidationMessage("FirstName", null, new { id = "first-name-error", @class = "field-error" })
            </div>
            <div class="space-y-1.5">
                <label for="LastName" class="field-label">@T["Booking.Public.LastName"]</label>
                <input id="LastName" name="LastName" value="@Model.Form.LastName" type="text" maxlength="100" autocomplete="family-name" autocapitalize="words" aria-describedby="last-name-error" class="field @Invalid("LastName")" />
                @Html.ValidationMessage("LastName", null, new { id = "last-name-error", @class = "field-error" })
            </div>
        </div>

        <div class="space-y-1.5">
            <label for="Phone" class="field-label">@T["Booking.Public.Phone"]</label>
            <input id="Phone" name="Phone" value="@Model.Form.Phone" type="tel" inputmode="tel" maxlength="30" autocomplete="tel" aria-describedby="phone-hint phone-error" class="field tabular-nums @Invalid("Phone")" />
            @if (s.RequireSmsVerification)
            {
                <p id="phone-hint" class="field-hint">@T["Booking.Public.PhoneHint"]</p>
            }
            @Html.ValidationMessage("Phone", null, new { id = "phone-error", @class = "field-error" })
        </div>

        <div class="space-y-1.5">
            <label for="Email" class="field-label">@T["Booking.Public.Email"]</label>
            <input id="Email" name="Email" value="@Model.Form.Email" type="email" inputmode="email" maxlength="254" autocomplete="email" autocapitalize="none" spellcheck="false" aria-describedby="email-error" class="field @Invalid("Email")" />
            @Html.ValidationMessage("Email", null, new { id = "email-error", @class = "field-error" })
        </div>

        <label class="flex min-h-12 cursor-pointer items-start gap-3 rounded-xl border border-stone-300 bg-white p-3">
            <input id="MarketingConsent" name="MarketingConsent" type="checkbox" value="true" checked="@Model.Form.MarketingConsent" data-testid="marketing-consent" class="mt-0.5 size-5 shrink-0 rounded border-stone-300 accent-stone-900" />
            <span class="text-sm text-stone-700" data-testid="consent-wording">@s.ConsentWording</span>
        </label>

        <button type="submit" data-testid="submit-details" class="btn btn-primary w-full">
            @(s.RequireSmsVerification ? T["Booking.Public.SendCode"] : T["Booking.Public.Book"])
        </button>
    </form>
    @await Component.InvokeAsync("SalonContact")
</section>
