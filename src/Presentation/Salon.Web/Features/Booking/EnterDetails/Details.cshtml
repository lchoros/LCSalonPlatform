@using System.Globalization
@using Salon.Web.Features.Booking.EnterDetails
@model EnterDetailsViewModel
@{
    var s = Model.Summary;
    var culture = CultureInfo.CurrentCulture;
    var local = s.Start.InZone(s.Zone).LocalDateTime;
    ViewData["Title"] = T["Booking.Public.YourDetails"];
    const string inputClass = "block w-full min-h-11 rounded-md border border-stone-300 px-3 py-2 text-base shadow-sm focus:border-stone-900 focus:outline-none focus:ring-1 focus:ring-stone-900";
}
@functions {
    string Invalid(string field) => ViewData.ModelState[field]?.Errors.Count > 0 ? "input-validation-error border-red-500" : string.Empty;
}
<section class="mx-auto max-w-lg space-y-6">
    <header class="space-y-1">
        <p class="text-sm font-medium uppercase tracking-wide text-stone-500" data-testid="step">@T.Format("Booking.Public.Step", 3, 3)</p>
        <h1 class="text-2xl font-bold tracking-tight sm:text-3xl">@T["Booking.Public.YourDetails"]</h1>
    </header>

    <dl class="grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 rounded-lg border border-stone-200 bg-white p-4 text-sm shadow-sm" data-testid="summary">
        <dt class="text-stone-500">@T["Booking.Public.Done.Service"]</dt>
        <dd class="font-medium" data-testid="summary-service">@s.ServiceName · @T.Format("Booking.Public.DurationMinutes", (int)s.Duration.TotalMinutes) · <span class="tabular-nums">@s.Price.ToDisplayString(culture)</span></dd>
        <dt class="text-stone-500">@T["Booking.Public.Done.Staff"]</dt>
        <dd class="font-medium" data-testid="summary-staff">@(s.StaffName ?? T["Booking.Public.Anyone"])</dd>
        <dt class="text-stone-500">@T["Booking.Public.Done.When"]</dt>
        <dd class="font-medium tabular-nums" data-testid="summary-when">@local.ToString("dddd, d MMMM", culture), @local.ToString("HH:mm", culture)</dd>
        <dd class="col-span-2 pt-1"><a href="/book/@Model.Form.ServiceId" class="text-sm underline hover:text-stone-900">@T["Booking.Public.ChangeTime"]</a></dd>
    </dl>

    @if (Model.SlotTaken)
    {
        <p role="alert" data-testid="slot-taken" class="rounded-md border border-amber-300 bg-amber-50 p-3 text-sm text-amber-900">
            @T["Booking.Public.SlotTaken"] <a href="/book/@Model.Form.ServiceId" class="font-medium underline">@T["Booking.Public.Verify.PickAnother"]</a>
        </p>
    }

    <form method="post" asp-action="Details" class="space-y-5" novalidate data-testid="details-form">
        <div asp-validation-summary="ModelOnly" class="rounded-md border border-red-200 bg-red-50 p-3 text-sm text-red-700" role="alert"></div>
        @* Plain field names (no "Form." prefix): the command binds them and the pipeline's failures are keyed the same way. *@
        <input type="hidden" name="Start" value="@Model.Form.Start" />
        <input type="hidden" name="StaffMemberId" value="@Model.Form.StaffMemberId" />

        <div class="grid gap-5 sm:grid-cols-2">
            <div class="space-y-1">
                <label for="FirstName" class="block text-sm font-medium">@T["Booking.Public.FirstName"]</label>
                <input id="FirstName" name="FirstName" value="@Model.Form.FirstName" type="text" maxlength="100" autocomplete="given-name" aria-describedby="first-name-error" class="@inputClass @Invalid("FirstName")" />
                @Html.ValidationMessage("FirstName", null, new { id = "first-name-error", @class = "block text-sm text-red-700" })
            </div>
            <div class="space-y-1">
                <label for="LastName" class="block text-sm font-medium">@T["Booking.Public.LastName"]</label>
                <input id="LastName" name="LastName" value="@Model.Form.LastName" type="text" maxlength="100" autocomplete="family-name" aria-describedby="last-name-error" class="@inputClass @Invalid("LastName")" />
                @Html.ValidationMessage("LastName", null, new { id = "last-name-error", @class = "block text-sm text-red-700" })
            </div>
        </div>

        <div class="space-y-1">
            <label for="Phone" class="block text-sm font-medium">@T["Booking.Public.Phone"]</label>
            <input id="Phone" name="Phone" value="@Model.Form.Phone" type="tel" inputmode="tel" maxlength="30" autocomplete="tel" aria-describedby="phone-hint phone-error" class="@inputClass @Invalid("Phone")" />
            @if (s.RequireSmsVerification)
            {
                <p id="phone-hint" class="text-sm text-stone-500">@T["Booking.Public.PhoneHint"]</p>
            }
            @Html.ValidationMessage("Phone", null, new { id = "phone-error", @class = "block text-sm text-red-700" })
        </div>

        <div class="space-y-1">
            <label for="Email" class="block text-sm font-medium">@T["Booking.Public.Email"]</label>
            <input id="Email" name="Email" value="@Model.Form.Email" type="email" inputmode="email" maxlength="254" autocomplete="email" spellcheck="false" aria-describedby="email-error" class="@inputClass @Invalid("Email")" />
            @Html.ValidationMessage("Email", null, new { id = "email-error", @class = "block text-sm text-red-700" })
        </div>

        <label class="flex items-start gap-3 rounded-md border border-stone-300 p-3">
            <input id="MarketingConsent" name="MarketingConsent" type="checkbox" value="true" checked="@Model.Form.MarketingConsent" data-testid="marketing-consent" class="mt-1 size-5 shrink-0 rounded border-stone-300" />
            <span class="text-sm" data-testid="consent-wording">@s.ConsentWording</span>
        </label>

        <button type="submit" data-testid="submit-details" class="inline-flex min-h-12 w-full items-center justify-center rounded-md bg-stone-900 px-4 py-2 text-base font-medium text-white hover:bg-stone-700">
            @(s.RequireSmsVerification ? T["Booking.Public.SendCode"] : T["Booking.Public.Book"])
        </button>
    </form>
</section>
