@using System.Globalization
@using Salon.Web.Features.Booking.TakeHeldTime
@model TakeHeldTimeViewModel
@{
    var culture = CultureInfo.CurrentCulture;
    ViewData["Title"] = T["Booking.Held.Title"];
}
<section class="mx-auto max-w-lg space-y-6">
    <h1 class="text-2xl font-bold tracking-tight sm:text-3xl">@T[Model.State == HeldTimeState.Booked ? "Booking.Held.Booked.Title" : "Booking.Held.Title"]</h1>

    @if (Model.Time is { } time && Model.State is HeldTimeState.Held or HeldTimeState.Booked)
    {
        var local = time.Start.LocalDateTime;
        <dl class="facts" data-testid="held-details">
            <dt>@T["Booking.Public.Done.Service"]</dt>
            <dd>@time.ServiceName</dd>
            <dt>@T["Booking.Public.Done.Staff"]</dt>
            <dd>@time.StaffName</dd>
            <dt>@T["Booking.Public.Done.When"]</dt>
            <dd class="tabular-nums" data-testid="held-when">@local.ToString("dddd, d MMMM yyyy", culture), @local.ToString("HH:mm", culture)</dd>
            <dt>@T["Booking.Held.Price"]</dt>
            <dd class="tabular-nums" data-testid="held-price">@time.Price.ToDisplayString(culture)</dd>
            <dt>@T["Booking.Public.Done.Where"]</dt>
            <dd>@Model.SalonName</dd>
        </dl>
    }

    @switch (Model.State)
    {
        case HeldTimeState.Held:
            <p role="status" data-testid="held-until" class="notice notice-ok">@T.Format("Booking.Held.Until", Model.Time!.ClientFirstName, Model.Time.HeldUntil.TimeOfDay.ToShortTime(culture))</p>
            <form method="post" action="@Model.TakePath" asp-antiforgery="true" class="flex flex-col gap-3" data-testid="take-form">
                <button type="submit" data-testid="take-time" class="btn btn-primary w-full">@T["Booking.Held.Take"]</button>
                <a href="@Model.OtherTimesPath" data-testid="other-times" class="btn btn-secondary w-full">@T["Booking.Held.OtherTimes"]</a>
            </form>
            <p class="text-sm text-stone-600">@T["Booking.Held.NoNeed"]</p>
            break;
        case HeldTimeState.Booked:
            <p role="status" data-testid="held-result" class="notice notice-ok">@T["Booking.Held.Booked"]</p>
            @if (Model.VisitPath is { } visitPath)
            {
                <a href="@visitPath" data-testid="manage-visit" class="btn btn-secondary w-full">@T["Booking.Held.Manage"]</a>
            }
            break;
        case HeldTimeState.Over:
            <p role="status" data-testid="held-result" class="notice notice-warn">@T["Booking.Held.Over"]</p>
            <a href="@Model.OtherTimesPath" data-testid="other-times" class="btn btn-primary w-full">@T["Booking.Held.OtherTimes"]</a>
            break;
        case HeldTimeState.Gone:
            <p role="status" data-testid="held-result" class="notice notice-warn">@T["Booking.Held.Gone"]</p>
            <a href="@Model.OtherTimesPath" data-testid="other-times" class="btn btn-primary w-full">@T["Booking.Held.OtherTimes"]</a>
            break;
        default:
            <p role="status" data-testid="held-result" class="notice notice-warn">@T["Booking.Held.Invalid"]</p>
            <a href="@Model.OtherTimesPath" data-testid="other-times" class="btn btn-primary w-full">@T["Booking.Held.OtherTimes"]</a>
            break;
    }
    @await Component.InvokeAsync("SalonContact")
</section>