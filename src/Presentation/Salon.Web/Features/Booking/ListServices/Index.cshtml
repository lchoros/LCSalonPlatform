@using System.Globalization
@using Salon.Web.Features.Booking.ListServices
@model ListServicesViewModel
@{
    ViewData["Title"] = T["Booking.ListServices.Title"];
}
<section class="space-y-6">
    @if (Model.Flash is { } flash)
    {
        <p role="status" data-testid="flash" class="rounded-md border border-green-200 bg-green-50 p-3 text-sm text-green-800">@flash</p>
    }
    <header class="space-y-1">
        <h1 class="text-2xl font-bold tracking-tight sm:text-3xl" data-testid="salon-name">@Model.SalonName</h1>
        <p class="text-stone-600">@T["Booking.ListServices.Subtitle"]</p>
    </header>
    @if (Model.Services.Count == 0)
    {
        <p data-testid="empty-state" class="rounded-md border border-dashed border-stone-300 p-6 text-center text-stone-600">@T["Booking.ListServices.Empty"]</p>
    }
    else
    {
        <ul class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3" data-testid="service-list">
            @foreach (var service in Model.Services)
            {
                <li class="flex min-h-11 flex-col gap-1 rounded-lg border border-stone-200 bg-white p-4 shadow-sm" data-testid="service-card">
                    <div class="flex items-start justify-between gap-3">
                        <h2 class="text-lg font-semibold leading-snug">@service.Name</h2>
                        <span class="shrink-0 font-semibold tabular-nums" data-testid="service-price">@service.Price.ToDisplayString(CultureInfo.CurrentCulture)</span>
                    </div>
                    @if (service.Description is { } description)
                    {
                        <p class="text-sm text-stone-600">@description</p>
                    }
                    <p class="text-sm text-stone-500" data-testid="service-duration">@T.Format("Booking.ListServices.DurationMinutes", (int)service.Duration.TotalMinutes)</p>
                </li>
            }
        </ul>
    }
</section>
