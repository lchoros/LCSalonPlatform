@using System.Globalization
@using NodaTime
@using NodaTime.Text
@using Salon.Web.Features.Booking.ChooseSlot
@model ChooseSlotViewModel
@{
    var r = Model.Result;
    var culture = CultureInfo.CurrentCulture;
    ViewData["Title"] = T["Booking.Public.ChooseTime"];
    var staffQuery = r.SelectedStaffId is { } sid ? $"&staff={sid}" : string.Empty;
    var hasAnySlot = r.Days.Any(d => d.HasSlots);
}
<section class="mx-auto max-w-2xl space-y-6">
    <header class="space-y-3">
        <p class="text-sm font-medium text-stone-600" data-testid="step">@T.Format("Booking.Public.Step", 2, 3)</p>
        <ol class="steps">
            <li class="is-done"><span class="steps-bar"></span>@T["Booking.Public.StepService"]</li>
            <li class="is-done"><span class="steps-bar"></span>@T["Booking.Public.StepTime"]</li>
            <li><span class="steps-bar"></span>@T["Booking.Public.StepDetails"]</li>
        </ol>
        <h1 class="text-2xl font-bold tracking-tight sm:text-3xl">@T["Booking.Public.ChooseTime"]</h1>
    </header>

    <div class="summary-bar">
        <div class="min-w-0">
            <p class="truncate font-semibold" data-testid="service-name">@r.ServiceName</p>
            <p class="text-sm text-stone-600">@T.Format("Booking.Public.DurationMinutes", (int)r.Duration.TotalMinutes) · <span class="tabular-nums">@(r.PriceIsFrom ? T.Format("Booking.ListServices.FromPrice", r.Price.ToDisplayString(culture)) : r.Price.ToDisplayString(culture))</span></p>
        </div>
        <a href="/book" class="btn-link">@T["Booking.Public.ChangeService"]</a>
    </div>

    @if (r.Staff.Count > 1)
    {
        <nav aria-label="@T["Booking.Public.With"]" data-testid="staff-picker" class="scroll-row">
            <a href="/book/@r.ServiceId?date=@r.SelectedDate.ToIso()" class="pill @Badges.DayTile(r.SelectedStaffId is null, true)" aria-current="@(r.SelectedStaffId is null ? "true" : null)" data-testid="staff-any">@T["Booking.Public.Anyone"]</a>
            @foreach (var person in r.Staff)
            {
                var on = person.Id == r.SelectedStaffId;
                <a href="/book/@r.ServiceId?date=@r.SelectedDate.ToIso()&staff=@person.Id" class="pill gap-2 pl-2 @Badges.DayTile(on, true)" aria-current="@(on ? "true" : null)" data-testid="staff-option"><avatar name="@person.DisplayName" photo="@person.PhotoPath" size="Small" />@person.DisplayName</a>
            }
        </nav>
    }

    @{ var windowStart = (r.Days.Count > 0 ? r.Days[0].Date : r.SelectedDate).ToIso(); }
    @* The two arrows always hold their places (the owner, 2026-11-20): where there is nothing earlier or later the
       arrow is drawn faint and is not a link, so the strip between them never shifts. Every link comes back to this
       bar (#days), so changing the day or the week does not throw the page to its top. *@
    <div id="days" class="day-bar">
        @if (r.EarlierFrom is { } earlier)
        {
            <a href="/book/@r.ServiceId?from=@earlier.ToIso()@staffQuery#days" class="strip-arrow" data-testid="earlier-days" aria-label="@T["Booking.Public.EarlierDays"]"><svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M15 6l-6 6 6 6" /></svg></a>
        }
        else
        {
            <span class="strip-arrow is-off" data-testid="earlier-days-off" aria-hidden="true"><svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M15 6l-6 6 6 6" /></svg></span>
        }
        <nav aria-label="@T["Booking.Public.Day"]" data-testid="date-strip" class="scroll-row mx-0 min-w-0 flex-1 px-0 scroll-px-0">
            @foreach (var day in r.Days)
            {
                var on = day.Date == r.SelectedDate;
                <a href="/book/@r.ServiceId?date=@day.Date.ToIso()&from=@windowStart@staffQuery#days" class="tile@Badges.DayTile(on, day.HasSlots)" aria-current="@(on ? "date" : null)" data-testid="day" data-has-slots="@day.HasSlots.ToString().ToLowerInvariant()">
                    <span class="text-[0.6875rem] font-semibold uppercase">@day.Date.ToString("ddd", culture)</span>
                    <span class="tile-date text-lg font-bold tabular-nums">@day.Date.Day</span>
                    <span class="text-[0.6875rem]">@day.Date.ToString("MMM", culture)</span>
                </a>
            }
        </nav>
        @if (r.LaterFrom is { } later)
        {
            <a href="/book/@r.ServiceId?from=@later.ToIso()@staffQuery#days" class="strip-arrow" data-testid="later-days" aria-label="@T["Booking.Public.LaterDays"]"><svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6" /></svg></a>
        }
        else
        {
            <span class="strip-arrow is-off" data-testid="later-days-off" aria-hidden="true"><svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6" /></svg></span>
        }
    </div>

    <div class="space-y-3">
        <h2 class="text-lg font-semibold" data-testid="selected-day">@r.SelectedDate.ToString("dddd, d MMMM", culture)</h2>
        @if (r.Slots.Count == 0)
        {
            <p data-testid="no-slots" class="rounded-xl border border-dashed border-stone-300 p-6 text-center text-stone-600">
                @(hasAnySlot ? T["Booking.Public.NoSlotsOnDay"] : T.Format("Booking.Public.NoSlotsAtAll", r.Days.Count))
            </p>
        }
        else
        {
            <div class="slot-parts" data-testid="slot-list" aria-label="@T["Booking.Public.Times"]">
                @* On a phone the parts of the day are tabs (the Booksy pattern the owner chose), driven by these
                   radios without a line of script; from sm every part shows at once under its own heading. *@
                @for (var i = 0; i < r.Groups.Count; i++)
                {
                    <input type="radio" name="slot-part" id="slot-part-@i" class="sr-only" checked="@(i == r.ChosenGroup)" aria-hidden="true" tabindex="-1" />
                }
                @if (r.Groups.Count > 1)
                {
                    <div class="slot-part-tabs sm:hidden" data-testid="slot-part-tabs">
                        @for (var i = 0; i < r.Groups.Count; i++)
                        {
                            <label for="slot-part-@i" class="slot-part-tab">@T[r.Groups[i].LabelKey]</label>
                        }
                    </div>
                }
                @for (var i = 0; i < r.Groups.Count; i++)
                {
                    var group = r.Groups[i];
                    <section class="slot-group space-y-2" data-part="@i" data-testid="slot-group">
                        <h3 class="hidden text-xs font-semibold uppercase tracking-wide text-stone-600 sm:block">@T[group.LabelKey]</h3>
                        <ul class="slot-grid">
                            @foreach (var slot in group.Slots)
                            {
                                var chosen = slot.Start == r.Chosen?.Start;
                                <li>
                                    @* Tapping selects on this page; Continue below carries the time on (owner's call, 2026-11-20). *@
                                    <a href="/book/@r.ServiceId?date=@r.SelectedDate.ToIso()&from=@windowStart&start=@Uri.EscapeDataString(slot.Start.ToIso())@staffQuery" data-testid="slot" aria-current="@(chosen ? "true" : null)" class="slot @(chosen ? "is-chosen" : null)">@slot.LocalStart.ToString("HH:mm", culture)</a>
                                </li>
                            }
                        </ul>
                    </section>
                }
            </div>
        }
    </div>

    @if (r.Chosen is { } picked)
    {
        <div class="sticky bottom-4 flex items-center justify-between gap-3 rounded-xl border border-brand-edge bg-white p-3 shadow-lg" data-testid="continue-bar">
            <p class="min-w-0 truncate text-sm text-stone-700">@r.SelectedDate.ToString("dddd, d MMMM", culture) · <span class="font-semibold tabular-nums">@picked.LocalStart.ToString("HH:mm", culture)</span></p>
            <a href="/book/@r.ServiceId/details?start=@Uri.EscapeDataString(picked.Start.ToIso())@staffQuery" class="btn btn-primary shrink-0" data-testid="continue">@T["Booking.Public.Continue"]</a>
        </div>
    }

    @if (r.WaitlistOffered)
    {
        @* For somebody who finds no time that suits (ADR 0055); only while the owner has switched it on. *@
        <p class="rounded-xl border border-stone-200 bg-white p-4 text-center text-stone-700" data-testid="waitlist-offer">
            @T["Booking.Waitlist.Offer"]
            <a href="@r.WaitlistPath" class="font-medium underline underline-offset-4" data-testid="join-waitlist">@T["Booking.Waitlist.OfferLink"]</a>
        </p>
    }
</section>
