@using System.Globalization
@using NodaTime
@using NodaTime.Text
@using Salon.Web.Features.Booking.ChooseSlot
@model ChooseSlotViewModel
@{
    var r = Model.Result;
    var culture = CultureInfo.CurrentCulture;
    ViewData["Title"] = T["Booking.Public.ChooseTime"];
    ViewData["Focused"] = true;
    // The person goes on to the next step; "anyone" only has to be remembered on this page.
    var personQuery = (r.SelectedStaffId is { } sid ? $"&staff={sid}" : string.Empty) + Model.AlsoQuery;
    var staffQuery = r.AnyoneChosen && r.Staff.Count > 1 ? $"&staff={ChooseSlotQuery.AnyStaff}{Model.AlsoQuery}" : personQuery;
    var keptDay = $"&date={r.SelectedDate.ToIso()}";
    var hasAnySlot = r.Days.Any(d => d.HasSlots);
    var windowStart = (r.Days.Count > 0 ? r.Days[0].Date : r.SelectedDate).ToIso();
    // An answer to "who with" keeps the day and the tapped time; a time that person does not have quietly drops out.
    var keptTime = r.Chosen is { } kept ? $"&from={windowStart}&start={Uri.EscapeDataString(kept.Start.ToIso())}" : string.Empty;
}
<section class="mx-auto max-w-2xl space-y-6" data-booking>
    @* The steps are for a desk; a phone has the page to itself (the owner, 2026-11-25). *@
    <div class="space-y-3 max-sm:hidden">
        <p class="text-sm font-medium text-stone-600" data-testid="step">@T.Format("Booking.Public.Step", 2, 3)</p>
        <ol class="steps">
            <li class="is-done"><span class="steps-bar"></span>@T["Booking.Public.StepService"]</li>
            <li class="is-done"><span class="steps-bar"></span>@T["Booking.Public.StepTime"]</li>
            <li><span class="steps-bar"></span>@T["Booking.Public.StepDetails"]</li>
        </ol>
    </div>

    @* The top of the page (ADR 0094, stage 5). On a phone it is one line, as on the screen the owner sent: the month as
       the title, the two arrows that page the days, and the way out. On a desk the title stands above and the month
       sits between its arrows. One set of elements, placed by the grid, so nothing is in the page twice. Every day
       and week link comes back here (#days). The arrows always hold their places: where there is nothing earlier or
       later the arrow is drawn faint and is not a link. *@
    <header id="days" class="book-top has-month">
        <h1 class="book-title book-top-title">@T["Booking.Public.ChooseTime"]</h1>
        @if (r.Days.Count > 0)
        {
            @if (r.EarlierFrom is { } earlier)
            {
                <a href="/book/@r.ServiceId?from=@earlier.ToIso()@staffQuery#days" class="strip-arrow book-top-earlier" data-testid="earlier-days" aria-label="@T["Booking.Public.EarlierDays"]"><svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M15 6l-6 6 6 6" /></svg></a>
            }
            else
            {
                <span class="strip-arrow is-off book-top-earlier" data-testid="earlier-days-off" aria-hidden="true"><svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M15 6l-6 6 6 6" /></svg></span>
            }
            <p class="day-month book-top-month" data-testid="month">@r.SelectedDate.ToString("MMMM yyyy", culture)</p>
            @if (r.LaterFrom is { } later)
            {
                <a href="/book/@r.ServiceId?from=@later.ToIso()@staffQuery#days" class="strip-arrow book-top-later" data-testid="later-days" aria-label="@T["Booking.Public.LaterDays"]"><svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6" /></svg></a>
            }
            else
            {
                <span class="strip-arrow is-off book-top-later" data-testid="later-days-off" aria-hidden="true"><svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6" /></svg></span>
            }
        }
        @* The way out of a booking asks first (ADR 0094): the link only opens the question below. *@
        <a href="#discard" class="book-close book-top-close" data-testid="close-booking" aria-label="@T["Booking.Public.Close"]"><svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18" /></svg></a>
    </header>

    <div id="discard" class="modal" role="dialog" aria-modal="true" aria-labelledby="discard-title" data-testid="discard-modal">
        <div class="modal-card">
            <h2 id="discard-title" class="text-xl font-semibold text-slate-800">@T["Booking.Public.Discard.Title"]</h2>
            <p class="text-slate-600">@T["Booking.Public.Discard.Text"]</p>
            <a href="#days" class="btn btn-primary w-full" data-testid="discard-stay">@T["Booking.Public.Discard.Stay"]</a>
            <a href="/book" class="btn btn-secondary w-full" data-testid="discard-yes">@T["Booking.Public.Discard.Yes"]</a>
        </div>
    </div>

    @if (r.Staff.Count > 1)
    {
        @* Who with (the owner, 2026-11-25): not in the way when the page opens. The staff line in the card has a
           button; it opens this sheet — the whole screen, a gentle white, the people side by side with their faces.
           It is still asked, not assumed (2026-11-22): until it is answered Continue opens the sheet instead of going
           on. "Anyone available" is an answer like the others (staff=any). An answer keeps the day and the tapped
           time. No script: the link to #who shows it, any answer is a new page. *@
        <div id="who" class="sheet" role="dialog" aria-modal="true" aria-labelledby="who-title" data-testid="staff-choice">
            <div class="sheet-body">
                <div class="flex items-center justify-between gap-3">
                    <h2 id="who-title" class="book-title">@T["Booking.Public.With"]</h2>
                    <a href="#days" class="book-close" data-testid="staff-close" aria-label="@T["Booking.Public.CloseChoice"]"><svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18" /></svg></a>
                </div>
                @if (r.NeedsStaffChoice)
                {
                    <p class="text-slate-600" data-testid="choose-staff">@T["Booking.Public.ChooseStaffFirst"]</p>
                }
                <nav aria-label="@T["Booking.Public.With"]" data-testid="staff-picker" class="staff-faces">
                    <a href="/book/@r.ServiceId?staff=@ChooseSlotQuery.AnyStaff@keptDay@keptTime@Model.AlsoQuery" class="staff-face @(r.AnyoneChosen ? "is-on" : null)" aria-current="@(r.AnyoneChosen ? "true" : null)" data-testid="staff-any"><span class="staff-face-any" aria-hidden="true"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="8" r="3.5" /><path d="M2.5 20c.6-3.4 3.2-5.5 6.5-5.5s5.9 2.1 6.5 5.5M16 4.8a3.5 3.5 0 0 1 0 6.4M18.5 14.9c1.700.9 2.700 2.600 3 5.100" /></svg></span><span class="staff-face-name">@T["Booking.Public.Anyone"]</span></a>
                    @foreach (var person in r.Staff)
                    {
                        var on = person.Id == r.SelectedStaffId;
                        <a href="/book/@r.ServiceId?staff=@person.Id@keptDay@keptTime@Model.AlsoQuery" class="staff-face @(on ? "is-on" : null)" aria-current="@(on ? "true" : null)" data-testid="staff-option"><avatar name="@person.DisplayName" photo="@person.PhotoPath" size="Large" /><span class="staff-face-name">@person.DisplayName</span></a>
                    }
                </nav>
            </div>
        </div>
    }

    @if (r.Days.Count > 0)
    {
        <nav aria-label="@T["Booking.Public.Day"]" data-testid="date-strip" class="vt-days day-strip scroll-row">
            @foreach (var day in r.Days)
            {
                var on = day.Date == r.SelectedDate;
                <a href="/book/@r.ServiceId?date=@day.Date.ToIso()&from=@windowStart@staffQuery#days" class="tile @Badges.DayTile(on, day.HasSlots)" aria-current="@(on ? "date" : null)" data-testid="day" data-has-slots="@day.HasSlots.ToString().ToLowerInvariant()">
                    <span class="tile-day">@day.Date.ToString("ddd", culture)</span>
                    <span class="tile-date tabular-nums">@day.Date.Day</span>
                    <span class="tile-bar" aria-hidden="true"></span>
                </a>
            }
        </nav>

        <div class="vt-times space-y-3">
            @* The day in words is for a desk and for a screen reader; on a phone the chosen tile says it. *@
            <h2 class="text-lg font-semibold max-sm:sr-only" data-testid="selected-day">@r.SelectedDate.ToString("dddd, d MMMM", culture)</h2>
            @if (r.Slots.Count == 0)
            {
                <p data-testid="no-slots" class="rounded-xl border border-dashed border-stone-300 p-6 text-center text-stone-600">
                    @(hasAnySlot ? T["Booking.Public.NoSlotsOnDay"] : T.Format("Booking.Public.NoSlotsAtAll", r.Days.Count))
                </p>
            }
            else
            {
                <div class="slot-parts" data-testid="slot-list" aria-label="@T["Booking.Public.Times"]">
                    @* On a phone the parts of the day are tabs and the times of one part run in a single line that
                       a finger slides (the Booksy pattern the owner chose), driven by these radios without a line of
                       script; from sm every part shows at once under its own heading, in a grid. *@
                    @for (var i = 0; i < r.Groups.Count; i++)
                    {
                        <input type="radio" name="slot-part" id="slot-part-@i" class="sr-only" checked="@(i == r.ChosenGroup)" aria-hidden="true" tabindex="-1" />
                    }
                    @if (r.Groups.Count > 1)
                    {
                        <div class="slot-part-tabs sm:hidden" data-testid="slot-part-tabs">
                            @for (var i = 0; i < r.Groups.Count; i++)
                            {
                                <label for="slot-part-@i" class="slot-part-tab">@T[r.Groups[i].LabelKey]</label>
                            }
                        </div>
                    }
                    @for (var i = 0; i < r.Groups.Count; i++)
                    {
                        var group = r.Groups[i];
                        <section class="slot-group space-y-2" data-part="@i" data-testid="slot-group">
                            <h3 class="hidden text-xs font-semibold uppercase tracking-wide text-stone-600 sm:block">@T[group.LabelKey]</h3>
                            <ul class="slot-grid slot-row">
                                @foreach (var slot in group.Slots)
                                {
                                    var chosen = slot.Start == r.Chosen?.Start;
                                    <li>
                                        @* Tapping selects on this page; Continue below carries the time on (owner's call, 2026-11-20). *@
                                        <a href="/book/@r.ServiceId?date=@r.SelectedDate.ToIso()&from=@windowStart&start=@Uri.EscapeDataString(slot.Start.ToIso())@staffQuery" data-testid="slot" aria-current="@(chosen ? "true" : null)" class="slot @(chosen ? "is-chosen" : null)">@slot.LocalStart.ToString("HH:mm", culture)</a>
                                    </li>
                                }
                            </ul>
                        </section>
                    }
                </div>
            }
        </div>
    }

    @* What is being booked, under the times (ADR 0094, stage 2): the service and its price, the time once one is
       tapped, who with, the total, and the one button that goes on. *@
    <section class="book-cards" data-testid="booking-summary" aria-label="@T["Booking.Public.Summary"]">
        @* A grey card for each service (the owner, 2026-11-25): its name, its price and its own time once one is
           tapped. One service can be changed for another; of several, each can be taken out by the cross at its corner. *@
        @foreach (var line in r.Lines)
        {
            var first = line.ServiceId == r.ServiceId;
            <div class="book-summary" data-testid="visit-line">
                @if (r.Lines.Count > 1)
                {
                    <a href="@Model.RemovePaths[line.ServiceId]" class="card-remove" data-testid="remove-service" aria-label="@T["Booking.Public.RemoveService"]: @line.Name"><svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18" /></svg></a>
                }
                <div class="flex items-start justify-between gap-4">
                    <div class="min-w-0">
                        <p class="font-medium text-slate-800" data-testid="@(first ? "service-name" : "extra-service-name")">@line.Name</p>
                        @if (r.Lines.Count == 1)
                        {
                            <a href="/book" class="text-sm text-slate-600 underline underline-offset-4" data-testid="change-service">@T["Booking.Public.ChangeService"]</a>
                        }
                    </div>
                    <div class="shrink-0 text-right">
                        <p class="font-semibold text-slate-800 tabular-nums" data-testid="@(r.Lines.Count == 1 ? "summary-price" : "line-price")">@(line.PriceIsFrom ? T.Format("Booking.ListServices.FromPrice", line.Price.ToDisplayString(culture)) : line.Price.ToDisplayString(culture))</p>
                        <p class="text-sm text-slate-600 tabular-nums" data-testid="@(r.Lines.Count == 1 ? "summary-when" : "line-when")">@ChooseSlotText.LineWhen(T, r, line, culture)</p>
                    </div>
                </div>
            </div>
        }
        @if (r.NobodyOffersAll)
        {
            <p class="notice notice-error" role="alert" data-testid="nobody-offers-all">@T["Booking.Public.NobodyOffersAll"]</p>
        }
        <div class="book-summary flex items-center justify-between gap-3 text-sm">
            <p class="min-w-0 text-slate-600">
                @T["Booking.Public.SummaryStaff"] <span class="font-medium text-slate-800" data-testid="summary-staff">@ChooseSlotText.Who(T, r)</span>
                @if (r.NeedsStaffChoice)
                {
                    <span class="staff-choice-required" data-testid="staff-required">@T["Booking.Public.Required"]</span>
                }
            </p>
            @if (r.Staff.Count > 1)
            {
                <a href="#who" class="btn btn-compact btn-secondary shrink-0" data-testid="change-staff">@T[r.NeedsStaffChoice ? "Booking.Public.ChooseStaff" : "Booking.Public.ChangeStaff"]<span class="sr-only">: @T["Booking.Public.With"]</span></a>
            }
        </div>
    </section>
    @if (Model.AddPath is { } addPath)
    {
        <a href="@addPath" class="add-service" data-testid="add-service"><svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M12 5v14M5 12h14" /></svg>@T["Booking.Public.AddService"]</a>
    }
    else if (Model.AddAfterTime)
    {
        @* More services come after a time is chosen for what is here (the owner, 2026-11-25). *@
        <p class="text-sm text-slate-600" data-testid="add-after-time">@T["Booking.Public.AddAfterTime"]</p>
    }
    <div class="book-total">
        <p class="text-sm text-slate-600">@T["Booking.Public.Total"]</p>
        <div class="text-right">
            <p class="text-2xl font-semibold text-slate-800 tabular-nums" data-testid="summary-total">@(r.PriceIsFrom ? T.Format("Booking.ListServices.FromPrice", r.Price.ToDisplayString(culture)) : r.Price.ToDisplayString(culture))</p>
            <p class="text-sm text-slate-600 tabular-nums" data-testid="summary-duration">@T.Format("Booking.Public.DurationMinutes", (int)r.Duration.TotalMinutes)</p>
        </div>
    </div>
    @if (r.Chosen is { } picked && r.NeedsStaffChoice)
    {
        @* A time is tapped but nobody is chosen: going on asks who with first (the sheet), and the answer keeps the time. *@
        <div class="sticky bottom-4" data-testid="continue-bar">
            <a href="#who" class="btn btn-primary w-full shadow-lg" data-testid="continue-needs-staff">@T["Booking.Public.Continue"]</a>
        </div>
    }
    else if (r.Chosen is { } going)
    {
        <div class="sticky bottom-4" data-testid="continue-bar">
            <a href="/book/@r.ServiceId/details?start=@Uri.EscapeDataString(going.Start.ToIso())@personQuery" class="btn btn-primary w-full shadow-lg" data-testid="continue">@T["Booking.Public.Continue"]</a>
        </div>
    }
    else if (r.Slots.Count > 0)
    {
        <p class="text-center text-sm text-slate-500" data-testid="continue-hint">@T["Booking.Public.ChooseTimeFirst"]</p>
    }

    @if (r.WaitlistOffered)
    {
        @* For somebody who finds no time that suits (ADR 0055); only while the owner has switched it on. *@
        <p class="rounded-xl border border-stone-200 bg-white p-4 text-center text-stone-700" data-testid="waitlist-offer">
            @T["Booking.Waitlist.Offer"]
            <a href="@r.WaitlistPath" class="font-medium underline underline-offset-4" data-testid="join-waitlist">@T["Booking.Waitlist.OfferLink"]</a>
        </p>
    }
</section>
@section Scripts {
    <script type="module" src="~/js/booking-slots.js" asp-append-version="true"></script>
}
