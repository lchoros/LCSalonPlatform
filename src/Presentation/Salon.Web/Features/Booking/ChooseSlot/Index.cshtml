@using System.Globalization
@using NodaTime
@using NodaTime.Text
@using Salon.Web.Features.Booking.ChooseSlot
@model ChooseSlotViewModel
@{
    var r = Model.Result;
    var culture = CultureInfo.CurrentCulture;
    ViewData["Title"] = T["Booking.Public.ChooseTime"];
    ViewData["Focused"] = true;
    // The person goes on to the next step; "anyone" only has to be remembered on this page.
    var personQuery = (r.SelectedStaffId is { } sid ? $"&staff={sid}" : string.Empty) + Model.AlsoQuery;
    var staffQuery = r.AnyoneChosen && r.Staff.Count > 1 ? $"&staff={ChooseSlotQuery.AnyStaff}{Model.AlsoQuery}" : personQuery;
    var keptDay = r.NeedsStaffChoice && !r.DayAsked ? string.Empty : $"&date={r.SelectedDate.ToIso()}";
    var hasAnySlot = r.Days.Any(d => d.HasSlots);
}
<section class="mx-auto max-w-2xl space-y-6">
    <header class="space-y-3">
        <p class="text-sm font-medium text-stone-600" data-testid="step">@T.Format("Booking.Public.Step", 2, 3)</p>
        <ol class="steps">
            <li class="is-done"><span class="steps-bar"></span>@T["Booking.Public.StepService"]</li>
            <li class="is-done"><span class="steps-bar"></span>@T["Booking.Public.StepTime"]</li>
            <li><span class="steps-bar"></span>@T["Booking.Public.StepDetails"]</li>
        </ol>
        <div class="flex items-center justify-between gap-3">
            <h1 class="book-title">@T["Booking.Public.ChooseTime"]</h1>
            @* The way out of a booking asks first (ADR 0094): the link only opens the question below. *@
            <a href="#discard" class="book-close" data-testid="close-booking" aria-label="@T["Booking.Public.Close"]"><svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18" /></svg></a>
        </div>
    </header>

    <div id="discard" class="modal" role="dialog" aria-modal="true" aria-labelledby="discard-title" data-testid="discard-modal">
        <div class="modal-card">
            <h2 id="discard-title" class="text-xl font-semibold text-slate-800">@T["Booking.Public.Discard.Title"]</h2>
            <p class="text-slate-600">@T["Booking.Public.Discard.Text"]</p>
            <a href="#days" class="btn btn-primary w-full" data-testid="discard-stay">@T["Booking.Public.Discard.Stay"]</a>
            <a href="/book" class="btn btn-secondary w-full" data-testid="discard-yes">@T["Booking.Public.Discard.Yes"]</a>
        </div>
    </div>

    @if (r.Staff.Count > 1)
    {
        @* Who with is asked, not assumed (the owner, 2026-11-22): nobody is chosen when the page opens, and the days
           and times wait for the answer. "Anyone available" is an answer like the others (staff=any). *@
        <section id="who" class="staff-choice @(r.NeedsStaffChoice ? "is-needed" : null)" data-testid="staff-choice">
            <h2 class="staff-choice-title">
                @T["Booking.Public.With"]
                @if (r.NeedsStaffChoice)
                {
                    <span class="staff-choice-required" data-testid="staff-required">@T["Booking.Public.Required"]</span>
                }
            </h2>
            <nav aria-label="@T["Booking.Public.With"]" data-testid="staff-picker" class="scroll-row">
                <a href="/book/@r.ServiceId?staff=@ChooseSlotQuery.AnyStaff@keptDay@Model.AlsoQuery" class="pill @Badges.DayTile(r.AnyoneChosen, true)" aria-current="@(r.AnyoneChosen ? "true" : null)" data-testid="staff-any">@T["Booking.Public.Anyone"]</a>
                @foreach (var person in r.Staff)
                {
                    var on = person.Id == r.SelectedStaffId;
                    <a href="/book/@r.ServiceId?staff=@person.Id@keptDay@Model.AlsoQuery" class="pill gap-2 pl-2 @Badges.DayTile(on, true)" aria-current="@(on ? "true" : null)" data-testid="staff-option"><avatar name="@person.DisplayName" photo="@person.PhotoPath" size="Small" />@person.DisplayName</a>
                }
            </nav>
            @if (r.NeedsStaffChoice)
            {
                <p class="text-sm text-slate-600" data-testid="choose-staff">@T["Booking.Public.ChooseStaffFirst"]</p>
            }
        </section>
    }

    @if (!r.NeedsStaffChoice)
    {
    var windowStart = (r.Days.Count > 0 ? r.Days[0].Date : r.SelectedDate).ToIso();
    @* The two arrows always hold their places (the owner, 2026-11-20): where there is nothing earlier or later the
       arrow is drawn faint and is not a link, so the strip between them never shifts. Every link comes back to this
       bar (#days), so changing the day or the week does not throw the page to its top. *@
    <div id="days" class="day-wrap">
        <div class="day-head">
        @if (r.EarlierFrom is { } earlier)
        {
            <a href="/book/@r.ServiceId?from=@earlier.ToIso()@staffQuery#days" class="strip-arrow" data-testid="earlier-days" aria-label="@T["Booking.Public.EarlierDays"]"><svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M15 6l-6 6 6 6" /></svg></a>
        }
        else
        {
            <span class="strip-arrow is-off" data-testid="earlier-days-off" aria-hidden="true"><svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M15 6l-6 6 6 6" /></svg></span>
        }
            <p class="day-month" data-testid="month">@r.SelectedDate.ToString("MMMM yyyy", culture)</p>
        @if (r.LaterFrom is { } later)
        {
            <a href="/book/@r.ServiceId?from=@later.ToIso()@staffQuery#days" class="strip-arrow" data-testid="later-days" aria-label="@T["Booking.Public.LaterDays"]"><svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6" /></svg></a>
        }
        else
        {
            <span class="strip-arrow is-off" data-testid="later-days-off" aria-hidden="true"><svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6" /></svg></span>
        }
        </div>
        <nav aria-label="@T["Booking.Public.Day"]" data-testid="date-strip" class="vt-days scroll-row mx-0 min-w-0 flex-1 px-0 scroll-px-0">
            @foreach (var day in r.Days)
            {
                var on = day.Date == r.SelectedDate;
                <a href="/book/@r.ServiceId?date=@day.Date.ToIso()&from=@windowStart@staffQuery#days" class="tile @Badges.DayTile(on, day.HasSlots)" aria-current="@(on ? "date" : null)" data-testid="day" data-has-slots="@day.HasSlots.ToString().ToLowerInvariant()">
                    <span class="tile-day">@day.Date.ToString("ddd", culture)</span>
                    <span class="tile-date tabular-nums">@day.Date.Day</span>
                    <span class="tile-bar" aria-hidden="true"></span>
                </a>
            }
        </nav>
    </div>

    <div class="vt-times space-y-3">
        <h2 class="text-lg font-semibold" data-testid="selected-day">@r.SelectedDate.ToString("dddd, d MMMM", culture)</h2>
        @if (r.Slots.Count == 0)
        {
            <p data-testid="no-slots" class="rounded-xl border border-dashed border-stone-300 p-6 text-center text-stone-600">
                @(hasAnySlot ? T["Booking.Public.NoSlotsOnDay"] : T.Format("Booking.Public.NoSlotsAtAll", r.Days.Count))
            </p>
        }
        else
        {
            <div class="slot-parts" data-testid="slot-list" aria-label="@T["Booking.Public.Times"]">
                @* On a phone the parts of the day are tabs (the Booksy pattern the owner chose), driven by these
                   radios without a line of script; from sm every part shows at once under its own heading. *@
                @for (var i = 0; i < r.Groups.Count; i++)
                {
                    <input type="radio" name="slot-part" id="slot-part-@i" class="sr-only" checked="@(i == r.ChosenGroup)" aria-hidden="true" tabindex="-1" />
                }
                @if (r.Groups.Count > 1)
                {
                    <div class="slot-part-tabs sm:hidden" data-testid="slot-part-tabs">
                        @for (var i = 0; i < r.Groups.Count; i++)
                        {
                            <label for="slot-part-@i" class="slot-part-tab">@T[r.Groups[i].LabelKey]</label>
                        }
                    </div>
                }
                @for (var i = 0; i < r.Groups.Count; i++)
                {
                    var group = r.Groups[i];
                    <section class="slot-group space-y-2" data-part="@i" data-testid="slot-group">
                        <h3 class="hidden text-xs font-semibold uppercase tracking-wide text-stone-600 sm:block">@T[group.LabelKey]</h3>
                        <ul class="slot-grid">
                            @foreach (var slot in group.Slots)
                            {
                                var chosen = slot.Start == r.Chosen?.Start;
                                <li>
                                    @* Tapping selects on this page; Continue below carries the time on (owner's call, 2026-11-20). *@
                                    <a href="/book/@r.ServiceId?date=@r.SelectedDate.ToIso()&from=@windowStart&start=@Uri.EscapeDataString(slot.Start.ToIso())@staffQuery" data-testid="slot" aria-current="@(chosen ? "true" : null)" class="slot @(chosen ? "is-chosen" : null)">@slot.LocalStart.ToString("HH:mm", culture)</a>
                                </li>
                            }
                        </ul>
                    </section>
                }
            </div>
        }
    </div>

    }
    @* What is being booked, under the times (ADR 0094, stage 2): the service and its price, the time once one is
       tapped, who with, the total, and the one button that goes on. *@
    <section class="book-summary" data-testid="booking-summary" aria-label="@T["Booking.Public.Summary"]">
        @if (r.Lines.Count <= 1)
        {
            <div class="flex items-start justify-between gap-4">
                <p class="min-w-0 font-medium text-slate-800" data-testid="service-name">@r.ServiceName</p>
                <div class="shrink-0 text-right">
                    <p class="font-semibold text-slate-800 tabular-nums" data-testid="summary-price">@(r.PriceIsFrom ? T.Format("Booking.ListServices.FromPrice", r.Price.ToDisplayString(culture)) : r.Price.ToDisplayString(culture))</p>
                    <p class="text-sm text-slate-600 tabular-nums" data-testid="summary-when">@ChooseSlotText.When(T, r, culture)</p>
                </div>
            </div>
        }
        else
        {
            @* Several services in one visit (ADR 0095): each with its own price and length and a way to take it out;
               the time and the total below are for the whole visit. *@
            <ul class="space-y-3" data-testid="visit-lines">
                @foreach (var line in r.Lines)
                {
                    <li class="flex items-start justify-between gap-4" data-testid="visit-line">
                        <div class="min-w-0">
                            <p class="font-medium text-slate-800" data-testid="@(line.ServiceId == r.ServiceId ? "service-name" : "extra-service-name")">@line.Name</p>
                            <a href="@Model.RemovePaths[line.ServiceId]" class="text-sm text-slate-600 underline underline-offset-4" data-testid="remove-service">@T["Booking.Public.RemoveService"]<span class="sr-only">: @line.Name</span></a>
                        </div>
                        <div class="shrink-0 text-right">
                            <p class="font-semibold text-slate-800 tabular-nums" data-testid="line-price">@(line.PriceIsFrom ? T.Format("Booking.ListServices.FromPrice", line.Price.ToDisplayString(culture)) : line.Price.ToDisplayString(culture))</p>
                            <p class="text-sm text-slate-600 tabular-nums">@T.Format("Booking.Public.DurationMinutes", (int)line.Duration.TotalMinutes)</p>
                        </div>
                    </li>
                }
            </ul>
            <p class="border-t border-slate-200 pt-3 text-sm text-slate-600">@T["Booking.Public.SummaryWhen"] <span class="font-medium text-slate-800 tabular-nums" data-testid="summary-when">@ChooseSlotText.When(T, r, culture)</span></p>
        }
        @if (r.NobodyOffersAll)
        {
            <p class="notice notice-error" role="alert" data-testid="nobody-offers-all">@T["Booking.Public.NobodyOffersAll"]</p>
        }
        <div class="flex flex-wrap items-center justify-between gap-2 border-t border-slate-200 pt-3 text-sm">
            <p class="text-slate-600">@T["Booking.Public.SummaryStaff"] <span class="font-medium text-slate-800" data-testid="summary-staff">@ChooseSlotText.Who(T, r)</span></p>
            <span class="flex flex-wrap gap-2">
                @if (Model.AddPath is { } addPath)
                {
                    <a href="@addPath" class="btn btn-compact btn-secondary" data-testid="add-service">@T["Booking.Public.AddService"]</a>
                }
                <a href="/book" class="btn btn-compact btn-secondary" data-testid="change-service">@T["Booking.Public.ChangeService"]</a>
            </span>
        </div>
    </section>
    <div class="book-total">
        <p class="text-sm text-slate-600">@T["Booking.Public.Total"]</p>
        <p class="text-2xl font-semibold text-slate-800 tabular-nums" data-testid="summary-total">@(r.PriceIsFrom ? T.Format("Booking.ListServices.FromPrice", r.Price.ToDisplayString(culture)) : r.Price.ToDisplayString(culture))</p>
    </div>
    @if (r.Chosen is { } picked)
    {
        <div class="sticky bottom-4" data-testid="continue-bar">
            <a href="/book/@r.ServiceId/details?start=@Uri.EscapeDataString(picked.Start.ToIso())@personQuery" class="btn btn-primary w-full shadow-lg" data-testid="continue">@T["Booking.Public.Continue"]</a>
        </div>
    }
    else if (r.Slots.Count > 0)
    {
        <p class="text-center text-sm text-slate-500" data-testid="continue-hint">@T["Booking.Public.ChooseTimeFirst"]</p>
    }

    @if (r.WaitlistOffered)
    {
        @* For somebody who finds no time that suits (ADR 0055); only while the owner has switched it on. *@
        <p class="rounded-xl border border-stone-200 bg-white p-4 text-center text-stone-700" data-testid="waitlist-offer">
            @T["Booking.Waitlist.Offer"]
            <a href="@r.WaitlistPath" class="font-medium underline underline-offset-4" data-testid="join-waitlist">@T["Booking.Waitlist.OfferLink"]</a>
        </p>
    }
</section>
