@using System.Globalization
@using Salon.Web.Features.Booking.CancelBooking
@model CancelBookingViewModel
@{
    var culture = CultureInfo.CurrentCulture;
    ViewData["Title"] = T["Booking.Public.Cancel.Title"];
}
<section class="mx-auto max-w-lg space-y-6">
    <h1 class="text-2xl font-bold tracking-tight sm:text-3xl">@T["Booking.Public.Cancel.Title"]</h1>

    @if (Model.Appointment is { } a && Model.State is CancelState.Confirm or CancelState.Cancelled)
    {
        var local = a.Start.InZone(Model.Zone).LocalDateTime;
        <dl class="facts" data-testid="booking-details">
            <dt>@T["Booking.Public.Done.Service"]</dt>
            <dd>@a.ServiceName</dd>
            <dt>@T["Booking.Public.Done.Staff"]</dt>
            <dd>@a.StaffName</dd>
            <dt>@T["Booking.Public.Done.When"]</dt>
            <dd class="tabular-nums">@local.ToString("dddd, d MMMM yyyy", culture), @local.ToString("HH:mm", culture)</dd>
            <dt>@T["Booking.Public.Done.Where"]</dt>
            <dd>@Model.SalonName</dd>
        </dl>
    }

    @switch (Model.State)
    {
        case CancelState.Confirm:
            <form method="post" asp-action="CancelConfirmed" class="flex flex-col gap-3" data-testid="cancel-form">
                <button type="submit" data-testid="confirm-cancel" class="btn btn-danger w-full">@T["Booking.Public.Cancel.Confirm"]</button>
                <a href="/book" class="btn btn-secondary w-full">@T["Booking.Public.Cancel.Keep"]</a>
            </form>
            break;
        case CancelState.Cancelled:
            <p role="status" data-testid="cancel-result" class="notice notice-ok">@T["Booking.Public.Cancel.Done"]</p>
            <a href="/book" data-testid="book-another" class="btn btn-primary w-full">@T["Booking.Public.Done.BookAnother"]</a>
            break;
        case CancelState.Already:
            <p role="status" data-testid="cancel-result" class="notice notice-warn">@T["Booking.Public.Cancel.Already"]</p>
            break;
        case CancelState.TooLate:
            <p role="status" data-testid="cancel-result" class="notice notice-warn">@T["Booking.Public.Cancel.TooLate"]</p>
            break;
        default:
            <p role="status" data-testid="cancel-result" class="notice notice-warn">@T["Booking.Public.Cancel.Invalid"]</p>
            break;
    }
</section>
