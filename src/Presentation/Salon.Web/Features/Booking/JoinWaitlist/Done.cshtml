@using Salon.Web.Features.Booking.JoinWaitlist
@model WaitlistFormSummary
@{
    ViewData["Title"] = T["Booking.Waitlist.Done.Title"];
}
<section class="mx-auto max-w-lg space-y-6 text-center">
    <header class="space-y-3">
        <span class="mx-auto flex size-14 items-center justify-center rounded-full bg-emerald-100 text-emerald-800" aria-hidden="true">
            <svg class="size-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg>
        </span>
        <h1 class="text-2xl font-bold tracking-tight sm:text-3xl" data-testid="waitlist-done">@T["Booking.Waitlist.Done.Title"]</h1>
        <p class="text-stone-700">@T.Format("Booking.Waitlist.Done.Lead", Model.ServiceName)</p>
    </header>
    <p class="text-sm text-stone-600">@T["Booking.Waitlist.Done.Meanwhile"]</p>
    <a href="/book/@Model.ServiceId" class="btn btn-secondary w-full" data-testid="back-to-times">@T["Booking.Waitlist.BackToTimes"]</a>
    @await Component.InvokeAsync("SalonContact")
</section>
