@using Salon.Services.Products.Import
@using Salon.Web.Features.Products.ImportProducts
@model ProductImportResult
@{
    ViewData["Title"] = T["Products.Import.Result.Title"];
}
<section class="mx-auto max-w-lg space-y-6" data-testid="import-result">
    <header class="space-y-2">
        <h1 class="page-title">@T["Products.Import.Result.Title"]</h1>
        <p class="text-sm text-stone-600">@Model.FileName</p>
    </header>

    <div class="rounded-lg border border-green-200 bg-green-50 p-5 text-center">
        <p data-testid="result-created" class="text-5xl font-bold text-green-900">@Model.Created</p>
        <p class="mt-1 text-sm font-medium text-green-800">@T["Products.Import.Result.CreatedLabel"]</p>
    </div>

    <p class="text-stone-600" data-testid="result-units">@T.Plural("Products.Import.Result.Units", Model.Units)</p>
    <p class="text-stone-600" data-testid="result-skipped">@T.Format("Products.Import.Result.Skipped", Model.Duplicates, Model.Invalid)</p>

    <div class="flex flex-col gap-3 pt-2 sm:flex-row sm:justify-end">
        <a href="@ImportProductsController.UploadPath" class="btn btn-compact btn-secondary">@T["Products.Import.Result.Again"]</a>
        <a href="@ImportProductsController.ListPath" data-testid="to-products" class="btn btn-compact btn-primary">@T["Products.Import.Result.ToProducts"]</a>
    </div>
</section>
