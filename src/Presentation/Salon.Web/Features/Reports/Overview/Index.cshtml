@using System.Globalization
@using NodaTime.Text
@using Salon.Core.Reports
@using Salon.Services.Reports
@using Salon.Web.Features.Reports.Overview
@model SalonReport
@{
    var culture = CultureInfo.CurrentCulture;
    var period = Model.Period;
    ViewData["Title"] = T["Reports.Title"];
    const string inputClass = "field field-compact";
    const string primaryClass = "btn btn-compact btn-primary w-full sm:w-auto";
    const string cardClass = "space-y-3 panel";
    const string statClass = "panel stat";
    const string listClass = "grid grid-cols-[1fr_auto] gap-x-4 gap-y-2 text-base";
    const string subheadClass = "pt-2 text-sm font-semibold text-stone-700";
}
<section class="space-y-6">
    <header class="max-w-2xl space-y-3">
        <h1 class="page-title">@T["Reports.Title"]</h1>
        <p class="text-stone-600">@T["Reports.Lead"]</p>
        <nav aria-label="@T["Reports.Period.Nav"]" class="grid grid-cols-2 gap-2 sm:grid-cols-4" data-testid="presets">
            @foreach (var preset in Enum.GetValues<ReportPreset>())
            {
                var current = Model.Preset == preset;
                <a href="@ReportsController.PresetPath(preset)" data-testid="preset-@preset" aria-current="@(current ? "page" : null)"
                   class="filter-tile accent-0 @(current ? "is-on" : null)">@T[$"Reports.Preset.{preset}"]</a>
            }
        </nav>
        <details class="panel" data-testid="custom-period" open="@(Model.Preset is null || Model.RangeRefused)">
            <summary class="cursor-pointer text-base font-medium">@T["Reports.Period.Custom"]</summary>
            <form method="get" action="@ReportsController.Path" class="mt-3 grid gap-3 sm:grid-cols-[1fr_1fr_auto] sm:items-end" data-testid="period-form">
                <div class="space-y-1">
                    <label for="from" class="field-label">@T["Reports.Period.From"]</label>
                    <input id="from" name="from" type="date" value="@period.From.ToIso()" required class="@inputClass" data-testid="period-from" />
                </div>
                <div class="space-y-1">
                    <label for="to" class="field-label">@T["Reports.Period.To"]</label>
                    <input id="to" name="to" type="date" value="@period.To.ToIso()" required class="@inputClass" data-testid="period-to" />
                </div>
                <button type="submit" class="@primaryClass" data-testid="period-show">@T["Reports.Period.Show"]</button>
            </form>
        </details>
        @if (Model.RangeRefused)
        {
            <p role="alert" data-testid="error" class="notice notice-error">@T.Format("Reports.Period.Refused", ReportRules.MaxDays)</p>
        }
        <p class="text-base font-medium sm:text-lg" data-testid="period" data-from="@period.From.ToIso()" data-to="@period.To.ToIso()">@T.Format("Reports.Period.Range", period.From.ToString("D", culture), period.To.ToString("D", culture))</p>
    </header>

    @* The four numbers an owner looks for first, each in a tile of its own; the detail follows underneath. *@
    <dl class="grid grid-cols-2 gap-3 lg:grid-cols-4" data-testid="headlines">
        <div class="@statClass accent-3">
            <dt class="stat-label">@T["Reports.Takings.Total"]</dt>
            <dd class="stat-value" data-testid="headline-takings">@Model.Takings.Total.ToDisplayString(culture)</dd>
        </div>
        <div class="@statClass accent-2">
            <dt class="stat-label">@T["Reports.Visits.Total"]</dt>
            <dd class="stat-value" data-testid="headline-visits">@Model.Visits.Total</dd>
        </div>
        <div class="@statClass accent-4">
            <dt class="stat-label">@T["Reports.Visits.NoShowRate"]</dt>
            <dd class="stat-value" data-testid="headline-no-show-rate">@ReportText.Percent(T, Model.Visits.NoShowRate, culture)</dd>
        </div>
        <div class="@statClass accent-1">
            <dt class="stat-label">@T["Reports.Unpaid.Title"]</dt>
            <dd class="stat-value" data-testid="headline-unpaid">@Model.UnpaidTotal.ToDisplayString(culture)</dd>
        </div>
    </dl>

    @if (Model.Comparison is { HasAny: true } compare)
    {
        @* The period against the same days one period earlier (ADR 0046). The change is in words, not colour or an arrow. *@
        <section class="@cardClass" data-testid="comparison">
            <h2 class="text-lg font-semibold">@T["Reports.Compare.Title"]</h2>
            <p class="text-sm text-stone-600" data-testid="comparison-days" data-before-from="@compare.Before.From.ToIso()" data-before-to="@compare.Before.To.ToIso()">@T.Format("Reports.Compare.Days", compare.SoFar.From.ToString("d", culture), compare.SoFar.To.ToString("d", culture), compare.Before.From.ToString("d", culture), compare.Before.To.ToString("d", culture))</p>
            <table class="w-full text-left text-base">
                <thead>
                    <tr class="text-sm text-stone-600">
                        <th scope="col" class="py-1 pr-2 font-medium"><span class="sr-only">@T["Reports.Compare.What"]</span></th>
                        <th scope="col" class="px-2 py-1 text-right font-medium">@T["Reports.Compare.Now"]</th>
                        <th scope="col" class="px-2 py-1 text-right font-medium">@T["Reports.Compare.Before"]</th>
                        <th scope="col" class="py-1 pl-2 text-right font-medium">@T["Reports.Compare.Change"]</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-stone-200">
                    <tr>
                        <th scope="row" class="py-2 pr-2 font-medium">@T["Reports.Takings.Total"]</th>
                        <td class="px-2 py-2 text-right tabular-nums" data-testid="compare-takings-now">@compare.Takings.ToDisplayString(culture)</td>
                        <td class="px-2 py-2 text-right tabular-nums" data-testid="compare-takings-before">@compare.TakingsBefore.ToDisplayString(culture)</td>
                        <td class="py-2 pl-2 text-right font-semibold" data-testid="compare-takings-change">@ReportText.Change(T, compare.TakingsChange, culture)</td>
                    </tr>
                    <tr>
                        <th scope="row" class="py-2 pr-2 font-medium">@T["Reports.Visits.Completed"]</th>
                        <td class="px-2 py-2 text-right tabular-nums" data-testid="compare-completed-now">@compare.Completed</td>
                        <td class="px-2 py-2 text-right tabular-nums" data-testid="compare-completed-before">@compare.CompletedBefore</td>
                        <td class="py-2 pl-2 text-right font-semibold" data-testid="compare-completed-change">@ReportText.Change(T, compare.CompletedChange, culture)</td>
                    </tr>
                    <tr>
                        <th scope="row" class="py-2 pr-2 font-medium">@T["Reports.Visits.NoShows"]</th>
                        <td class="px-2 py-2 text-right tabular-nums" data-testid="compare-no-shows-now">@compare.NoShows</td>
                        <td class="px-2 py-2 text-right tabular-nums" data-testid="compare-no-shows-before">@compare.NoShowsBefore</td>
                        <td class="py-2 pl-2 text-right font-semibold" data-testid="compare-no-shows-change">@ReportText.Change(T, compare.NoShowsChange, culture)</td>
                    </tr>
                </tbody>
            </table>
            <p class="text-sm text-stone-600">@T["Reports.Compare.Hint"]</p>
        </section>
    }

    <div class="grid items-start gap-6 lg:grid-cols-2">
    <section class="@cardClass" data-testid="takings">
        <div class="flex flex-wrap items-center justify-between gap-2">
            <h2 class="text-lg font-semibold">@T["Reports.Takings.Title"]</h2>
            @if (Model.Takings.ByMethod.Count > 0)
            {
                @* The same lines as a file for a spreadsheet (ADR 0042); the ExportMoney slice owns the address. *@
                <a href="@ReportsController.MoneyExportPath(period)" class="btn btn-compact btn-secondary" data-testid="export-money" download>@T["Reports.Export.Money"]</a>
            }
        </div>
        @if (Model.Takings.ByMethod.Count == 0)
        {
            <p class="text-sm text-stone-600" data-testid="no-takings">@T["Reports.Takings.None"]</p>
        }
        else
        {
            <p class="flex items-baseline justify-between gap-4 rounded-md bg-stone-50 p-3">
                <span class="text-sm text-stone-700">@T["Reports.Takings.Total"]</span>
                <span class="text-xl font-bold tabular-nums" data-testid="takings-total">@Model.Takings.Total.ToDisplayString(culture)</span>
            </p>
            @if (TakingsCharts.For(Model.Takings, T, culture) is { } chart)
            {
                @* The same days as bars (ADR 0048): plain SVG shapes, no script. The list under "Day by day" below has the figures. *@
                <figure class="space-y-1" data-testid="takings-chart">
                    <figcaption class="@subheadClass">@T["Reports.Chart.Title"]</figcaption>
                    <svg viewBox="@chart.ViewBox" preserveAspectRatio="none" role="img" aria-label="@chart.Summary" class="h-40 w-full">
                        @foreach (var bar in chart.Bars)
                        {
                            <rect x="@bar.X" y="@bar.Y" width="@bar.Width" height="@bar.Height" class="@(bar.Below ? "fill-red-700" : "fill-stone-800")" data-testid="chart-bar" data-day="@bar.Day"><title>@bar.Title</title></rect>
                        }
                        <line x1="0" x2="@chart.Width" y1="@chart.Baseline" y2="@chart.Baseline" class="stroke-stone-400" stroke-width="1" vector-effect="non-scaling-stroke" />
                    </svg>
                    <p class="flex justify-between text-xs text-stone-600"><span data-testid="chart-first">@chart.First</span><span data-testid="chart-last">@chart.Last</span></p>
                    <p class="text-sm text-stone-600" data-testid="chart-best">@chart.Summary</p>
                </figure>
            }
            <h3 class="@subheadClass">@T["Reports.Takings.ByMethod"]</h3>
            <dl class="@listClass">
                @foreach (var total in Model.Takings.ByMethod)
                {
                    <dt>@T[$"Payments.Method.{total.Method}"]</dt>
                    <dd class="text-right tabular-nums" data-testid="method-@total.Method">@total.Amount.ToDisplayString(culture)</dd>
                }
            </dl>
            <h3 class="@subheadClass">@T["Reports.Takings.ByKind"]</h3>
            <dl class="@listClass">
                @foreach (var total in Model.Takings.ByKind)
                {
                    <dt>@T[$"Payments.Kind.{total.Kind}"]</dt>
                    <dd class="text-right tabular-nums @(total.Amount.Amount < 0m ? "text-red-800" : string.Empty)" data-testid="kind-@total.Kind">@total.Amount.ToDisplayString(culture)</dd>
                }
            </dl>
            <details data-testid="takings-by-day">
                <summary class="cursor-pointer @subheadClass">@T["Reports.Takings.ByDay"]</summary>
                <p class="pt-2 text-sm text-stone-600">@T["Reports.Takings.ByDayHint"]</p>
                <ul class="mt-2 list-card">
                    @foreach (var day in Model.Takings.ByDay)
                    {
                        var iso = day.Day.ToIso();
                        <li class="flex items-center justify-between gap-4 px-3" data-testid="takings-day" data-day="@iso">
                            <a href="@(ReportsController.TillPath + "?date=" + iso)" class="inline-flex min-h-11 items-center font-medium underline underline-offset-2">@day.Day.ToDayHeading(culture)</a>
                            <span class="tabular-nums @(day.Amount.Amount < 0m ? "text-red-800" : string.Empty)">@day.Amount.ToDisplayString(culture)</span>
                        </li>
                    }
                </ul>
            </details>
        }
    </section>

    <section class="@cardClass" data-testid="visits">
        <div class="flex flex-wrap items-center justify-between gap-2">
            <h2 class="text-lg font-semibold">@T["Reports.Visits.Title"]</h2>
            @if (Model.Visits.Total > 0)
            {
                @* Every visit of the period as a file for a spreadsheet (ADR 0047); the ExportVisits slice owns the address. *@
                <a href="@ReportsController.VisitsExportPath(period)" class="btn btn-compact btn-secondary" data-testid="export-visits" download>@T["Reports.Export.Visits"]</a>
            }
        </div>
        <dl class="@listClass">
            <dt class="font-semibold">@T["Reports.Visits.Total"]</dt>
            <dd class="text-right font-bold tabular-nums" data-testid="visits-total">@Model.Visits.Total</dd>
            <dt>@T["Reports.Visits.Completed"]</dt>
            <dd class="text-right tabular-nums" data-testid="visits-completed">@Model.Visits.Completed</dd>
            <dt>@T["Reports.Visits.Open"]</dt>
            <dd class="text-right tabular-nums" data-testid="visits-open">@Model.Visits.Open</dd>
            <dt>@T["Reports.Visits.NoShows"]</dt>
            <dd class="text-right tabular-nums" data-testid="visits-no-shows">@Model.Visits.NoShows</dd>
            <dt>@T["Reports.Visits.CancelledByClient"]</dt>
            <dd class="text-right tabular-nums" data-testid="visits-cancelled-client">@Model.Visits.CancelledByClient</dd>
            <dt>@T["Reports.Visits.CancelledBySalon"]</dt>
            <dd class="text-right tabular-nums" data-testid="visits-cancelled-salon">@Model.Visits.CancelledBySalon</dd>
            <dt>@T["Reports.Visits.Online"]</dt>
            <dd class="text-right tabular-nums" data-testid="visits-online">@Model.Visits.Online</dd>
            <dt class="border-t border-stone-200 pt-2">
                <span class="block font-semibold">@T["Reports.Visits.NoShowRate"]</span>
                <span class="block text-sm text-stone-600">@T["Reports.Visits.NoShowRateHint"]</span>
            </dt>
            <dd class="border-t border-stone-200 pt-2 text-right font-bold tabular-nums" data-testid="no-show-rate">@ReportText.Percent(T, Model.Visits.NoShowRate, culture)</dd>
            <dt class="font-semibold">@T["Reports.Visits.CompletedValue"]</dt>
            <dd class="text-right font-bold tabular-nums" data-testid="completed-value">@Model.Visits.CompletedValue.ToDisplayString(culture)</dd>
        </dl>
    </section>

    @if (Model.Fees.Added.Amount > 0m || Model.Fees.Waived.Amount > 0m || Model.Fees.Paid.Amount > 0m)
    {
        <section class="@cardClass" data-testid="fees">
            <h2 class="text-lg font-semibold">@T["Reports.Fees.Title"]</h2>
            <dl class="@listClass">
                <dt>@T["Reports.Fees.Added"]</dt>
                <dd class="text-right tabular-nums" data-testid="fees-added">@Model.Fees.Added.ToDisplayString(culture)</dd>
                <dt>@T["Reports.Fees.Waived"]</dt>
                <dd class="text-right tabular-nums" data-testid="fees-waived">@Model.Fees.Waived.ToDisplayString(culture)</dd>
                <dt>@T["Reports.Fees.Paid"]</dt>
                <dd class="text-right tabular-nums" data-testid="fees-paid">@Model.Fees.Paid.ToDisplayString(culture)</dd>
            </dl>
        </section>
    }

    <section class="@cardClass" data-testid="unpaid">
        <h2 class="text-lg font-semibold">@T["Reports.Unpaid.Title"]</h2>
        @if (Model.UnpaidCount == 0)
        {
            <p class="text-sm text-stone-600" data-testid="no-unpaid">@T["Reports.Unpaid.None"]</p>
        }
        else
        {
            <p role="status" class="notice notice-warn" data-testid="unpaid-summary">@T.Format("Reports.Unpaid.Summary", Model.UnpaidCount, Model.UnpaidTotal.ToDisplayString(culture))</p>
            <ul class="list-card" data-testid="unpaid-list">
                @foreach (var visit in Model.Unpaid)
                {
                    <li class="flex flex-col gap-2 p-3 sm:flex-row sm:items-center sm:justify-between" data-testid="unpaid-visit">
                        <span class="flex flex-col gap-0.5">
                            <span class="font-medium">@visit.ClientName</span>
                            <span class="text-sm text-stone-600">@visit.Start.Date.ToString("d", culture) @visit.Start.TimeOfDay.ToShortTime(culture) · @visit.ServiceName</span>
                        </span>
                        <span class="flex items-center justify-between gap-3">
                            <span class="tabular-nums font-medium" data-testid="unpaid-amount">@visit.Outstanding.ToDisplayString(culture)</span>
                            <a href="@(ReportsController.CheckoutPath + visit.AppointmentId)" data-testid="unpaid-checkout" class="btn btn-compact btn-secondary px-3">@T["Reports.Unpaid.Checkout"]<span class="sr-only">: @visit.ClientName, @visit.Start.Date.ToString("d", culture)</span></a>
                        </span>
                    </li>
                }
            </ul>
            @if (Model.UnpaidCount > Model.Unpaid.Count)
            {
                <p class="text-sm text-stone-600" data-testid="unpaid-more">@T.Format("Reports.Unpaid.More", Model.Unpaid.Count)</p>
            }
        }
    </section>

    <section class="@cardClass" data-testid="top-services">
        <h2 class="text-lg font-semibold">@T["Reports.Services.Title"]</h2>
        @if (Model.TopServices.Count == 0)
        {
            <p class="text-sm text-stone-600">@T["Reports.Services.None"]</p>
        }
        else
        {
            <ol class="list-card">
                @foreach (var service in Model.TopServices)
                {
                    <li class="flex items-center justify-between gap-4 p-3" data-testid="top-service">
                        <span class="flex min-w-0 flex-col gap-0.5">
                            <span class="font-medium">@service.Name</span>
                            <span class="text-sm text-stone-600">@T.Format("Reports.Services.Visits", service.Visits)</span>
                        </span>
                        <span class="tabular-nums font-medium">@service.Value.ToDisplayString(culture)</span>
                    </li>
                }
            </ol>
        }
    </section>

    @if (Model.Retail.HasAny)
    {
        var retail = Model.Retail;
        <section class="@cardClass" data-testid="retail">
            <h2 class="text-lg font-semibold">@T["Reports.Retail.Title"]</h2>
            <p class="text-sm text-stone-600">@T["Reports.Retail.Hint"]</p>
            <dl class="@listClass">
                <dt>@T["Reports.Retail.Sold"]</dt>
                <dd class="text-right tabular-nums" data-testid="retail-sold">@retail.Sold.ToDisplayString(culture)</dd>
                @if (retail.HasReturns)
                {
                    <dt>@T["Reports.Retail.Returned"]</dt>
                    <dd class="text-right tabular-nums text-red-800" data-testid="retail-returned">@retail.ReturnedOut.ToDisplayString(culture)</dd>
                }
                <dt class="font-semibold">@T["Reports.Retail.Net"]</dt>
                <dd class="text-right font-bold tabular-nums" data-testid="retail-net">@retail.Net.ToDisplayString(culture)</dd>
                <dt class="border-t border-stone-200 pt-2">@T["Reports.Retail.Units"]</dt>
                <dd class="border-t border-stone-200 pt-2 text-right tabular-nums" data-testid="retail-units">@retail.Units</dd>
                <dt>@T["Reports.Retail.Bills"]</dt>
                <dd class="text-right tabular-nums" data-testid="retail-bills">@retail.Bills</dd>
                @if (retail.HasCounterSales)
                {
                    <dt>@T["Reports.Retail.CounterSales"]</dt>
                    <dd class="text-right tabular-nums" data-testid="retail-counter-sales">@retail.CounterSales</dd>
                }
                @if (retail.ShareOfTakings is { } share)
                {
                    <dt>
                        <span class="block font-semibold">@T["Reports.Retail.Share"]</span>
                        <span class="block text-sm text-stone-600">@T["Reports.Retail.ShareHint"]</span>
                    </dt>
                    <dd class="text-right font-bold tabular-nums" data-testid="retail-share">@ReportText.Percent(T, share, culture)</dd>
                }
                @if (retail.Profit is { } profit)
                {
                    <dt>
                        <span class="block font-semibold">@T["Reports.Retail.Profit"]</span>
                        <span class="block text-sm text-stone-600">@T["Reports.Retail.ProfitHint"]</span>
                    </dt>
                    <dd class="text-right font-bold tabular-nums" data-testid="retail-profit">@ReportText.Profit(T, profit, retail.ProfitShare, culture)</dd>
                }
            </dl>
            @if (retail.HasUnitsWithoutCost)
            {
                <p class="text-sm text-stone-600" data-testid="retail-without-cost">@T.Plural("Reports.Retail.WithoutCost", retail.UnitsWithoutCost)</p>
            }
            @if (retail.TopProducts.Count > 0)
            {
                <h3 class="@subheadClass">@T["Reports.Retail.Best"]</h3>
                <ol class="list-card">
                    @foreach (var product in retail.TopProducts)
                    {
                        <li class="flex items-center justify-between gap-4 p-3" data-testid="top-product">
                            <span class="flex min-w-0 flex-col gap-0.5">
                                <span class="font-medium">@product.Name</span>
                                <span class="text-sm text-stone-600">@T.Format("Reports.Retail.LineUnits", product.Units)</span>
                                @if (product.Profit is { } kept)
                                {
                                    <span class="text-sm text-stone-600" data-testid="top-product-profit">@T.Format("Reports.Retail.LineProfit", kept.ToDisplayString(culture))</span>
                                }
                            </span>
                            <span class="tabular-nums font-medium">@product.Value.ToDisplayString(culture)</span>
                        </li>
                    }
                </ol>
                @if (retail.HasMoreProducts)
                {
                    <p class="text-sm text-stone-600" data-testid="retail-more">@T.Format("Reports.Retail.More", retail.TopProducts.Count, retail.ProductCount)</p>
                }
            }
        </section>
    }

    <section class="@cardClass" data-testid="staff">
        <h2 class="text-lg font-semibold">@T["Reports.Staff.Title"]</h2>
        <p class="text-sm text-stone-600">@T["Reports.Staff.Hint"]</p>
        @if (Model.Staff.Count == 0)
        {
            <p class="text-sm text-stone-600">@T["Reports.Staff.None"]</p>
        }
        else
        {
            <ul class="list-card">
                @foreach (var person in Model.Staff)
                {
                    <li class="space-y-2 p-3" data-testid="staff-line">
                        <div class="flex items-center justify-between gap-4">
                            <span class="flex min-w-0 flex-col gap-0.5">
                                <span class="font-medium">@person.Name</span>
                                <span class="text-sm text-stone-600">@T.Format("Reports.Services.Visits", person.Visits)</span>
                            </span>
                            <span class="tabular-nums font-medium">@person.Value.ToDisplayString(culture)</span>
                        </div>
                        @if (person.HasRetail || person.HasCommission)
                        {
                            @* Products sold on the person's visits and their commission (ADR 0059). *@
                            <dl class="grid grid-cols-[1fr_auto] gap-x-4 gap-y-1 text-sm" data-testid="staff-pay">
                                @if (person.HasRetail)
                                {
                                    <dt>@T["Reports.Staff.Retail"]</dt>
                                    <dd class="text-right tabular-nums" data-testid="staff-retail">@person.Retail!.Value.ToDisplayString(culture)</dd>
                                }
                                @if (person.Commission is { } commission)
                                {
                                    <dt>@ReportText.CommissionLabel(T, person, culture)</dt>
                                    <dd class="text-right tabular-nums" data-testid="staff-commission">@commission.ToDisplayString(culture)</dd>
                                    <dt class="font-semibold">@T["Reports.Staff.AfterCommission"]</dt>
                                    <dd class="text-right font-semibold tabular-nums" data-testid="staff-after-commission">@person.AfterCommission!.Value.ToDisplayString(culture)</dd>
                                }
                            </dl>
                        }
                        @if (person.Utilisation is { } used)
                        {
                            <div class="flex items-center justify-between gap-4 text-sm">
                                <span>@T["Reports.Staff.Utilisation"]</span>
                                <span class="font-semibold tabular-nums" data-testid="utilisation">@ReportText.Percent(T, used, culture)</span>
                            </div>
                            <meter class="block h-3 w-full" min="0" max="100" value="@Math.Min(100m, used).ToString(CultureInfo.InvariantCulture)" aria-label="@T["Reports.Staff.Utilisation"]: @person.Name">@ReportText.Percent(T, used, culture)</meter>
                            <p class="text-sm text-stone-600" data-testid="staff-hours">@T.Format("Reports.Staff.Booked", ClockFormatter.MinutesAsHours(person.BookedMinutes, culture), ClockFormatter.MinutesAsHours(person.WorkingMinutes, culture))</p>
                        }
                        else
                        {
                            <p class="text-sm text-stone-600" data-testid="staff-hours">@T.Format("Reports.Staff.NoHours", ClockFormatter.MinutesAsHours(person.BookedMinutes, culture))</p>
                        }
                    </li>
                }
            </ul>
        }
    </section>
    </div>
</section>
