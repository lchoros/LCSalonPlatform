@using System.Globalization
@using Salon.Core.Payments
@using Salon.Web.Features.Payments.Vouchers
@model VoucherViewModel
@{
    var card = Model.Card;
    var voucher = card.Voucher;
    ViewData["Title"] = voucher.Code;
    var culture = CultureInfo.CurrentCulture;
    const string inputClass = "field field-compact";
    const string listClass = "grid grid-cols-[1fr_auto] gap-x-4 gap-y-2 text-base";
}
<section class="mx-auto max-w-xl space-y-6">
    <a href="@VouchersController.Path" class="back-link" data-testid="back">&larr; @T["Payments.Vouchers.Back"]</a>
    @if (Model.Flash is { } flash)
    {
        <p role="status" data-testid="flash" class="notice notice-ok">@flash</p>
    }
    @if (Model.Problem is { } problem)
    {
        <p role="alert" data-testid="voucher-problem" class="notice notice-error">@problem</p>
    }

    @* The voucher as it is handed over: the code is what the holder brings back. *@
    <div class="space-y-3 panel text-center" data-testid="voucher-face">
        <h1 class="text-sm font-medium uppercase tracking-wide text-stone-600">@T["Payments.Vouchers.Face.Title"]</h1>
        <p class="text-3xl font-bold tabular-nums tracking-widest" data-testid="voucher-code">@voucher.Code</p>
        <p class="text-2xl font-bold tabular-nums" data-testid="voucher-initial">@voucher.Initial.ToDisplayString(culture)</p>
        <p class="text-sm text-stone-600" data-testid="voucher-expiry">@VoucherText.Expiry(T, voucher, culture)</p>
        @if (voucher.Note is { } note)
        {
            <p class="text-stone-700" data-testid="voucher-note">@note</p>
        }
    </div>

    <section class="space-y-3 panel" data-testid="voucher-state">
        <h2 class="text-lg font-semibold">@VoucherText.Status(T, voucher, culture)</h2>
        <dl class="@listClass">
            <dt class="font-semibold">@T["Payments.Vouchers.Left"]</dt>
            <dd class="text-right font-bold tabular-nums" data-testid="voucher-left">@voucher.Left.ToDisplayString(culture)</dd>
            <dt>@T["Payments.Vouchers.SoldOn"]</dt>
            <dd class="text-right tabular-nums">@voucher.SoldOn.ToString("d", culture)</dd>
            <dt>@T["Payments.Vouchers.SoldWith"]</dt>
            <dd class="text-right">@T[$"Payments.Method.{card.SoldWith}"]</dd>
            <dt>@T["Payments.Vouchers.SoldBy"]</dt>
            <dd class="text-right">@(card.SoldByName ?? T["Payments.Fee.History.Unknown"])</dd>
        </dl>
    </section>

    <section class="space-y-3 panel" data-testid="voucher-uses">
        <h2 class="text-lg font-semibold">@T["Payments.Vouchers.Uses.Title"]</h2>
        @if (card.Uses.Count == 0)
        {
            <p class="text-sm text-stone-600" data-testid="no-uses">@T["Payments.Vouchers.Uses.None"]</p>
        }
        else
        {
            <ul class="list-card">
                @foreach (var use in card.Uses)
                {
                    <li class="flex items-center justify-between gap-4 p-3" data-testid="voucher-use">
                        <a href="@VouchersController.VisitPath(use.AppointmentId)" class="inline-flex min-h-11 min-w-0 flex-col justify-center underline underline-offset-2">
                            <span class="font-medium">@use.ClientName</span>
                            <span class="text-sm text-stone-600 tabular-nums">@use.At.Date.ToString("d", culture)</span>
                        </a>
                        <span class="tabular-nums font-medium">@use.Amount.ToDisplayString(culture)</span>
                    </li>
                }
            </ul>
        }
    </section>

    @if (card.CanRefund)
    {
        <details class="panel" data-testid="voucher-refund">
            <summary class="inline-flex min-h-11 cursor-pointer items-center font-medium underline underline-offset-2" data-testid="refund-open">@T["Payments.Vouchers.Refund.Open"]</summary>
            <form method="post" action="@VouchersController.RefundPath(voucher.Id)" asp-antiforgery="true" class="mt-3 space-y-3" data-testid="refund-form">
                <p class="text-sm text-stone-600">@T["Payments.Vouchers.Refund.Hint"]</p>
                <div class="space-y-1">
                    <label for="method" class="field-label">@T["Payments.Checkout.Products.Return.Method"]</label>
                    <select id="method" name="method" class="@inputClass" data-testid="refund-method">
                        @foreach (var method in GiftVoucherRules.PaymentMethods)
                        {
                            <option value="@method" selected="@(method == card.SoldWith)">@T[$"Payments.Method.{method}"]</option>
                        }
                    </select>
                </div>
                <button type="submit" class="btn btn-compact btn-danger w-full sm:w-auto" data-testid="refund-submit">@T.Format("Payments.Vouchers.Refund.Submit", voucher.Initial.ToDisplayString(culture))</button>
            </form>
        </details>
    }
</section>
