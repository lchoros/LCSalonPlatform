@using System.Globalization
@using NodaTime
@using NodaTime.Text
@using Salon.Core.Payments
@using Salon.Web.Features.Payments.VisitDeposit
@model VisitDepositViewModel
@{
    var visit = Model.Visit;
    var deposit = visit.Deposit;
    var culture = CultureInfo.CurrentCulture;
    var zone = visit.Start.Zone;
    var cardPath = "/admin/appointments/calendar/" + visit.AppointmentId;
    var depositPath = VisitDepositController.BasePath + "/" + visit.AppointmentId;
    ViewData["Title"] = T["Payments.Deposit.Title"];
    const string inputClass = "block w-full min-h-11 rounded-md border border-stone-300 bg-white px-3 py-2 text-base shadow-sm focus:border-stone-900 focus:outline-none focus:ring-1 focus:ring-stone-900";
    const string primaryClass = "inline-flex min-h-11 w-full items-center justify-center rounded-md bg-stone-900 px-4 py-2 text-base font-medium text-white hover:bg-stone-700 sm:w-auto";
    const string secondaryClass = "inline-flex min-h-11 w-full items-center justify-center rounded-md border border-stone-300 bg-white px-4 py-2 text-base font-medium hover:bg-stone-100 sm:w-auto";
    const string cardClass = "space-y-3 rounded-lg border border-stone-200 bg-white p-4 shadow-sm";
}
@functions {
    string When(Instant at, DateTimeZone zone) => at.InZone(zone).LocalDateTime.ToString("g", CultureInfo.CurrentCulture);
}
<section class="mx-auto max-w-lg space-y-6">
    <a href="@cardPath" data-testid="back" class="inline-flex min-h-11 items-center text-sm font-medium text-stone-700 hover:underline">&larr; @T["Payments.Deposit.Back"]</a>
    <h1 class="text-2xl font-bold tracking-tight sm:text-3xl">@T["Payments.Deposit.Title"]</h1>

    @if (Model.Flash is { } flash)
    {
        <p role="status" data-testid="flash" class="rounded-md border border-green-200 bg-green-50 p-3 text-sm text-green-800">@flash</p>
    }
    @if (Model.Error is { } error)
    {
        <p role="alert" data-testid="error" class="rounded-md border border-red-200 bg-red-50 p-3 text-sm text-red-700">@error</p>
    }

    <section class="@cardClass" data-testid="deposit-visit" data-status="@visit.Status">
        <div class="flex flex-wrap items-center justify-between gap-2">
            <h2 class="text-lg font-semibold"><a href="/admin/clients/@visit.ClientId" class="underline" data-testid="deposit-client">@visit.ClientName</a></h2>
            <span class="rounded bg-stone-100 px-1.5 py-0.5 text-xs font-medium text-stone-700" data-testid="deposit-visit-status">@T[$"Appointments.Status.{visit.Status}"]</span>
        </div>
        <dl class="grid grid-cols-[auto_1fr] gap-x-4 gap-y-2 text-base">
            <dt class="text-sm text-stone-600">@T["Payments.Fee.Visit.What"]</dt>
            <dd>@visit.ServiceName · @visit.StaffName</dd>
            <dt class="text-sm text-stone-600">@T["Payments.Fee.Visit.When"]</dt>
            <dd class="tabular-nums">@visit.Start.LocalDateTime.ToString("f", culture)</dd>
            <dt class="text-sm text-stone-600">@T["Payments.Fee.Visit.Price"]</dt>
            <dd class="tabular-nums">@visit.Price.ToDisplayString(culture)</dd>
            <dt class="text-sm text-stone-600">@T["Payments.Deposit.Due"]</dt>
            <dd class="tabular-nums" data-testid="deposit-due">@(visit.Due is { } due ? due.ToDisplayString(culture) : T["Payments.Deposit.NoneDue"])</dd>
        </dl>
    </section>

    @if (deposit is null && visit.IsActive)
    {
        <section class="@cardClass" data-testid="record-step">
            <h2 class="text-lg font-semibold">@T["Payments.Deposit.Record.Title"]</h2>
            <p class="text-sm text-stone-600">@T["Payments.Deposit.Record.Hint"]</p>
            <form method="post" action="@depositPath" asp-antiforgery="true" class="space-y-3" data-testid="record-deposit-form">
                <div class="space-y-1">
                    <label for="amount" class="block text-sm font-medium">@T.Format("Payments.Deposit.Amount", visit.Price.Currency)</label>
                    <input id="amount" name="amount" type="text" inputmode="decimal" value="@(visit.Due?.Amount.ToString("0.00", culture))" required aria-describedby="amount-hint" class="@inputClass tabular-nums" data-testid="deposit-amount" />
                    <p id="amount-hint" class="text-sm text-stone-600">@T.Format("Payments.Deposit.AmountHint", visit.Price.ToDisplayString(culture))</p>
                </div>
                <div class="space-y-1">
                    <label for="method" class="block text-sm font-medium">@T["Payments.Fee.Pay.Method"]</label>
                    <select id="method" name="method" class="@inputClass" data-testid="deposit-method">
                        @foreach (var method in Enum.GetValues<PaymentMethod>())
                        {
                            <option value="@method">@T[$"Payments.Method.{method}"]</option>
                        }
                    </select>
                </div>
                <button type="submit" class="@primaryClass" data-testid="record-deposit">@T["Payments.Deposit.Record.Submit"]</button>
            </form>
        </section>
    }
    else if (deposit is null)
    {
        <section class="@cardClass" data-testid="deposit-none">
            <p>@T["Payments.Deposit.NotActive"]</p>
        </section>
    }
    else
    {
        <section class="@cardClass" data-testid="deposit" data-held="@deposit.IsHeld.ToString().ToLowerInvariant()">
            <div class="flex flex-wrap items-center justify-between gap-2">
                <h2 class="text-lg font-semibold">@T["Payments.Deposit.Received.Title"]</h2>
                <span class="rounded px-1.5 py-0.5 text-xs font-medium @(deposit.IsHeld ? "bg-green-100 text-green-900" : "bg-stone-200 text-stone-800")" data-testid="deposit-status">@T[deposit.IsHeld ? "Payments.Deposit.Status.Held" : "Payments.Deposit.Status.Returned"]</span>
            </div>
            <p class="text-2xl font-bold tabular-nums" data-testid="deposit-amount-received">@deposit.Amount.ToDisplayString(culture)</p>

            <h3 class="text-sm font-medium text-stone-600">@T["Payments.Fee.History"]</h3>
            <ol class="space-y-2 text-sm" data-testid="deposit-history">
                <li data-testid="deposit-history-received">
                    <time datetime="@InstantPattern.ExtendedIso.Format(deposit.At)" class="tabular-nums text-stone-600">@When(deposit.At, zone)</time>
                    <span class="block">@T.Format("Payments.Deposit.History.Received", T[$"Payments.Method.{deposit.Method}"], deposit.ByName ?? T["Payments.Fee.History.Unknown"])</span>
                    <span class="block break-all text-stone-600" data-testid="deposit-reference">@T.Format("Payments.Fee.History.Reference", deposit.ProviderReference ?? "—")</span>
                </li>
                @if (deposit.Return is { } returned)
                {
                    <li data-testid="deposit-history-returned">
                        <time datetime="@InstantPattern.ExtendedIso.Format(returned.At)" class="tabular-nums text-stone-600">@When(returned.At, zone)</time>
                        <span class="block">@T.Format("Payments.Deposit.History.Returned", T[$"Payments.Method.{returned.Method}"], returned.ByName ?? T["Payments.Fee.History.Unknown"])</span>
                        <span class="block break-all text-stone-600" data-testid="deposit-return-reference">@T.Format("Payments.Fee.History.Reference", returned.ProviderReference ?? "—")</span>
                    </li>
                }
            </ol>
        </section>

        @if (deposit.IsHeld)
        {
            <section class="@cardClass" data-testid="return-step">
                <h2 class="text-lg font-semibold">@T["Payments.Deposit.Return.Title"]</h2>
                <p class="text-sm text-stone-600">@T["Payments.Deposit.Return.Hint"]</p>
                <form method="post" action="@depositPath/return" asp-antiforgery="true" class="space-y-3" data-testid="return-deposit-form">
                    <div class="space-y-1">
                        <label for="method" class="block text-sm font-medium">@T["Payments.Deposit.Return.Method"]</label>
                        <select id="method" name="method" class="@inputClass" data-testid="return-method">
                            @foreach (var method in Enum.GetValues<PaymentMethod>())
                            {
                                <option value="@method">@T[$"Payments.Method.{method}"]</option>
                            }
                        </select>
                    </div>
                    <button type="submit" class="@secondaryClass" data-testid="return-deposit">@T.Format("Payments.Deposit.Return.Submit", deposit.Amount.ToDisplayString(culture))</button>
                </form>
            </section>
        }
    }
</section>
