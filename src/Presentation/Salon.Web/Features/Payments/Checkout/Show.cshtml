@using System.Globalization
@using NodaTime
@using NodaTime.Text
@using Salon.Core.Appointments
@using Salon.Core.Payments
@using Salon.Web.Features.Payments.Checkout
@model CheckoutViewModel
@{
    var bill = Model.Bill;
    var culture = CultureInfo.CurrentCulture;
    var zone = bill.Start.Zone;
    ViewData["Title"] = T["Payments.Checkout.Title"];
    const string inputClass = "field field-compact";
    const string primaryClass = "btn btn-compact btn-primary w-full sm:w-auto";
    const string secondaryClass = "btn btn-compact btn-secondary w-full sm:w-auto";
    const string cardClass = "space-y-3 panel";
}
<section class="mx-auto max-w-lg space-y-6">
    <a href="@Model.DayPath" data-testid="back" class="back-link">&larr; @T["Payments.Fee.Back"]</a>
    <h1 class="page-title">@T["Payments.Checkout.Title"]</h1>

    @if (Model.Flash is { } flash)
    {
        <p role="status" data-testid="flash" class="notice notice-ok">@flash</p>
    }
    @if (Model.Error is { } error)
    {
        <p role="alert" data-testid="error" class="notice notice-error">@error</p>
    }

    <section class="@cardClass" data-testid="bill" data-status="@bill.Status">
        <div class="flex flex-wrap items-center justify-between gap-2">
            <h2 class="text-lg font-semibold"><a href="/admin/clients/@bill.ClientId" class="underline" data-testid="bill-client">@bill.ClientName</a></h2>
            <span class="rounded bg-stone-100 px-1.5 py-0.5 text-xs font-medium text-stone-700" data-testid="bill-visit-status">@T[$"Appointments.Status.{bill.Status}"]</span>
        </div>
        <p class="text-sm text-stone-600">@bill.ServiceName · @bill.StaffName · <span class="tabular-nums">@bill.Start.LocalDateTime.ToString("g", culture)</span></p>
        <dl class="grid grid-cols-[1fr_auto] gap-x-4 gap-y-2 text-base">
            <dt>@bill.ServiceName</dt>
            <dd class="text-right tabular-nums" data-testid="bill-price">@bill.Price.ToDisplayString(culture)</dd>
            @if (bill.DepositHeld is { } deposit)
            {
                <dt>@T["Payments.Checkout.Deposit"]</dt>
                <dd class="text-right tabular-nums" data-testid="bill-deposit">−@deposit.ToDisplayString(culture)</dd>
            }
            @if (bill.Payment is { } paid)
            {
                <dt>@T.Format("Payments.Checkout.PaidWith", T[$"Payments.Method.{paid.Method}"])</dt>
                <dd class="text-right tabular-nums" data-testid="bill-paid">−@paid.Amount.ToDisplayString(culture)</dd>
            }
        </dl>
        @if (bill.Products.Count > 0)
        {
            @* Products rung up on this bill (ADR 0037): an unpaid line can still be taken off, a paid one says how it was paid. *@
            <ul class="space-y-2 border-t border-stone-200 pt-2" data-testid="bill-products">
                @foreach (var line in bill.Products)
                {
                    <li class="flex flex-wrap items-center justify-between gap-3" data-testid="bill-product" data-paid="@line.IsPaid.ToString().ToLowerInvariant()">
                        <span class="min-w-0 flex-1">
                            <span class="block" data-testid="bill-product-name">@T.Format("Payments.Checkout.Products.Line", line.Name, line.Quantity)</span>
                            @if (line.IsPaid)
                            {
                                <span class="block text-sm text-stone-600" data-testid="bill-product-paid">@T.Format("Payments.Checkout.PaidWith", line.PaidWith is { } paidWith ? T[$"Payments.Method.{paidWith}"] : "—")</span>
                            }
                            @if (line.Returned > 0)
                            {
                                <span class="block text-sm font-medium text-amber-900" data-testid="bill-product-returned">@T.Format("Payments.Checkout.Products.ReturnedCount", line.Returned)</span>
                            }
                        </span>
                        <span class="tabular-nums @(line.IsPaid ? "text-stone-500" : null)" data-testid="bill-product-total">@line.Total.ToDisplayString(culture)</span>
                        @if (!line.IsPaid)
                        {
                            <form method="post" action="@CheckoutController.RemoveProductPath(bill.AppointmentId, line.LineId)" asp-antiforgery="true">
                                <button type="submit" class="btn btn-compact btn-secondary px-3" data-testid="remove-product">@T["Payments.Checkout.Products.Remove"]<span class="sr-only">: @line.Name</span></button>
                            </form>
                        }
                        @if (line.IsPaid && line.Kept > 0)
                        {
                            @* A return (ADR 0040) sits behind a disclosure so it is never one stray tap away from the bill. *@
                            var returnId = "return-" + line.LineId.ToString("N");
                            <details class="basis-full" data-testid="return-product">
                                <summary class="inline-flex min-h-11 cursor-pointer items-center text-sm font-medium underline underline-offset-2" data-testid="return-open">@T["Payments.Checkout.Products.Return.Open"]<span class="sr-only">: @line.Name</span></summary>
                                <form method="post" action="@CheckoutController.ReturnProductPath(bill.AppointmentId, line.LineId)" asp-antiforgery="true" class="mt-2 space-y-3 rounded-md bg-stone-50 p-3" data-testid="return-form">
                                    <div class="grid gap-3 sm:grid-cols-2">
                                        <div class="space-y-1">
                                            <label for="@(returnId)-quantity" class="field-label">@T["Payments.Checkout.Products.Return.Quantity"]</label>
                                            <input id="@(returnId)-quantity" name="quantity" type="number" inputmode="numeric" min="1" max="@line.Kept" step="1" value="1" required class="@inputClass" data-testid="return-quantity" />
                                        </div>
                                        <div class="space-y-1">
                                            <label for="@(returnId)-method" class="field-label">@T["Payments.Checkout.Products.Return.Method"]</label>
                                            <select id="@(returnId)-method" name="method" class="@inputClass" data-testid="return-method">
                                                @foreach (var method in Enum.GetValues<PaymentMethod>())
                                                {
                                                    <option value="@method">@T[$"Payments.Method.{method}"]</option>
                                                }
                                            </select>
                                        </div>
                                    </div>
                                    <label for="@(returnId)-shelf" class="flex min-h-11 items-center gap-3">
                                        <input id="@(returnId)-shelf" name="backOnShelf" type="checkbox" value="true" checked class="size-5 shrink-0 rounded border-stone-400" data-testid="return-back-on-shelf" />
                                        <span class="text-sm">@T["Payments.Checkout.Products.Return.BackOnShelf"]</span>
                                    </label>
                                    <p class="text-sm text-stone-600">@T["Payments.Checkout.Products.Return.Hint"]</p>
                                    <button type="submit" class="btn btn-compact btn-danger w-full sm:w-auto" data-testid="return-submit">@T["Payments.Checkout.Products.Return.Submit"]</button>
                                </form>
                            </details>
                        }
                    </li>
                }
            </ul>
        }
        <p class="flex items-baseline justify-between gap-4 border-t border-stone-200 pt-2">
            <span class="font-semibold">@T["Payments.Checkout.Outstanding"]</span>
            <span class="text-xl font-bold tabular-nums" data-testid="bill-outstanding">@bill.ToPay.ToDisplayString(culture)</span>
        </p>
        @if (bill.Payment is { } payment)
        {
            <p class="text-sm text-stone-600" data-testid="bill-payment">
                <time datetime="@payment.At.ToIso()" class="tabular-nums">@payment.At.ToShortDateTime(zone, culture)</time>
                · @T.Format("Payments.Checkout.RecordedBy", payment.ByName ?? T["Payments.Fee.History.Unknown"])
                <span class="block break-all" data-testid="bill-reference">@T.Format("Payments.Fee.History.Reference", payment.ProviderReference ?? "—")</span>
            </p>
        }
    </section>

    @if (Model.Sellable.Count > 0)
    {
        <section class="@cardClass" data-testid="add-product-step">
            <h2 class="text-lg font-semibold">@T["Payments.Checkout.Products.Title"]</h2>
            <form method="post" action="@CheckoutController.ProductsPath(bill.AppointmentId)" asp-antiforgery="true" class="space-y-3" data-testid="add-product-form">
                <div class="grid gap-3 sm:grid-cols-[1fr_6rem]">
                    <div class="space-y-1">
                        <label for="product" class="field-label">@T["Payments.Checkout.Products.Product"]</label>
                        <select id="product" name="product" class="@inputClass" data-testid="bill-product-select">
                            @foreach (var product in Model.Sellable)
                            {
                                <option value="@product.Id">@T.Format("Payments.Checkout.Products.Option", product.Name, product.Price.ToDisplayString(culture))</option>
                            }
                        </select>
                    </div>
                    <div class="space-y-1">
                        <label for="quantity" class="field-label">@T["Payments.Checkout.Products.Quantity"]</label>
                        <input id="quantity" name="quantity" type="number" inputmode="numeric" min="1" max="@ProductSaleRules.MaxQuantity" step="1" value="1" required class="@inputClass" data-testid="bill-product-quantity" />
                    </div>
                </div>
                <p class="text-sm text-stone-600">@T["Payments.Checkout.Products.Hint"]</p>
                <button type="submit" class="@secondaryClass" data-testid="add-product">@T["Payments.Checkout.Products.Add"]</button>
            </form>
        </section>
    }

    @if (!bill.CanPay)
    {
        <section class="@cardClass" data-testid="not-payable">
            @if (AppointmentStateMachine.IsActive(bill.Status))
            {
                <p>@T["Payments.Checkout.NotArrived"]</p>
                <a href="/admin/appointments/calendar/@bill.AppointmentId" class="@secondaryClass" data-testid="open-visit">@T["Payments.Checkout.OpenVisit"]</a>
            }
            else
            {
                <p>@T["Payments.Checkout.DidNotTakePlace"]</p>
                <a href="/admin/payments/fees/@bill.AppointmentId" class="@secondaryClass" data-testid="open-fee">@T["Payments.Checkout.OpenFee"]</a>
            }
        </section>
    }
    else if (bill.HasSomethingToPay)
    {
        <section class="@cardClass" data-testid="pay-step">
            <h2 class="text-lg font-semibold">@T["Payments.Checkout.Pay.Title"]</h2>
            <form method="post" action="@Model.PayPath" asp-antiforgery="true" class="space-y-4" data-testid="pay-bill-form">
                @if (bill.OpenFees.Count > 0)
                {
                    <fieldset class="space-y-2" data-testid="open-fees">
                        <legend class="text-sm font-medium">@T["Payments.Checkout.Fees.Legend"]</legend>
                        <p class="text-sm text-stone-600">@T["Payments.Checkout.Fees.Hint"]</p>
                        @foreach (var fee in bill.OpenFees)
                        {
                            var feeId = "fee-" + fee.AppointmentId;
                            <label for="@feeId" class="flex min-h-11 items-center gap-3 rounded-md border border-stone-200 px-3 py-2" data-testid="open-fee-row">
                                <input id="@feeId" name="fees" type="checkbox" value="@fee.AppointmentId" checked class="size-5 shrink-0 rounded border-stone-400" />
                                <span class="min-w-0 flex-1">
                                    <span class="block font-medium">@T[$"Payments.Fee.Kind.{fee.Kind}"]</span>
                                    <span class="block text-sm text-stone-600">@fee.ServiceName · <span class="tabular-nums">@fee.AppointmentStart.Date.ToString("d", culture)</span></span>
                                </span>
                                <span class="tabular-nums">@fee.Amount.ToDisplayString(culture)</span>
                            </label>
                        }
                    </fieldset>
                    <p class="flex items-baseline justify-between gap-4 rounded-md bg-stone-50 p-3" data-testid="bill-total">
                        <span class="text-sm text-stone-700">@T["Payments.Checkout.TotalWithFees"]</span>
                        <span class="text-xl font-bold tabular-nums">@bill.ToPayWithFees.ToDisplayString(culture)</span>
                    </p>
                }
                <div class="space-y-1">
                    <label for="method" class="field-label">@T["Payments.Fee.Pay.Method"]</label>
                    <select id="method" name="method" class="@inputClass" data-testid="bill-method">
                        @foreach (var method in Enum.GetValues<PaymentMethod>())
                        {
                            <option value="@method">@T[$"Payments.Method.{method}"]</option>
                        }
                    </select>
                </div>
                <p class="text-sm text-stone-600">@T["Payments.Checkout.Pay.Hint"]</p>
                <button type="submit" class="@primaryClass" data-testid="pay-bill">@T["Payments.Checkout.Pay.Submit"]</button>
            </form>
        </section>
    }
    else
    {
        <section class="@cardClass" data-testid="bill-settled">
            <p class="font-medium">@T[bill.Payment is null ? "Payments.Checkout.CoveredByDeposit" : "Payments.Checkout.Settled"]</p>
            <a href="@Model.TillPath" class="@secondaryClass" data-testid="open-cash-up">@T["Payments.Checkout.OpenCashUp"]</a>
        </section>
    }

    @if (Model.Rebook.Count > 0)
    {
        @* The next visit (ADR 0039): same service, same person, one tap to the booking form on the right day. *@
        <section class="@cardClass" data-testid="rebook-step">
            <h2 class="text-lg font-semibold">@T["Payments.Checkout.Rebook.Title"]</h2>
            <p class="text-sm text-stone-600">@T.Format("Payments.Checkout.Rebook.Lead", bill.ServiceName, bill.StaffName)</p>
            <ul class="grid gap-2 sm:grid-cols-3">
                @foreach (var choice in Model.Rebook)
                {
                    <li>
                        <a href="@choice.Url" class="btn btn-compact btn-secondary flex w-full flex-col py-2 leading-tight" data-testid="rebook-choice" data-weeks="@choice.Weeks">
                            <span>@T.Plural("Payments.Checkout.Rebook.Weeks", choice.Weeks)</span>
                            <span class="text-xs font-normal text-stone-600">@choice.Day.ToString("ddd d MMM", culture)</span>
                        </a>
                    </li>
                }
            </ul>
        </section>
    }
</section>
