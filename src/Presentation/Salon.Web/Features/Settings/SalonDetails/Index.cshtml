@using Salon.Core.Locations
@using Salon.Web.Features.Settings.SalonDetails
@model SalonDetailsViewModel
@{
    ViewData["Title"] = T["Settings.SalonDetails.Title"];
    const string inputClass = "block w-full min-h-11 rounded-md border border-stone-300 px-3 py-2 text-base shadow-sm focus:border-stone-900 focus:outline-none focus:ring-1 focus:ring-stone-900 aria-[invalid=true]:border-red-600";
    const string buttonClass = "inline-flex min-h-11 w-full items-center justify-center rounded-md bg-stone-900 px-4 py-2 text-base font-medium text-white hover:bg-stone-700 sm:w-auto";
    var form = Model.Form;
}
@functions {
    IReadOnlyList<string> Errors(string key)
        => ViewData.ModelState.TryGetValue(key, out var entry) ? entry.Errors.Select(e => e.ErrorMessage).ToList() : [];
}
<section class="mx-auto max-w-xl space-y-6">
    <partial name="_SettingsNav" model="@("salon-details")" />
    <header class="space-y-2">
        <h1 class="text-2xl font-bold tracking-tight">@T["Settings.SalonDetails.Title"]</h1>
        <p class="text-stone-600">@T["Settings.SalonDetails.Lead"]</p>
    </header>

    @if (Model.Flash is { } flash)
    {
        <p role="status" data-testid="flash" class="rounded-md border border-green-200 bg-green-50 p-3 text-sm text-green-800">@flash</p>
    }

    <form method="post" asp-action="Index" class="space-y-5 rounded-lg border border-stone-200 bg-white p-4 shadow-sm" novalidate data-testid="salon-details-form">
        @foreach (var (name, labelKey, hintKey, value, max, type, autocomplete, required) in new (string, string, string?, string?, int, string, string, bool)[]
        {
            ("AddressLine1", "Settings.SalonDetails.AddressLine1", null, form.AddressLine1, Location.AddressLineMaxLength, "text", "address-line1", true),
            ("AddressLine2", "Settings.SalonDetails.AddressLine2", null, form.AddressLine2, Location.AddressLineMaxLength, "text", "address-line2", false),
            ("City", "Settings.SalonDetails.City", null, form.City, Location.CityMaxLength, "text", "address-level2", true),
            ("Postcode", "Settings.SalonDetails.Postcode", null, form.Postcode, Location.PostcodeMaxLength, "text", "postal-code", true),
            ("Phone", "Settings.SalonDetails.Phone", "Settings.SalonDetails.PhoneHint", form.Phone, Location.PhoneMaxLength, "tel", "tel", false),
            ("Email", "Settings.SalonDetails.Email", null, form.Email, Location.EmailMaxLength, "email", "email", false),
            ("Name", "Settings.SalonDetails.Name", "Settings.SalonDetails.NameHint", form.Name, Location.NameMaxLength, "text", "organization", false),
        })
        {
            var errors = Errors(name);
            var errorId = name + "-error";
            var hintId = name + "-hint";
            <div class="space-y-1">
                <label for="@name" class="block text-sm font-medium">@T[labelKey]</label>
                <input id="@name" name="@name" type="@type" value="@value" maxlength="@max" autocomplete="@autocomplete" required="@required"
                       aria-describedby="@(hintKey is null ? errorId : hintId + " " + errorId)" aria-invalid="@(errors.Count > 0 ? "true" : "false")" class="@inputClass" data-testid="@name" />
                @if (hintKey is not null)
                {
                    <p id="@hintId" class="text-sm text-stone-600">@T[hintKey]</p>
                }
                <p id="@errorId" class="text-sm text-red-700" data-testid="@errorId">@string.Join(" ", errors)</p>
            </div>
        }

        <button type="submit" class="@buttonClass" data-testid="save-salon-details">@T["Settings.SalonDetails.Submit"]</button>
    </form>
</section>
