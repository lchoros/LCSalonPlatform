@using Salon.Web.Features.Settings.PublicWaitlist
@model PublicWaitlistViewModel
@{
    ViewData["Title"] = T["Settings.Waitlist.Title"];
    const string buttonClass = "btn btn-compact btn-primary w-full sm:w-auto";
}
<section class="mx-auto max-w-xl space-y-6">
    <partial name="_SettingsNav" model="@("waitlist")" />
    <header class="space-y-2">
        <h1 class="page-title">@T["Settings.Waitlist.Title"]</h1>
        <p class="text-stone-600">@T["Settings.Waitlist.Lead"]</p>
    </header>

    @if (Model.Flash is { } flash)
    {
        <p role="status" data-testid="flash" class="notice notice-ok">@flash</p>
    }

    <form method="post" asp-action="Index" class="space-y-6 panel" novalidate data-testid="public-waitlist-form">
        <div class="space-y-1">
            <label class="flex min-h-11 items-center gap-3">
                <input id="Enabled" name="Enabled" type="checkbox" value="true" checked="@Model.Form.Enabled" aria-describedby="waitlist-hint" data-testid="public-waitlist-enabled" class="size-5 shrink-0 rounded border-stone-400" />
                <span class="font-medium">@T["Settings.Waitlist.Enabled"]</span>
            </label>
            <p id="waitlist-hint" class="text-sm text-stone-600">@T["Settings.Waitlist.Hint"]</p>
        </div>
        <div class="space-y-1">
            <label class="flex min-h-11 items-center gap-3">
                <input id="TellWhenFreed" name="TellWhenFreed" type="checkbox" value="true" checked="@Model.Form.TellWhenFreed" aria-describedby="tell-hint" data-testid="tell-when-freed" class="size-5 shrink-0 rounded border-stone-400" />
                <span class="font-medium">@T["Settings.Waitlist.TellWhenFreed"]</span>
            </label>
            <p id="tell-hint" class="text-sm text-stone-600">@T["Settings.Waitlist.TellWhenFreedHint"]</p>
        </div>
        <button type="submit" class="@buttonClass" data-testid="save-public-waitlist">@T["Settings.Waitlist.Submit"]</button>
    </form>

    <section class="space-y-2 rounded-md bg-stone-50 p-4 text-sm text-stone-700" data-testid="waitlist-notes">
        <h2 class="font-semibold">@T["Settings.Waitlist.Notes.Title"]</h2>
        <ul class="list-disc space-y-1 pl-5">
            <li>@T["Settings.Waitlist.Notes.Checked"]</li>
            <li>@T["Settings.Waitlist.Notes.Desk"]</li>
            <li>@T["Settings.Waitlist.Notes.Texts"]</li>
            <li>@T["Settings.Waitlist.Notes.NoMarketplace"]</li>
        </ul>
        <p><a href="@PublicWaitlistController.ListPath" class="font-medium underline underline-offset-2" data-testid="to-waitlist">@T["Settings.Waitlist.ToList"]</a></p>
    </section>
</section>
