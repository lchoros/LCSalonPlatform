@using Salon.Core.Messaging
@using Salon.Web.Features.Settings.MessageTemplates
@model MessageTemplateEditViewModel
@{
    var details = Model.Details;
    var isEmail = details.Channel == MessageChannel.Email;
    var name = T[$"Settings.Messages.Name.{details.Key}"];
    var channel = T[$"Settings.Messages.Channel.{details.Channel}"];
    var path = MessageTemplatesController.EditPath(details.Key, details.Channel);
    ViewData["Title"] = $"{name} · {channel}";
    const string inputClass = "block w-full min-h-11 rounded-md border border-stone-300 px-3 py-2 text-base shadow-sm focus:border-stone-900 focus:outline-none focus:ring-1 focus:ring-stone-900 aria-[invalid=true]:border-red-600";
    const string primaryClass = "inline-flex min-h-11 w-full items-center justify-center rounded-md bg-stone-900 px-4 py-2 text-base font-medium text-white hover:bg-stone-700 sm:w-auto";
    const string secondaryClass = "inline-flex min-h-11 w-full items-center justify-center rounded-md border border-stone-300 bg-white px-4 py-2 text-base font-medium hover:bg-stone-100 sm:w-auto";
    const string cardClass = "space-y-3 rounded-lg border border-stone-200 bg-white p-4 shadow-sm";
    var subjectErrors = Errors("Subject");
    var bodyErrors = Errors("Body");
}
@functions {
    IReadOnlyList<string> Errors(string key)
        => ViewData.ModelState.TryGetValue(key, out var entry) ? entry.Errors.Select(e => e.ErrorMessage).ToList() : [];
}
<section class="mx-auto max-w-xl space-y-6">
    <partial name="_SettingsNav" model="@("messages")" />
    <header class="space-y-2">
        <a href="@MessageTemplatesController.Path" data-testid="back-to-messages" class="inline-flex min-h-11 items-center text-sm font-medium underline underline-offset-2">&larr; @T["Settings.Messages.Back"]</a>
        <h1 class="text-2xl font-bold tracking-tight">@name <span class="font-normal text-stone-600">· @channel</span></h1>
        <p class="text-stone-600">@T[$"Settings.Messages.When.{details.Key}"]</p>
        <p><span class="rounded px-1.5 py-0.5 text-xs font-medium @(details.IsOwn ? "bg-green-100 text-green-900" : "bg-stone-100 text-stone-800")" data-testid="status">@T[details.IsOwn ? "Settings.Messages.Own" : "Settings.Messages.Standard"]</span></p>
    </header>

    @if (Model.Flash is { } flash)
    {
        <p role="status" data-testid="flash" class="rounded-md border border-green-200 bg-green-50 p-3 text-sm text-green-800">@flash</p>
    }

    <form method="post" action="@path" asp-antiforgery="true" class="@cardClass" novalidate data-testid="message-form">
        @if (isEmail)
        {
            <div class="space-y-1">
                <label for="subject" class="block text-sm font-medium">@T["Settings.Messages.Subject"]</label>
                <input id="subject" name="subject" type="text" value="@Model.Subject" maxlength="@MessageTemplateRules.SubjectMaxLength" required
                       aria-describedby="subject-error" aria-invalid="@(subjectErrors.Count > 0 ? "true" : "false")" class="@inputClass" data-testid="subject" />
                <p id="subject-error" class="text-sm text-red-700" data-testid="subject-error">@string.Join(" ", subjectErrors)</p>
            </div>
        }
        <div class="space-y-1">
            <label for="body" class="block text-sm font-medium">@T["Settings.Messages.Body"]</label>
            <textarea id="body" name="body" rows="@(isEmail ? 9 : 5)" maxlength="@MessageTemplateRules.BodyMaxLength(details.Channel)" required
                      aria-describedby="placeholders-hint body-error" aria-invalid="@(bodyErrors.Count > 0 ? "true" : "false")" class="@inputClass" data-testid="body">@Model.Body</textarea>
            <p id="body-error" class="text-sm text-red-700" data-testid="body-error">@string.Join(" ", bodyErrors)</p>
        </div>

        <div class="space-y-2 rounded-md bg-stone-50 p-3" data-testid="placeholders">
            <h2 class="text-sm font-semibold">@T["Settings.Messages.Placeholders"]</h2>
            <p id="placeholders-hint" class="text-sm text-stone-600">@T["Settings.Messages.PlaceholdersHint"]</p>
            <dl class="grid grid-cols-1 gap-x-4 gap-y-1 text-sm sm:grid-cols-[auto_1fr]">
                @foreach (var token in details.Placeholders)
                {
                    <dt><code class="rounded bg-white px-1 py-0.5 font-mono">@("{{" + token + "}}")</code></dt>
                    <dd class="text-stone-700">@T[$"Settings.Messages.Token.{token}"]@if (details.Required.Contains(token)) {<span class="font-medium">, @T["Settings.Messages.Required"]</span>}</dd>
                }
            </dl>
        </div>

        <div class="flex flex-col gap-2 sm:flex-row">
            <button type="submit" class="@primaryClass" data-testid="save-message">@T["Settings.Messages.Save"]</button>
            <button type="submit" formaction="@(path + "/preview")" class="@secondaryClass" data-testid="preview-message">@T["Settings.Messages.Preview"]</button>
        </div>
    </form>

    <section class="@cardClass" data-testid="preview" aria-labelledby="preview-title">
        <h2 id="preview-title" class="text-lg font-semibold">@T["Settings.Messages.PreviewTitle"]</h2>
        <p class="text-sm text-stone-600">@T["Settings.Messages.PreviewHint"]</p>
        @if (Model.Unsaved)
        {
            <p role="status" class="rounded-md border border-amber-300 bg-amber-50 p-3 text-sm text-amber-900" data-testid="preview-unsaved">@T["Settings.Messages.PreviewUnsaved"]</p>
        }
        @if (Model.Preview.Subject is { } previewSubject)
        {
            <p class="font-semibold" data-testid="preview-subject">@previewSubject</p>
        }
        <p class="whitespace-pre-line break-words rounded-md bg-stone-50 p-3" data-testid="preview-body">@Model.Preview.Body</p>
        @if (Model.Preview.Length is { } length)
        {
            <p class="text-sm text-stone-700" data-testid="preview-length" data-segments="@length.Segments">@T.Format("Settings.Messages.Length", length.Segments, length.Characters)</p>
            @if (length.IsUnicode)
            {
                <p class="text-sm text-amber-900" data-testid="preview-unicode">@T["Settings.Messages.LengthUnicode"]</p>
            }
        }
    </section>

    @if (details.IsOwn)
    {
        <section class="@cardClass" data-testid="standard" aria-labelledby="standard-title">
            <h2 id="standard-title" class="text-lg font-semibold">@T["Settings.Messages.Standard"]</h2>
            @if (details.StandardSubject is { } standardSubject)
            {
                <p class="font-semibold">@standardSubject</p>
            }
            <p class="whitespace-pre-line break-words rounded-md bg-stone-50 p-3 text-sm" data-testid="standard-body">@details.StandardBody</p>
            <form method="post" action="@(path + "/reset")" asp-antiforgery="true" class="space-y-2" data-testid="reset-form">
                <p class="text-sm text-stone-600">@T["Settings.Messages.ResetHint"]</p>
                <button type="submit" class="@secondaryClass" data-testid="reset-message">@T["Settings.Messages.Reset"]</button>
            </form>
        </section>
    }
</section>
