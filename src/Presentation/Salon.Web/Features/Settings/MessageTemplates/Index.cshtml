@using Salon.Core.Messaging
@using Salon.Web.Features.Settings.MessageTemplates
@model MessageTemplateListViewModel
@{
    ViewData["Title"] = T["Settings.Messages.Title"];
}
<section class="mx-auto max-w-xl space-y-6">
    <partial name="_SettingsNav" model="@("messages")" />
    <header class="space-y-2">
        <h1 class="text-2xl font-bold tracking-tight">@T["Settings.Messages.Title"]</h1>
        <p class="text-stone-600">@T["Settings.Messages.Lead"]</p>
    </header>

    @if (Model.Flash is { } flash)
    {
        <p role="status" data-testid="flash" class="rounded-md border border-green-200 bg-green-50 p-3 text-sm text-green-800">@flash</p>
    }

    <ul class="space-y-4" data-testid="message-list">
        @foreach (var message in Model.Rows.GroupBy(r => r.Key))
        {
            var name = T[$"Settings.Messages.Name.{message.Key}"];
            <li class="space-y-3 rounded-lg border border-stone-200 bg-white p-4 shadow-sm" data-testid="message" data-key="@message.Key">
                <div class="space-y-1">
                    <h2 class="text-lg font-semibold">@name</h2>
                    <p class="text-sm text-stone-600">@T[$"Settings.Messages.When.{message.Key}"]</p>
                </div>
                <ul class="divide-y divide-stone-200 rounded-md border border-stone-200">
                    @foreach (var row in message)
                    {
                        var channel = T[$"Settings.Messages.Channel.{row.Channel}"];
                        <li class="flex items-center justify-between gap-3 px-3">
                            <a href="@MessageTemplatesController.EditPath(row.Key, row.Channel)" data-testid="edit-@row.Key-@row.Channel" class="inline-flex min-h-11 items-center font-medium underline underline-offset-2">@channel<span class="sr-only">: @name</span></a>
                            <span class="rounded px-1.5 py-0.5 text-xs font-medium @(row.IsOwn ? "bg-green-100 text-green-900" : "bg-stone-100 text-stone-800")" data-testid="status-@row.Key-@row.Channel">@T[row.IsOwn ? "Settings.Messages.Own" : "Settings.Messages.Standard"]</span>
                        </li>
                    }
                </ul>
            </li>
        }
    </ul>
</section>
