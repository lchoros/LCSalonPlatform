@using Salon.Core.Settings
@using Salon.Web.Features.Settings.CancellationPolicy
@model CancellationPolicyViewModel
@{
    ViewData["Title"] = T["Settings.CancellationPolicy.Title"];
    const string inputClass = "block w-full min-h-11 rounded-md border border-stone-300 px-3 py-2 text-base tabular-nums shadow-sm focus:border-stone-900 focus:outline-none focus:ring-1 focus:ring-stone-900 aria-[invalid=true]:border-red-600";
    const string buttonClass = "inline-flex min-h-11 w-full items-center justify-center rounded-md bg-stone-900 px-4 py-2 text-base font-medium text-white hover:bg-stone-700 sm:w-auto";
    var form = Model.Form;
}
@functions {
    IReadOnlyList<string> Errors(string key)
        => ViewData.ModelState.TryGetValue(key, out var entry) ? entry.Errors.Select(e => e.ErrorMessage).ToList() : [];
}
<section class="mx-auto max-w-xl space-y-6">
    <partial name="_SettingsNav" model="@("cancellation-policy")" />
    <header class="space-y-2">
        <h1 class="text-2xl font-bold tracking-tight">@T["Settings.CancellationPolicy.Title"]</h1>
        <p class="text-stone-600">@T["Settings.CancellationPolicy.Lead"]</p>
    </header>

    @if (Model.Flash is { } flash)
    {
        <p role="status" data-testid="flash" class="rounded-md border border-green-200 bg-green-50 p-3 text-sm text-green-800">@flash</p>
    }

    <form method="post" asp-action="Index" class="space-y-6 rounded-lg border border-stone-200 bg-white p-4 shadow-sm" novalidate data-testid="cancellation-policy-form">
        @foreach (var (name, labelKey, hintKey, value, max) in new[]
        {
            ("FreeChangeHours", "Settings.CancellationPolicy.FreeChangeHours", "Settings.CancellationPolicy.FreeChangeHoursHint", form.FreeChangeHours, CancellationPolicySettings.MaxFreeChangeHours),
            ("LateCancellationFeePercent", "Settings.CancellationPolicy.LateFee", "Settings.CancellationPolicy.LateFeeHint", form.LateCancellationFeePercent, SaveCancellationPolicyValidator.MaxPercent),
            ("NoShowFeePercent", "Settings.CancellationPolicy.NoShowFee", "Settings.CancellationPolicy.NoShowFeeHint", form.NoShowFeePercent, SaveCancellationPolicyValidator.MaxPercent),
        })
        {
            var errors = Errors(name);
            var errorId = name + "-error";
            var hintId = name + "-hint";
            <div class="space-y-1">
                <label for="@name" class="block text-sm font-medium">@T[labelKey]</label>
                <input id="@name" name="@name" type="number" inputmode="numeric" min="0" max="@max" step="1" value="@value" required
                       aria-describedby="@hintId @errorId" aria-invalid="@(errors.Count > 0 ? "true" : "false")" class="@inputClass" data-testid="@name" />
                <p id="@hintId" class="text-sm text-stone-600">@T[hintKey]</p>
                <p id="@errorId" class="text-sm text-red-700" data-testid="@errorId">@string.Join(" ", errors)</p>
            </div>
        }

        <p class="rounded-md bg-stone-50 p-3 text-sm text-stone-700">@T["Settings.CancellationPolicy.Note"]</p>

        <button type="submit" class="@buttonClass" data-testid="save-cancellation-policy">@T["Settings.CancellationPolicy.Submit"]</button>
    </form>
</section>
