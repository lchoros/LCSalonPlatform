@{
    ViewData["Title"] = T["Identity.Denied.Title"];
}
<section class="mx-auto max-w-lg space-y-4" data-testid="access-denied">
    <h1 class="text-2xl font-bold tracking-tight sm:text-3xl">@T["Identity.Denied.Title"]</h1>
    <p class="max-w-prose text-stone-600">@T["Identity.Denied.Description"]</p>
    <a href="/services" class="inline-flex min-h-11 items-center justify-center rounded-md border border-stone-300 px-4 py-2 text-base font-medium hover:bg-stone-100">@T["Identity.Denied.Back"]</a>
</section>
