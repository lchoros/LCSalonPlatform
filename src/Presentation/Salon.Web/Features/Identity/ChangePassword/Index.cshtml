@using Salon.Services.Identity
@using Salon.Web.Features.Identity.ChangePassword
@model ChangePasswordForm
@{
    ViewData["Title"] = T["Identity.Password.Title"];
    const string inputClass = "field";
}
@* The same centred card as the sign-in page (ADR 0080): a person's own login reads as one family of screens. *@
<section class="mx-auto flex min-h-[60vh] max-w-sm flex-col justify-center">
    <div class="space-y-6 rounded-2xl border border-stone-200 bg-white p-6 shadow-lg sm:p-8" data-testid="password-card">
        <header class="space-y-1 text-center">
            <h1 class="text-2xl font-bold tracking-tight">@T["Identity.Password.Title"]</h1>
            <p class="text-sm text-stone-600">@T["Identity.Password.Lead"]</p>
        </header>
        @if (Model.Flash is { } flash)
        {
            <p role="status" data-testid="flash" class="notice notice-ok">@flash</p>
        }
        <form method="post" asp-action="Index" class="space-y-5" novalidate data-testid="change-password-form">
            <div asp-validation-summary="ModelOnly" class="notice notice-error" role="alert"></div>

            <div class="space-y-1">
                <label asp-for="CurrentPassword" class="field-label">@T["Identity.Password.Current"]</label>
                <input asp-for="CurrentPassword" type="password" autocomplete="current-password" aria-describedby="current-error" class="@inputClass" />
                <span asp-validation-for="CurrentPassword" id="current-error" class="field-error"></span>
            </div>

            <div class="space-y-1">
                <label asp-for="NewPassword" class="field-label">@T["Identity.Password.New"]</label>
                <p id="new-hint" class="text-sm text-stone-600">@T.Format("Identity.Password.NewHint", IUserService.MinPasswordLength)</p>
                <input asp-for="NewPassword" type="password" autocomplete="new-password" aria-describedby="new-hint new-error" class="@inputClass" />
                <span asp-validation-for="NewPassword" id="new-error" class="field-error"></span>
            </div>

            <div class="space-y-1">
                <label asp-for="ConfirmPassword" class="field-label">@T["Identity.Password.Confirm"]</label>
                <input asp-for="ConfirmPassword" type="password" autocomplete="new-password" aria-describedby="confirm-error" class="@inputClass" />
                <span asp-validation-for="ConfirmPassword" id="confirm-error" class="field-error"></span>
            </div>

            <button type="submit" class="btn btn-primary w-full" data-testid="change-password-submit">@T["Identity.Password.Submit"]</button>
        </form>
    </div>
</section>