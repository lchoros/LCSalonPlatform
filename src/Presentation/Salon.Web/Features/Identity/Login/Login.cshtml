@using Salon.Web.Features.Identity.Login
@model LoginForm
@{
    ViewData["Title"] = T["Identity.Login.Title"];
    const string inputClass = "field field-compact";
}
<section class="mx-auto max-w-sm space-y-6">
    <h1 class="page-title">@T["Identity.Login.Title"]</h1>
    <form method="post" asp-action="Login" class="space-y-5" novalidate data-testid="login-form">
        <div asp-validation-summary="ModelOnly" data-testid="login-error" class="notice notice-error" role="alert"></div>
        <input type="hidden" asp-for="ReturnUrl" />

        <div class="space-y-1">
            <label asp-for="Email" class="field-label">@T["Identity.Login.Email"]</label>
            <input asp-for="Email" type="email" inputmode="email" autocomplete="username" spellcheck="false" aria-describedby="email-error" class="@inputClass" />
            <span asp-validation-for="Email" id="email-error" class="field-error"></span>
        </div>

        <div class="space-y-1">
            <label asp-for="Password" class="field-label">@T["Identity.Login.Password"]</label>
            <input asp-for="Password" type="password" autocomplete="current-password" aria-describedby="password-error" class="@inputClass" />
            <span asp-validation-for="Password" id="password-error" class="field-error"></span>
        </div>

        <button type="submit" class="btn btn-compact btn-primary w-full">@T["Identity.Login.Submit"]</button>
    </form>
</section>
