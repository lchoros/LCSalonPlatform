@using Salon.Services.Locations
@model SalonLocation
@* "Where to find us" (ADR 0027). Links are large enough for a thumb; the maps link sends the address only. *@
<aside class="space-y-2 rounded-lg border border-stone-200 bg-white p-4 text-base" aria-labelledby="salon-contact-title" data-testid="salon-contact">
    <h2 id="salon-contact-title" class="text-sm font-semibold text-stone-700">@T["Booking.Contact.Title"]</h2>
    <address class="not-italic">
        @if (Model.Name is { } name)
        {
            <span class="block font-medium" data-testid="salon-contact-name">@name</span>
        }
        <span class="block" data-testid="salon-contact-address">@Model.Address</span>
    </address>
    <ul class="flex flex-col gap-1 sm:flex-row sm:flex-wrap sm:gap-x-4">
        <li><a href="@Model.MapUrl" target="_blank" rel="noopener noreferrer" data-testid="salon-contact-map" class="inline-flex min-h-11 items-center font-medium underline underline-offset-2">@T["Booking.Contact.Map"]</a></li>
        @if (Model.PhoneLink is { } phoneLink)
        {
            <li><a href="@phoneLink" data-testid="salon-contact-phone" class="inline-flex min-h-11 items-center font-medium underline underline-offset-2">@T.Format("Booking.Contact.Call", Model.Phone!)</a></li>
        }
        @if (Model.Email is { } email)
        {
            <li><a href="mailto:@email" data-testid="salon-contact-email" class="inline-flex min-h-11 items-center break-all font-medium underline underline-offset-2">@email</a></li>
        }
    </ul>
</aside>
