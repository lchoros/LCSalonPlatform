<!DOCTYPE html>
@using Salon.Core.Identity
@using Salon.Core.Tenancy
@using Salon.Services.Tenancy
@using Salon.Web.Framework.ClientPortal
@using Salon.Web.Framework.Infrastructure
@inject ITenantContext TenantContext
@inject ITenantLookup TenantLookup
@inject Microsoft.Extensions.Options.IOptionsMonitor<FeaturesOptions> Features
@{
    // Invariant culture (e.g. a CI runner with no locale) has an empty name; the page must still declare a language.
    var uiCulture = System.Globalization.CultureInfo.CurrentUICulture.Name;
    var lang = string.IsNullOrEmpty(uiCulture) ? SupportedCultures.Default : uiCulture;
    var signedIn = User.Identity?.IsAuthenticated == true;
    // The dashboard shell belongs to the salon's back office only (the owner, 2026-11-20): a signed-in person on the
    // public pages sees them exactly as a client does, plus one quiet way back into the admin.
    var adminShell = signedIn && Context.Request.Path.StartsWithSegments("/admin");
    // A client on a salon's host sees the salon's name where staff see the platform brand (ADR 0014: trust first).
    // The lookup is cached per tenant, so this costs nothing on a hot path.
    var salonName = !signedIn && TenantContext.TenantId is { } tenantId
        ? (await TenantLookup.FindByIdAsync(tenantId))?.Name
        : null;
    // The calendar lives under the appointments address, so the list is the current area only when the calendar is not.
    var onCalendar = Context.Request.Current("/admin/appointments/calendar") is not null;
    var canDiary = User.HasClaim(UserClaimTypes.Permission, Permissions.BookingsManage) && User.HasClaim(UserClaimTypes.Permission, Permissions.ClientsView);
    var canTill = User.HasClaim(UserClaimTypes.Permission, Permissions.PaymentsRecord) && User.HasClaim(UserClaimTypes.Permission, Permissions.ClientsView);
    var myBookings = Features.CurrentValue.ClientPortal && TenantContext.TenantId is not null;
}
<html lang="@lang" class="h-full bg-stone-50">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · @(salonName ?? T["Layout.Brand"])</title>
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
</head>
<body class="min-h-full text-stone-900 antialiased">
    @if (adminShell)
    {
        @* The dashboard shell (ADR 0080): one menu that is the fixed sidebar on a desktop and, on a phone, a
           drawer driven by this checkbox (no script, CSP untouched) beside a slim bottom bar of everyday places. *@
        <div class="flex min-h-screen">
            <input type="checkbox" id="nav-drawer" class="peer sr-only" aria-hidden="true" tabindex="-1" />
            <aside data-testid="sidebar" class="sidebar screen-only">
                <a class="brand-line flex min-h-14 items-center border-b border-stone-200 px-4 text-lg font-semibold tracking-tight" asp-area="" asp-controller="Home" asp-action="Index">@T["Layout.Brand"]</a>
                <nav aria-label="@T["Layout.Nav.Admin"]" data-testid="admin-nav" class="flex flex-1 flex-col gap-1 overflow-y-auto p-3 text-sm">
                    @if (canDiary)
                    {
                        <a href="/admin/appointments" data-testid="nav-appointments" aria-current="@(onCalendar ? null : Context.Request.Current("/admin/appointments"))" class="nav-link">@T["Layout.Nav.Appointments"]</a>
                        <a href="/admin/appointments/calendar" data-testid="nav-calendar" aria-current="@Context.Request.Current("/admin/appointments/calendar")" class="nav-link">@T["Layout.Nav.Calendar"]</a>
                    }
                    @if (User.HasClaim(UserClaimTypes.Permission, Permissions.ClientsView))
                    {
                        <a href="/admin/clients" data-testid="nav-clients" aria-current="@Context.Request.Current("/admin/clients")" class="nav-link">@T["Layout.Nav.Clients"]</a>
                    }
                    @if (canTill)
                    {
                        <a href="/admin/payments/cash-up" data-testid="nav-cash-up" aria-current="@Context.Request.Current("/admin/payments/cash-up")" class="nav-link">@T["Layout.Nav.CashUp"]</a>
                    }
                    @if (User.HasClaim(UserClaimTypes.Permission, Permissions.CatalogManage))
                    {
                        <a href="/admin/services" data-testid="nav-services" aria-current="@Context.Request.Current("/admin/services")" class="nav-link">@T["Layout.Nav.Services"]</a>
                    }
                    @if (User.HasClaim(UserClaimTypes.Permission, Permissions.BookingsManage))
                    {
                        <a href="/admin/products" data-testid="nav-products" aria-current="@Context.Request.Current("/admin/products")" class="nav-link">@T["Layout.Nav.Products"]</a>
                    }
                    @if (User.HasClaim(UserClaimTypes.Permission, Permissions.ReportsView) && User.HasClaim(UserClaimTypes.Permission, Permissions.ClientsView))
                    {
                        <a href="/admin/reports" data-testid="nav-reports" aria-current="@Context.Request.Current("/admin/reports")" class="nav-link">@T["Layout.Nav.Reports"]</a>
                    }
                    @if (User.HasClaim(UserClaimTypes.Permission, Permissions.StaffManage))
                    {
                        <a href="/admin/staff" data-testid="nav-staff" aria-current="@Context.Request.Current("/admin/staff")" class="nav-link">@T["Layout.Nav.Staff"]</a>
                    }
                    @if (User.HasClaim(UserClaimTypes.Permission, Permissions.SettingsManage))
                    {
                        <a href="/admin/settings/notifications" data-testid="nav-settings" aria-current="@Context.Request.Current("/admin/settings")" class="nav-link">@T["Layout.Nav.Settings"]</a>
                    }
                    else if (User.HasClaim(UserClaimTypes.Permission, Permissions.TemplatesManage))
                    {
                        @* A manager may edit the messages to clients but none of the other settings (ADR 0030). *@
                        <a href="/admin/settings/messages" data-testid="nav-settings" aria-current="@Context.Request.Current("/admin/settings")" class="nav-link">@T["Layout.Nav.Settings"]</a>
                    }
                </nav>
                <form method="post" action="/account/logout" asp-antiforgery="true" class="flex items-center justify-between gap-3 border-t border-stone-200 p-3 text-sm">
                    <span class="min-w-0 truncate" data-testid="user-name">@User.Identity!.Name</span>
                    <button type="submit" data-testid="sign-out" class="btn btn-compact btn-secondary shrink-0 px-3">@T["Layout.SignOut"]</button>
                </form>
            </aside>
            <label for="nav-drawer" class="drawer-overlay" aria-hidden="true"></label>
            <div class="flex min-h-screen w-full min-w-0 flex-1 flex-col">
                <header role="banner" class="brand-line flex min-h-14 items-center gap-3 border-b border-stone-200 bg-white px-4 screen-only lg:hidden">
                    <label for="nav-drawer" data-testid="open-menu" class="flex size-11 shrink-0 cursor-pointer items-center justify-center rounded-lg text-stone-700 hover:bg-stone-100">
                        <svg aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" class="size-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 6h16M4 12h16M4 18h16" /></svg>
                        <span class="sr-only">@T["Layout.Nav.Menu"]</span>
                    </label>
                    <span class="truncate text-lg font-semibold tracking-tight">@T["Layout.Brand"]</span>
                </header>
                <main class="mx-auto w-full max-w-5xl flex-1 px-4 py-6 pb-24 lg:pb-6">
                    @RenderBody()
                </main>
                <footer class="hidden border-t border-stone-200 py-4 text-center text-sm text-stone-600 screen-only lg:block">
                    &copy; @DateTime.UtcNow.Year @T["Layout.Brand"]
                </footer>
                <nav aria-label="@T["Layout.Nav.Menu"]" data-testid="bottom-bar" class="bottom-bar screen-only">
                    @if (canDiary)
                    {
                        <a href="/admin/appointments" aria-current="@(onCalendar ? null : Context.Request.Current("/admin/appointments"))" class="bottom-link" data-testid="bottom-appointments">@T["Layout.Nav.Appointments"]</a>
                    }
                    @if (User.HasClaim(UserClaimTypes.Permission, Permissions.ClientsView))
                    {
                        <a href="/admin/clients" aria-current="@Context.Request.Current("/admin/clients")" class="bottom-link" data-testid="bottom-clients">@T["Layout.Nav.Clients"]</a>
                    }
                    @if (canTill)
                    {
                        <a href="/admin/payments/cash-up" aria-current="@Context.Request.Current("/admin/payments/cash-up")" class="bottom-link" data-testid="bottom-cash-up">@T["Layout.Nav.CashUp"]</a>
                    }
                    <label for="nav-drawer" class="bottom-link cursor-pointer" data-testid="bottom-menu">@T["Layout.Nav.Menu"]</label>
                </nav>
            </div>
        </div>
    }
    else
    {
        <div class="flex min-h-screen flex-col">
            <header class="brand-line border-b border-stone-200 bg-white screen-only">
                <div class="mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-x-4 gap-y-2 px-4 py-2">
                    @if (salonName is not null)
                    {
                        <a href="/" data-testid="header-salon-name" class="inline-flex min-h-11 items-center text-lg font-semibold tracking-tight">@salonName</a>
                    }
                    else
                    {
                        <a class="inline-flex min-h-11 items-center text-lg font-semibold tracking-tight" asp-area="" asp-controller="Home" asp-action="Index">@T["Layout.Brand"]</a>
                    }
                    @if (myBookings)
                    {
                        @* A client's way to their own visits (ADR 0083), on a salon's pages and only while the flag is on. *@
                        <a href="@ClientPortalDefaults.VisitsPath" data-testid="my-bookings-link" class="btn btn-compact btn-secondary px-3 text-sm">@T["Layout.MyBookings"]</a>
                    }
                    @if (signedIn)
                    {
                        @* Staff looking at the client's pages: one quiet way back to the desk. *@
                        <a href="/admin/appointments" data-testid="back-to-admin" class="btn btn-compact btn-secondary px-3 text-sm">@T["Layout.Nav.Admin"]</a>
                    }
                </div>
            </header>
            <main class="mx-auto w-full max-w-5xl flex-1 px-4 py-6">
                @RenderBody()
            </main>
            <footer class="border-t border-stone-200 py-4 text-center text-sm text-stone-600 screen-only">
                &copy; @DateTime.UtcNow.Year @T["Layout.Brand"]
                @if (salonName is not null)
                {
                    @* A client on a salon's pages can always read what the salon does with their details (ADR 0063). *@
                    <text> · </text><a href="/privacy" class="underline underline-offset-2" data-testid="footer-privacy">@T["Layout.Privacy"]</a>
                }
            </footer>
        </div>
    }
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>