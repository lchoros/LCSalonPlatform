@using Salon.Core.Identity
@model string
@* The pages under "Settings". The model is the segment of the page that is open. A tab is shown only to a role that
   may open it: the owner sees all, a manager only the messages (ADR 0009, ADR 0030). *@
@{
    var pages = new[]
    {
        ("salon-details", "Settings.Nav.SalonDetails", Permissions.SettingsManage),
        ("notifications", "Settings.Nav.Notifications", Permissions.SettingsManage),
        ("cancellation-policy", "Settings.Nav.CancellationPolicy", Permissions.SettingsManage),
        ("messages", "Settings.Nav.Messages", Permissions.TemplatesManage),
    };
}
<nav aria-label="@T["Layout.Nav.Settings"]" data-testid="settings-nav" class="flex flex-wrap gap-2">
    @foreach (var (segment, labelKey, permission) in pages)
    {
        if (!User.HasClaim(UserClaimTypes.Permission, permission))
        {
            continue;
        }

        var on = segment == Model;
        <a href="/admin/settings/@segment" data-testid="settings-nav-@segment" aria-current="@(on ? "page" : null)"
           class="inline-flex min-h-11 items-center rounded-md border px-3 py-2 text-sm font-medium @(on ? "border-stone-900 bg-stone-900 text-white" : "border-stone-300 bg-white hover:bg-stone-100")">@T[labelKey]</a>
    }
</nav>
