@model ErrorViewModel
@{
    ViewData["Title"] = T["Error.Title"];
}
<section class="space-y-3">
    <h1 class="text-2xl font-bold text-red-700">@T["Error.Title"]</h1>
    <p class="text-stone-600">@T["Error.Description"]</p>
    @if (Model.ShowRequestId)
    {
        <p class="text-sm text-stone-500">@T["Error.RequestId"]: <code>@Model.RequestId</code></p>
    }
</section>
