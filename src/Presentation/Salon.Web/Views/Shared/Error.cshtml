@model ErrorViewModel
@{
    ViewData["Title"] = T["Error.Title"];
}
@* The same calm card as the status page (ADR 0087): an apology, a way on, and a number to quote if they write in. *@
<section class="mx-auto flex min-h-[50vh] max-w-md flex-col justify-center" data-testid="error-page">
    <div class="space-y-4 rounded-2xl border border-stone-200 bg-white p-6 text-center shadow-lg sm:p-8">
        <h1 class="text-2xl font-bold tracking-tight">@T["Error.Title"]</h1>
        <p class="text-stone-600">@T["Error.Description"]</p>
        <div class="flex flex-col gap-3 pt-2 sm:flex-row sm:justify-center">
            <a href="/" class="btn btn-primary">@T["Error.Home"]</a>
        </div>
        @if (Model.ShowRequestId)
        {
            <p class="text-xs text-stone-500">@T["Error.RequestId"]: <code>@Model.RequestId</code></p>
        }
    </div>
</section>