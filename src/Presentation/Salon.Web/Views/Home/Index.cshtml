@model HomeViewModel
@{
    ViewData["Title"] = Model.TenantName ?? T["Home.DefaultTitle"];
}
<section class="space-y-4">
    @if (Model.TenantName is { } tenantName)
    {
        <h1 class="text-3xl font-bold tracking-tight" data-testid="tenant-name">@tenantName</h1>
        <p class="max-w-prose text-stone-600">@T["Home.BookingOpensSoon"]</p>
        <a href="/services" data-testid="view-services" class="inline-flex min-h-11 items-center justify-center rounded-md bg-stone-900 px-5 py-2 text-base font-medium text-white hover:bg-stone-700">@T["Home.ViewServices"]</a>
    }
    else
    {
        <h1 class="text-3xl font-bold tracking-tight">@T["Layout.Brand"]</h1>
        <p class="max-w-prose text-stone-600">@T["Home.PlatformTagline"]</p>
        <p class="text-sm text-stone-500">@T["Home.PhaseNote"]</p>
    }
    <widget-zone name="@WidgetZones.PublicHomeBottom" />
</section>
