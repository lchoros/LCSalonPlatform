@using Salon.Web.Models
@model StatusViewModel
@{
    ViewData["Title"] = T[Model.KeyStem + ".Title"];
}
@* A sentence instead of a blank screen (ADR 0087): what happened in plain words, and one way on. *@
<section class="mx-auto flex min-h-[50vh] max-w-md flex-col justify-center" data-testid="status-page" data-kind="@Model.Kind">
    <div class="space-y-4 rounded-2xl border border-stone-200 bg-white p-6 text-center shadow-lg sm:p-8">
        <h1 class="text-2xl font-bold tracking-tight">@T[Model.KeyStem + ".Title"]</h1>
        <p class="text-stone-600">@T[Model.KeyStem + ".Description"]</p>
        <div class="flex flex-col gap-3 pt-2 sm:flex-row sm:justify-center">
            @if (Model.SignedIn)
            {
                <a href="/admin/appointments" class="btn btn-primary" data-testid="status-admin">@T["Error.Admin"]</a>
            }
            <a href="/" class="btn @(Model.SignedIn ? "btn-secondary" : "btn-primary")" data-testid="status-home">@T["Error.Home"]</a>
        </div>
    </div>
</section>