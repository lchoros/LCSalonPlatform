{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jobs": {
    "Enabled": true,
    "WorkerCount": 2,
    "SchemaName": "hangfire"
  },
  "Features": {
    "Preview": false,
    "ClientImport": false
  },
  "Tenancy": {
    "BaseDomains": [ "localhost" ],
    "TenantClaimType": "tenant_id"
  },
  "Auth": {
    "ValidationInterval": "00:05:00",
    "LoginRateLimit": {
      "PermitLimit": 10,
      "Window": "00:01:00"
    }
  },
  "PublicBooking": {
    "SmsCodeRateLimit": {
      "PermitLimit": 10,
      "Window": "01:00:00"
    },
    "CodeVerifyRateLimit": {
      "PermitLimit": 20,
      "Window": "01:00:00"
    }
  },
  "ConnectionStrings": {
    "Default": ""
  },
  "Email": {
    "Host": "localhost",
    "Port": 1025,
    "FromAddress": "no-reply@salon.local",
    "FromName": "Salon Platform"
  }
}
