<?xml version="1.0" encoding="UTF-8" ?>
<Application
    x:Class="Salon.Mobile.App"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:f="clr-namespace:Salon.Mobile.Formatting">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <f:PriceConverter x:Key="Price" />
            <f:PriceAndDurationConverter x:Key="PriceAndDuration" />
            <f:DurationConverter x:Key="Duration" />
            <f:DateConverter x:Key="Date" />
            <f:WhenConverter x:Key="When" />
            <f:TimeRangeConverter x:Key="TimeRange" />
            <f:StaffNameConverter x:Key="StaffName" />
            <f:InitialsConverter x:Key="Initials" />
            <f:FilterNameConverter x:Key="FilterName" />
            <f:PartOfDayConverter x:Key="PartOfDay" />
            <f:TimeHintConverter x:Key="TimeHint" />
            <f:AttemptsLeftConverter x:Key="AttemptsLeft" />
            <f:SubmitTextConverter x:Key="SubmitText" />
            <f:HasValueConverter x:Key="HasValue" />
            <f:InvertConverter x:Key="Not" />
            <f:AllowedOpacityConverter x:Key="AllowedOpacity" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
