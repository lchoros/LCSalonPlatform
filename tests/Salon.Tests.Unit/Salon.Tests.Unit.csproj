<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\..\src\Libraries\Salon.Core\Salon.Core.csproj" />
    <ProjectReference Include="..\..\src\Libraries\Salon.Services\Salon.Services.csproj" />
    <ProjectReference Include="..\..\src\Presentation\Salon.Web.Framework\Salon.Web.Framework.csproj" />
    <ProjectReference Include="..\..\src\Plugins\Salon.Plugin.Payments.Manual\Salon.Plugin.Payments.Manual.csproj" />
    <ProjectReference Include="..\..\src\Plugins\Salon.Plugin.Sms.Log\Salon.Plugin.Sms.Log.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
