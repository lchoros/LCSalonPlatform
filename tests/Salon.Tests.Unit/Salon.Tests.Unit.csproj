<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\..\src\Libraries\Salon.Core\Salon.Core.csproj" />
    <ProjectReference Include="..\..\src\Libraries\Salon.Services\Salon.Services.csproj" />
    <ProjectReference Include="..\..\src\Presentation\Salon.Web.Framework\Salon.Web.Framework.csproj" />
    <ProjectReference Include="..\..\src\Plugins\Salon.Plugin.Payments.Manual\Salon.Plugin.Payments.Manual.csproj" />
    <ProjectReference Include="..\..\src\Plugins\Salon.Plugin.Sms.Log\Salon.Plugin.Sms.Log.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="NSubstitute" />
    <PackageReference Include="FsCheck.Xunit" />
    <PackageReference Include="Verify.Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Fixtures for EmbeddedJsonResourceSourceTests; the logical names mimic a host assembly's "Localization" root.
      Module files sit in a culture folder and the folder becomes a dot segment (ADR 0006, amendment 2026-11-12):
      Localization/en-GB/Fixture.json -> ...Localization.en-GB.Fixture.json. RecursiveDir ends with the platform's
      separator, so both separators are replaced.
    -->
    <EmbeddedResource Include="Localization\Fixtures\Good\Localization\*.json" LogicalName="Salon.Tests.Unit.Fixtures.Good.Localization.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Localization\Fixtures\Bad\Localization\*.json" LogicalName="Salon.Tests.Unit.Fixtures.Bad.Localization.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Localization\Fixtures\Modular\Localization\**\*.json" LogicalName="Salon.Tests.Unit.Fixtures.Modular.Localization.$([System.String]::Copy('%(RecursiveDir)').Replace('\', '.').Replace('/', '.'))%(Filename)%(Extension)" />
    <!-- A legacy flat file and a module file for the same culture under one root. -->
    <EmbeddedResource Include="Localization\Fixtures\Mixed\Localization\**\*.json" LogicalName="Salon.Tests.Unit.Fixtures.Mixed.Localization.$([System.String]::Copy('%(RecursiveDir)').Replace('\', '.').Replace('/', '.'))%(Filename)%(Extension)" />
    <!-- One key defined in two module files of the same culture. -->
    <EmbeddedResource Include="Localization\Fixtures\DupAcross\Localization\**\*.json" LogicalName="Salon.Tests.Unit.Fixtures.DupAcross.Localization.$([System.String]::Copy('%(RecursiveDir)').Replace('\', '.').Replace('/', '.'))%(Filename)%(Extension)" />
    <!-- A key repeated inside one file. -->
    <EmbeddedResource Include="Localization\Fixtures\DupKey\Localization\*.json" LogicalName="Salon.Tests.Unit.Fixtures.DupKey.Localization.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Shouldly" />
  </ItemGroup>

</Project>
